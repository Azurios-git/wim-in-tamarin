   [
   Browser_Send_HTTP( $Browser, <~did, ~refid>, 'XHR', $Scheme,
                      $Domain, $Path, parameters, fragment, $method, NoAuth, NoOrigin,
                      <$DocScheme, $DocDomain, $docpath, params, 'bot'>, refpolicy,
                      NoBody, 'honest', ~redirnonce, ~msgnonce
   )
   ]

  /* has exactly the trivial AC variant */

restriction Restr_AdversaryRunScriptXHROther_1:
  "∀ x #NOW x.1 x.2 x.3 x.4.
    (Restr_AdversaryRunScriptXHROther_1( x, x.1, x.2, x.3, x.4
     ) @ #NOW) ⇒
    (¬(((((x = 'GET') ∨ (x.1 = 'HEAD')) ∨ (x.2 = 'TRACE')) ∨
        (x.3 = 'CONNECT')) ∨
       (x.4 = 'TRACK')))"
  // safety formula

rule (modulo E) AdversaryRunScriptXHROther:
   [
   !AdvScript( $Browser, ~did,
               <$DocScheme, $DocDomain, $docpath, params, docfragment>, refpolicy
   ),
   Fr( ~refid ), In( <data, parameters, fragment> ),
   Fr( ~redirnonce ), Fr( ~msgnonce )
   ]
  --[
  AdvActive( ),
  Restr_AdversaryRunScriptXHROther_1( $method, $method, $method,
                                      $method, $method
  )
  ]->
   [
   Browser_Send_HTTP( $Browser, <~did, ~refid>, 'XHR', $Scheme,
                      $Domain, $Path, parameters, fragment, $method, NoAuth,
                      <$DocDomain, $DocScheme>,
                      <$DocScheme, $DocDomain, $docpath, params, 'bot'>, refpolicy, data,
                      'honest', ~redirnonce, ~msgnonce
   )
   ]

  /* has exactly the trivial AC variant */

restriction Restr_AdversaryRunScriptPostMsg_1:
  "∀ x #NOW.
    (Restr_AdversaryRunScriptPostMsg_1( x ) @ #NOW) ⇒
    (¬(x = 'Adversaryscript'))"
  // safety formula

rule (modulo E) AdversaryRunScriptPostMsg:
   [
   !AdvScript( $Browser, ~did,
               <$DocScheme, $DocDomain, $docpath, params, docfragment>, refpolicy
   ),
   Document( ~otherdid, $Browser, $OtherTLW,
             <$OtherScheme, $OtherDomain, $otherdocpath, otherparams, 
              otherdocfragment>,
             otherReferer, $otherRefpolicy, $otherscript, otherscriptstate
   ),
   In( message )
   ]
  --[
  AdvActive( ),
  DocLoop( ~otherdid,
           <$OtherScheme, $OtherDomain, $otherdocpath, otherparams, 
            otherdocfragment>,
           $otherscript
  ),
  Restr_AdversaryRunScriptPostMsg_1( $otherscript )
  ]->
   [
   ScriptinputPOST( ~otherdid, ~did, <$DocDomain, $DocScheme>, message
   ),
   Document( ~otherdid, $Browser, $OtherTLW,
             <$OtherScheme, $OtherDomain, $otherdocpath, otherparams, 
              otherdocfragment>,
             otherReferer, $otherRefpolicy, $otherscript, otherscriptstate
   )
   ]

  // loop breaker: [1]
  /* has exactly the trivial AC variant */

rule (modulo E) LeakPlainCookies:
   [
   !LeakState( $Browser, $Domain, $Scheme, $TLW ),
   CookiesPlain( ~cid, $Browser, $Domain, (rest++<$name, content>)
   )[-]
   ]
  --[
  PDPlainLeak( $Browser, $Domain, <$name, content> ),
  PlainCookiesLoop( ~cid, $Browser, $Domain, (rest++<$name, content>)
  ),
  NoLeakingUninit( content )
  ]->
   [
   CookiesPlain( ~cid, $Browser, $Domain, (rest++<$name, content>)
   )[-],
   Out( content )
   ]

  // loop breaker: [1]
  /* has exactly the trivial AC variant */

rule (modulo E) LeakSecCookies:
   [
   !LeakState( $Browser, $Domain, 'https', $TLW ),
   CookiesSec( ~cid, $Browser, $Domain, (rest++<$name, content>) )[-]
   ]
  --[
  PDSecLeak( $Browser, $Domain, <$name, content> ),
  SecCookiesLoop( ~cid, $Browser, $Domain, (rest++<$name, content>) )
  ]->
   [
   CookiesSec( ~cid, $Browser, $Domain, (rest++<$name, content>) )[-],
   Out( content )
   ]

  // loop breaker: [1]
  /* has exactly the trivial AC variant */

rule (modulo E) LeakSecrets:
   [
   !LeakState( $Browser, $Domain, $Scheme, $TLW ),
   !Secrets( $Browser, $Domain, $Scheme, data )
   ]
  -->
   [ Out( data ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) LeakServerSecrets:
   [ !CompromisedDomain( $Domain ), !ServerSecret( $Domain, secret ) ]
  -->
   [ Out( secret ) ]

  /* has exactly the trivial AC variant */

restriction OnlyOnce:
  "∀ x #i #j.
    ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction Equality:
  "∀ a b #i. (Eq( a, b ) @ #i) ⇒ (a = b)"
  // safety formula

restriction Init:
  "∀ cookie #i.
    (Uninit( cookie ) @ #i) ⇒
    ((cookie = NoCookies) ∨
     (∃ a b.
       (cookie = (a++b)) ∧
       (∀ rest singleton.
         (cookie = (rest++singleton)) ⇒
         (∃ name. singleton = <name, uninit>))))"

lemma aux_unique_requests [reuse]:
  all-traces
  "∀ nonce #i #j.
    ((Send_Request_Nonce( nonce ) @ #i) ∧
     (Send_Request_Nonce( nonce ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ nonce #i #j.
  (Send_Request_Nonce( nonce ) @ #i) ∧
  (Send_Request_Nonce( nonce ) @ #j)
 ∧
  ¬(#i = #j)"
*/
by sorry

rule (modulo E) miniServerIn:
   [
   !ClaimDomain( $Domain, 'miniServer' ),
   Receive_Request( $Browser, $Domain, 'https', ~nonce, 'GET',
                    '/init', parameters, cookies, origin, NewReferer, NewAuth, newbody
   ),
   Fr( ~token )
   ]
  --[
  PDAddSecCookies( $Domain, $Browser, <'SessionToken', ~token> ),
  PDAddedListSec( <<'SessionToken', ~token>, 'bot'> ), Deleted( )
  ]->
   [
   Send_Reply( $Domain, $Browser, 'https', ~nonce, '200', NoCookies,
               (NoCookies++<'SessionToken', ~token>), NoLocation, 'bot',
               NoRefPolicy, <'MyScript', $Domain>
   ),
   !SessionToken( $Domain, ~token )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) miniServerDeleteFixed:
   [
   Receive_Request( $Browser, $Domain, 'https', ~nonce, 'POST',
                    '/deleteme', parameters, (cookies++<'SessionToken', ~token>),
                    <$Domain, 'https'>, NewReferer, NewAuth, newbody
   ),
   !SessionToken( $Domain, ~token )
   ]
  --[ Deleted( ), Commit( $Domain, $Browser, '/deleteme' ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) clickDeleteMe:
   [
   Document( ~did, $Browser, $TLW,
             <$Scheme, $DocDomain, path, params, fragment>, referer, refpolicy,
             'MyScript', $ScriptDomain
   )
   ]
  --[ Run( $Browser, $ScriptDomain, '/deleteme' ) ]->
   [
   Send_Request_Browser( $Browser, $TLW, 'REQ', $Scheme,
                         $ScriptDomain, '/deleteme', 'bot', 'bot', 'POST', NoAuth,
                         <$DocDomain, $Scheme>, NoReferrer, NoRefPolicy, NoBody
   ),
   Document( ~did, $Browser, $TLW,
             <$Scheme, $DocDomain, path, params, fragment>, referer, refpolicy,
             'MyScript', <$ScriptDomain, 'ran'>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) compromiseServer:
   [ !CompromisedDomain( $Domain ), !SessionToken( $Domain, ~token ) ]
  -->
   [ Out( ~token ) ]

  /* has exactly the trivial AC variant */

lemma executabilit:
  exists-trace
  "∃ #i. (OpenUrl( ) @ #i) ∧ (¬(∃ #j. AdvActive( ) @ #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (OpenUrl( ) @ #i) ∧ ∀ #j. (AdvActive( ) @ #j) ⇒ ⊥"
*/
by sorry

lemma executability:
  exists-trace "∃ #i. (Sent( ) @ #i) ∧ (¬(∃ #j. AdvActive( ) @ #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Sent( ) @ #i) ∧ ∀ #j. (AdvActive( ) @ #j) ⇒ ⊥"
*/
by sorry

lemma executability2:
  exists-trace "∃ #i. (SR( ) @ #i) ∧ (¬(∃ #j. AdvActive( ) @ #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (SR( ) @ #i) ∧ ∀ #j. (AdvActive( ) @ #j) ⇒ ⊥"
