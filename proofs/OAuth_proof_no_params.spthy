lemma aux_redirect_chain_ref [reuse, use_induction]:
  all-traces
  "∀ browser nonce body dom #i.
    (Send_redirnonce_ref( browser, nonce, body, dom ) @ #i) ⇒
    (∃ otherdom scheme msgnonce #j.
      Fresh_Redirnonce_Ref( browser, nonce, body, otherdom, scheme,
                            msgnonce
      ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ browser nonce body dom #i.
  (Send_redirnonce_ref( browser, nonce, body, dom ) @ #i)
 ∧
  ∀ otherdom scheme msgnonce #j.
   (Fresh_Redirnonce_Ref( browser, nonce, body, otherdom, scheme,
                          msgnonce
    ) @ #j)
  ⇒
   ⊥"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ browser nonce body dom #i.
           (Send_redirnonce_ref( browser, nonce, body, dom ) @ #i)
          ⇒
           ((last(#i)) ∨
            (∃ otherdom scheme msgnonce #j.
              (Fresh_Redirnonce_Ref( browser, nonce, body, otherdom, scheme,
                                     msgnonce
               ) @ #j)
             ∧
              ¬(last(#j)))))  ∥
         (∃ cookie #i.
           (Uninit( cookie ) @ #i)
          ∧
           (¬(last(#i))) ∧
           (¬(cookie = NoCookies)) ∧
           (∀ a b.
             (cookie = (a++b))
            ⇒
             ∃ rest singleton.
              (cookie = (rest++singleton))
             ∧
              ∀ name. (singleton = <name, uninit>) ⇒ ⊥)) )
    case case_1
    solve( (last(#i))  ∥
           (∃ otherdom scheme msgnonce #j.
             (Fresh_Redirnonce_Ref( $Browser, ~redirnonce, body, otherdom,
                                    scheme, msgnonce
              ) @ #j)
            ∧
             ¬(last(#j))) )
      case case_1
      solve( Browser_Out( $Browser, window_or_doc_reference, $Domain,
                          $Scheme, $type, fragment, ~nonce, $method, $path, parameters,
                          plaincookies, seccookies, origin, body, auth, body.1, adv,
                          ~redirnonce
             )[no_precomp] ▶₀ #i )
        case BrowserSendPlain_case_01
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_02
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_03
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_04
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_05
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_06
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_07
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_08
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_09
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_10
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_11
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_12
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_13
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_14
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_15
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_16
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_17
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_18
        by contradiction /* from formulas */
      next
        case BrowserSendSec_case_01
        by contradiction /* from formulas */
      next
        case BrowserSendSec_case_02
        by contradiction /* from formulas */
      next
        case BrowserSendSec_case_03
        by contradiction /* from formulas */
      next
        case BrowserSendSec_case_04
        by contradiction /* from formulas */
      next
        case BrowserSendSec_case_05
        by contradiction /* from formulas */
      next
        case BrowserSendSec_case_06
        by contradiction /* from formulas */
      next
        case BrowserSendSec_case_07
        by contradiction /* from formulas */
      next
        case BrowserSendSec_case_08
        by contradiction /* from formulas */
