rule (modulo E) ProcessRedirectOriginFail:
   [
   ProcessRedirectFragment( ~processid, $Browser, ~nonce, $status,
                            requestorigin, $method, body, refpolicy, $respScheme, $respDomain,
                            resppath, respparams, finalfragment, $requestDomain,
                            $requestScheme, $respDomain, $respScheme, referrer, ~redirnonce
   )
   ]
  --[
  OriginRedirectRestrictionFail( requestorigin, $requestDomain,
                                 $requestScheme, $respDomain, $respScheme
  )
  ]->
   [
   ProcessRedirectOrigin( ~processid, $Browser, ~nonce, $status,
                          NoOrigin, $method, body, refpolicy, $respScheme, $respDomain,
                          resppath, respparams, finalfragment, referrer, ~redirnonce
   )
   ]

  /* has exactly the trivial AC variant */

restriction Restr_ProcessRedirect303BadMethod_1:
  "∀ x #NOW x.1.
    (Restr_ProcessRedirect303BadMethod_1( x, x.1 ) @ #NOW) ⇒
    (¬((x = 'GET') ∨ (x.1 = 'HEAD')))"
  // safety formula

rule (modulo E) ProcessRedirect303BadMethod:
   [
   ProcessRedirectOrigin( ~processid, $Browser, ~nonce, '303',
                          finalorigin, $method, body, refpolicy, $respScheme, $respDomain,
