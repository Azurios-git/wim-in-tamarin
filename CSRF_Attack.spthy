                next
                  case GetResponse_case_2
                  by contradiction /* from formulas */
                next
                  case GetResponse_case_3
                  by contradiction /* from formulas */
                qed
              qed
            next
              case case_2
              solve( ReceiveSecCookies( $Browser, $Domain,
                                        (rest.1++<$name, content>)
                     ) @ #j )
                case ProcessResponse
                solve( Browser_In( $Domain, $Browser, $Scheme, ~nonce, $status,
                                   setcookiesplain, (rest.1++<$name, content>), location, STS,
                                   refpolicy, body
                       ) ▶₁ #j )
                  case GetResponse_case_1
                  by contradiction /* from formulas */
                next
                  case GetResponse_case_2
                  by contradiction /* from formulas */
                next
                  case GetResponse_case_3
                  by contradiction /* from formulas */
                next
                  case GetResponse_case_4
                  by contradiction /* from formulas */
                qed
              qed
            qed
          next
            case ProcessCookiesSecLoopReplace_case_3
            solve( (∃ #j.
                     (!KU( <$name, content> ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr))  ∥
                   (content = uninit)  ∥
                   (∃ #j.
                     (PDAddSecCookies( $Domain, $Browser, <$name, content> ) @ #j)
                    ∧
                     ¬(last(#j))) )
              case case_1
              by contradiction /* from formulas */
            next
              case case_2
              by contradiction /* from formulas */
            next
              case case_3
              by contradiction /* from formulas */
            qed
          qed
        qed
      next
        case case_2
        by contradiction /* from formulas */
      next
        case case_3
        by contradiction /* from formulas */
      next
        case case_4
        by contradiction /* from formulas */
      qed
    next
      case case_2
      solve( (cookie = NoCookies)  ∥
             (∃ a b.
               (cookie = (a++b))
              ∧
               ∀ rest singleton.
                (cookie = (rest++singleton))
               ⇒
                ∃ name. (singleton = <name, uninit>)) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2_case_1
        by contradiction /* from formulas */
      next
        case case_2_case_2
        by contradiction /* from formulas */
      qed
    qed
  next
    case case_2
    by sorry
  next
    case case_3
    by sorry
  next
    case case_4
    by sorry
  qed
qed

rule (modulo E) LeakLocalStorage:
   [
   !LeakState( $Browser, $Domain, $Scheme, $TLW )[no_precomp],
   LocalStorage( ~sid, $Browser, $Domain, $Scheme, data )[no_precomp]
   ]
  --[ PDLeakLocalStorage( data ) ]->
   [
   Out( data ), LocalStorage( ~sid, $Browser, $Domain, $Scheme, data )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) LeakSessionStorage:
   [
   !LeakState( $Browser, $Domain, $Scheme, $TLW )[no_precomp],
   SessionStorage( ~sid, $Browser, $Domain, $Scheme, $TLW, data
   )[no_precomp]
   ]
  --[ PDLeakSessionStorage( data ) ]->
   [
   Out( data ),
   SessionStorage( ~sid, $Browser, $Domain, $Scheme, $TLW, data )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) ModifyLocalStorage:
   [
   !ModifyState( $Browser, $Domain, $Scheme, $TLW )[no_precomp],
   LocalStorage( ~sid, $Browser, $Domain, $Scheme, data )[no_precomp],
   In( newdata ), Browser_State( ~bid, $Browser, 'Ready' )[no_precomp]
   ]
  -->
   [
   Browser_State( ~bid, $Browser, 'Ready' )[no_precomp],
   LocalStorage( ~sid, $Browser, $Domain, $Scheme, newdata )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) ModifySessionStorage:
   [
   !ModifyState( $Browser, $Domain, $Scheme, $TLW )[no_precomp],
   SessionStorage( ~sid, $Browser, $Domain, $Scheme, $TLW, data
   )[no_precomp],
   In( newdata ), Browser_State( ~bid, $Browser, 'Ready' )[no_precomp]
   ]
  -->
   [
   Browser_State( ~bid, $Browser, 'Ready' )[no_precomp],
   SessionStorage( ~sid, $Browser, $Domain, $Scheme, $TLW, newdata )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) AddLocalStorage:
   [
   !ModifyState( $Browser, $Domain, $Scheme, $TLW )[no_precomp],
   Fr( ~sid ), In( newdata ),
   Browser_State( ~bid, $Browser, 'Ready' )[no_precomp]
   ]
  -->
   [
   Browser_State( ~bid, $Browser, 'Ready' )[no_precomp],
   LocalStorage( ~sid, $Browser, $Domain, $Scheme, newdata )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) AddSessionStorage:
   [
   !ModifyState( $Browser, $Domain, $Scheme, $TLW )[no_precomp],
   Fr( ~sid ), In( newdata ),
   Browser_State( ~bid, $Browser, 'Ready' )[no_precomp]
   ]
  -->
   [
   Browser_State( ~bid, $Browser, 'Ready' )[no_precomp],
   SessionStorage( ~sid, $Browser, $Domain, $Scheme, $TLW, newdata )
   ]

  /* has exactly the trivial AC variant */

lemma sourceSessionStorageLeak [sources]:
  all-traces
  "∀ data #i.
    (PDLeakSessionStorage( data ) @ #i) ⇒
    (((data = 'bot') ∨ (∃ #j. (!KU( data ) @ #j) ∧ (#j < #i))) ∨
     (∃ #j. (PDAddSessionStorage( data ) @ #j) ∧ (#j < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ data #i.
  (PDLeakSessionStorage( data ) @ #i)
 ∧
  (¬(data = 'bot')) ∧
  (∀ #j. (!KU( data ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #j. (PDAddSessionStorage( data ) @ #j) ⇒ ¬(#j < #i))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ data #i.
           (PDLeakSessionStorage( data ) @ #i)
          ⇒
           ((last(#i)) ∨
            (data = 'bot') ∨
            (∃ #j. (!KU( data ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) ∨
            (∃ #j.
              (PDAddSessionStorage( data ) @ #j)
             ∧
              (¬(last(#j))) ∧ (#j < #i))))  ∥
         (∃ cookie #i.
           (Uninit( cookie ) @ #i)
          ∧
           (¬(last(#i))) ∧
           (¬(cookie = NoCookies)) ∧
           (∀ a b.
             (cookie = (a++b))
            ⇒
             ∃ rest singleton.
              (cookie = (rest++singleton))
             ∧
              ∀ name. (singleton = <name, uninit>) ⇒ ⊥)) )
    case case_1
    solve( (last(#i))  ∥ (data = 'bot')  ∥
           (∃ #j. (!KU( data ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i))  ∥
           (∃ #j.
             (PDAddSessionStorage( data ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( SessionStorage( ~sid, $Browser, $Domain, $Scheme, $TLW, data
             )[no_precomp] ▶₁ #i )
        case AddSessionStorage
        by contradiction /* from formulas */
      next
        case LeakSessionStorage
        solve( (data = 'bot')  ∥
               (∃ #j. (!KU( data ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr))  ∥
               (∃ #j.
                 (PDAddSessionStorage( data ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr)) )
          case case_1
          by contradiction /* from formulas */
        next
          case case_2
          by contradiction /* from formulas */
        next
          case case_3
          by contradiction /* from formulas */
        qed
      next
        case ModifySessionStorage
        by contradiction /* from formulas */
      qed
    next
      case case_2
      by contradiction /* from formulas */
    next
      case case_3
      by contradiction /* from formulas */
    next
      case case_4
      by contradiction /* from formulas */
    qed
  next
    case case_2
    solve( (cookie = NoCookies)  ∥
           (∃ a b.
             (cookie = (a++b))
            ∧
             ∀ rest singleton.
              (cookie = (rest++singleton))
             ⇒
              ∃ name. (singleton = <name, uninit>)) )
      case case_1
      by contradiction /* from formulas */
    next
      case case_2_case_1
      by contradiction /* from formulas */
    next
      case case_2_case_2
      by contradiction /* from formulas */
    qed
  qed
qed

lemma sourceLocalStorageLeak [sources]:
  all-traces
  "∀ data #i.
    (PDLeakLocalStorage( data ) @ #i) ⇒
    (((data = 'bot') ∨ (∃ #j. (!KU( data ) @ #j) ∧ (#j < #i))) ∨
     (∃ #j. (PDAddLocalStorage( data ) @ #j) ∧ (#j < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ data #i.
  (PDLeakLocalStorage( data ) @ #i)
 ∧
