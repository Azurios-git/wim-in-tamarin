rule (modulo E) ProcessRedirectFinish:
   [
   ProcessRedirectFinish( ~processid, $Browser, ~nonce, $status,
                          finalorigin, $method, body, refpolicy, $respScheme, $respDomain,
                          resppath, respparams, finalfragment, referrer, ~redirnonce
   ),
   Fr( ~msgnonce )
   ]
  --[
  Continue_Redir( $Browser, $respDomain, ~nonce, ~redirnonce,
                  $status, ~msgnonce, body
  )
  ]->
   [
   Browser_Send_HTTP( $Browser, $Tlw, 'REQ', $respScheme, $respDomain,
                      resppath, respparams, finalfragment, $method, NoAuth, finalorigin,
                      referrer, refpolicy, body, 'honest', ~redirnonce, ~msgnonce
   ),
   ProcessedDocument( ~processid, $Browser )
   ]

  /* has exactly the trivial AC variant */

restriction OriginRedirect:
  "∀ origscheme origDomain domain scheme respDomain respScheme #i.
    (OriginRedirectRestriction( <origscheme, origDomain>, domain,
                                scheme, respDomain, respScheme
     ) @ #i) ⇒
    (((origscheme = scheme) ∧ (origDomain = domain)) ∨
     ((respScheme = scheme) ∧ (respDomain = domain)))"
  // safety formula

restriction OriginRedirectFail:
  "∀ origscheme origDomain domain scheme respDomain respScheme #i.
    (OriginRedirectRestrictionFail( <origscheme, origDomain>, domain,
                                    scheme, respDomain, respScheme
     ) @ #i) ⇒
    (¬(((origscheme = scheme) ∧ (origDomain = domain)) ∨
       ((respScheme = scheme) ∧ (respDomain = domain))))"
  // safety formula

rule (modulo E) SendRequest:
   [
   Browser_Out( $Browser, window_or_doc_reference, $Domain, $Scheme,
                $type, fragment, ~nonce, $method, $path, parameters, plaincookies,
                seccookies, origin, referrer, auth, body, adv, ~redirnonce
   )[no_precomp]
   ]
  --[
  Send_Request_Nonce( ~nonce ), SR( ),
  SendSecCookies( seccookies, $Scheme ), SendReferer( referrer ),
  Send_Out( $Browser, $Domain, $Scheme ),
  SendCookiesPlain( plaincookies ), SendCookiesSec( seccookies ),
  RequestLink( ~nonce ),
  Send_redirnonce( $Browser, ~redirnonce, body, $Domain ),
  SentRequest( $Browser, $Domain, $Scheme, ~redirnonce, ~nonce ),
  Sent_Method( $Browser, $method, body ), PDLeakBody( body ),
  PDLeakAuth( auth ), PDLeakParams( parameters ),
  PDLeakRef( referrer )
  ]->
   [
   !Request( $Browser, $Domain, $Scheme, ~nonce, $method, $path,
             parameters, plaincookies, seccookies, origin, referrer, auth, body,
             adv
   ),
   BrowserData( $Browser, $Domain, $Scheme, $method, $path, ~nonce,
                $type, fragment, origin, parameters, referrer,
                window_or_doc_reference, body, ~redirnonce
   )
   ]

  /* has exactly the trivial AC variant */

