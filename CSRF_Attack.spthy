   )
   ]
  --[ Restr_ProcessRedirect303BadMethod_1( $method, $method ) ]->
   [
   ProcessRedirectFinish( ~processid, $Browser, ~nonce, '303',
                          finalorigin, 'GET', NoBody, refpolicy, $respScheme, $respDomain,
