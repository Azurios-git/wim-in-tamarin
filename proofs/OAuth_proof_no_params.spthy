lemma sourceAuthLeak [sources]:
  all-traces
  "∀ auth #i.
    (PDLeakAuth( auth ) @ #i) ⇒
    (((auth = NoAuth) ∨ (∃ #j. (!KU( auth ) @ #j) ∧ (#j < #i))) ∨
     (∃ #k. (PDAddAuth( auth ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ auth #i.
  (PDLeakAuth( auth ) @ #i)
 ∧
  (¬(auth = NoAuth)) ∧
  (∀ #j. (!KU( auth ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #k. (PDAddAuth( auth ) @ #k) ⇒ ¬(#k < #i))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ auth #i.
           (PDLeakAuth( auth ) @ #i)
