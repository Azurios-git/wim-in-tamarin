lemma uniqueness_in_first_msg_nonce [reuse]:
  all-traces
  "∀ browser dom innonce redirnonce outnonce body domtwo outnoncetwo
     bodytwo status otherstatus #i #j.
    ((Continue_Redir( browser, dom, innonce, redirnonce, status,
                      outnonce, body
      ) @ #i) ∧
     (Continue_Redir( browser, domtwo, innonce, redirnonce, otherstatus,
                      outnoncetwo, bodytwo
      ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ browser dom innonce redirnonce outnonce body domtwo outnoncetwo
   bodytwo status otherstatus #i #j.
  (Continue_Redir( browser, dom, innonce, redirnonce, status,
                   outnonce, body
   ) @ #i) ∧
  (Continue_Redir( browser, domtwo, innonce, redirnonce, otherstatus,
                   outnoncetwo, bodytwo
   ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( ProcessRedirectFinish( ~processid, $Browser, ~nonce,
                                $status, finalorigin, $method, body, refpolicy, $respScheme,
                                $respDomain, resppath, respparams, finalfragment, referrer,
                                ~redirnonce
         ) ▶₀ #i )
    case ProcessRedirect303BadMethod_case_1
    solve( ProcessRedirectFinish( ~processid.1, $Browser, ~nonce,
                                  $status, finalorigin.1, $method, bodytwo, refpolicy.1,
                                  $respScheme.1, $respDomain.1, resppath.1, respparams.1,
                                  finalfragment.1, referrer.1, ~redirnonce
           ) ▶₀ #j )
      case ProcessRedirect303BadMethod
      by contradiction /* cyclic */
    qed
  next
    case ProcessRedirect303BadMethod_case_2
    solve( ProcessRedirectFinish( ~processid.1, $Browser, ~nonce,
                                  $status, finalorigin.1, $method, bodytwo, refpolicy.1,
                                  $respScheme.1, $respDomain.1, resppath.1, respparams.1,
                                  finalfragment.1, referrer.1, ~redirnonce
           ) ▶₀ #j )
      case ProcessRedirect303BadMethod
      by contradiction /* cyclic */
    qed
  next
    case ProcessRedirect303BadMethod_case_3
    solve( ProcessRedirectFinish( ~processid.1, $Browser, ~nonce,
                                  $status, finalorigin, $method, bodytwo, refpolicy.1,
                                  $respScheme.1, $respDomain.1, resppath.1, respparams.1,
                                  finalfragment.1, referrer.1, ~redirnonce
           ) ▶₀ #j )
      case ProcessRedirect303BadMethod
      by contradiction /* cyclic */
    qed
  next
    case ProcessRedirect303BadMethod_case_4
