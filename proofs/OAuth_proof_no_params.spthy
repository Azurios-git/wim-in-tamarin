    solve( ProcessRedirectFinish( ~processid.1, $Browser, ~nonce,
                                  $status, finalorigin, $method.1, bodytwo, refpolicy.1,
                                  $respScheme.1, $respDomain.1, resppath.1, respparams.1,
                                  finalfragment.1, referrer.1, ~redirnonce
           ) ▶₀ #j )
      case ProcessRedirect303
      by contradiction /* cyclic */
    qed
  next
    case ProcessRedirect303_case_4
    solve( ProcessRedirectFinish( ~processid.1, $Browser, ~nonce,
                                  $status, finalorigin, $method.1, bodytwo, refpolicy.1,
                                  $respScheme.1, $respDomain.1, resppath.1, respparams.1,
                                  finalfragment.1, referrer.1, ~redirnonce
           ) ▶₀ #j )
      case ProcessRedirect303
      by contradiction /* cyclic */
    qed
  next
    case ProcessRedirect307_case_1
    solve( ProcessRedirectFinish( ~processid.1, $Browser, ~nonce,
                                  $status, finalorigin.1, $method.1, bodytwo, refpolicy.1,
                                  $respScheme.1, $respDomain.1, resppath.1, respparams.1,
                                  finalfragment.1, referrer.1, ~redirnonce
           ) ▶₀ #j )
      case ProcessRedirect307
      by contradiction /* cyclic */
    qed
  next
    case ProcessRedirect307_case_2
    solve( ProcessRedirectFinish( ~processid.1, $Browser, ~nonce,
                                  $status, finalorigin.1, $method.1, bodytwo, refpolicy.1,
                                  $respScheme.1, $respDomain.1, resppath.1, respparams.1,
                                  finalfragment.1, referrer.1, ~redirnonce
           ) ▶₀ #j )
      case ProcessRedirect307
      by contradiction /* cyclic */
    qed
  next
    case ProcessRedirect307_case_3
    solve( ProcessRedirectFinish( ~processid.1, $Browser, ~nonce,
                                  $status, finalorigin, $method.1, bodytwo, refpolicy.1,
                                  $respScheme.1, $respDomain.1, resppath.1, respparams.1,
                                  finalfragment.1, referrer.1, ~redirnonce
           ) ▶₀ #j )
      case ProcessRedirect307
      by contradiction /* cyclic */
    qed
  next
    case ProcessRedirect307_case_4
    solve( ProcessRedirectFinish( ~processid.1, $Browser, ~nonce,
                                  $status, finalorigin, $method.1, bodytwo, refpolicy.1,
                                  $respScheme.1, $respDomain.1, resppath.1, respparams.1,
                                  finalfragment.1, referrer.1, ~redirnonce
           ) ▶₀ #j )
      case ProcessRedirect307
      by contradiction /* cyclic */
    qed
  qed
qed

lemma redir_loops_beginning_ordering [reuse, use_induction]:
  all-traces
  "∀ browser dom inmsgnonce redirnonce status outmsgnonce body #j.
    (Continue_Redir( browser, dom, inmsgnonce, redirnonce, status,
                     outmsgnonce, body
     ) @ #j) ⇒
    ((∃ method reqbody reqdom otherdom secondinmsgnonce thirdinmsgnonce
        otherstatus otherbody #k #l.
       ((Fresh_Redirnonce( browser, redirnonce, reqbody, reqdom, method,
                           secondinmsgnonce
         ) @ #l) ∧
        (Continue_Redir( browser, otherdom, secondinmsgnonce, redirnonce,
                         otherstatus, thirdinmsgnonce, otherbody
         ) @ #k)) ∧
       (#k < #j)) ∨
     (∃ method reqbody reqdom #k.
       Fresh_Redirnonce( browser, redirnonce, reqbody, reqdom, method,
                         inmsgnonce
       ) @ #k))"
/*
guarded formula characterizing all counter-examples:
"∃ browser dom inmsgnonce redirnonce status outmsgnonce body #j.
  (Continue_Redir( browser, dom, inmsgnonce, redirnonce, status,
                   outmsgnonce, body
   ) @ #j)
 ∧
  (∀ method reqbody reqdom otherdom secondinmsgnonce thirdinmsgnonce
     otherstatus otherbody #k #l.
    (Fresh_Redirnonce( browser, redirnonce, reqbody, reqdom, method,
                       secondinmsgnonce
     ) @ #l) ∧
    (Continue_Redir( browser, otherdom, secondinmsgnonce, redirnonce,
                     otherstatus, thirdinmsgnonce, otherbody
     ) @ #k)
   ⇒
    ¬(#k < #j)) ∧
  (∀ method reqbody reqdom #k.
    (Fresh_Redirnonce( browser, redirnonce, reqbody, reqdom, method,
                       inmsgnonce
     ) @ #k)
   ⇒
    ⊥)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ browser dom inmsgnonce redirnonce status outmsgnonce body
            #j.
           (Continue_Redir( browser, dom, inmsgnonce, redirnonce, status,
                            outmsgnonce, body
            ) @ #j)
          ⇒
           ((last(#j)) ∨
            (∃ method reqbody reqdom otherdom secondinmsgnonce thirdinmsgnonce
               otherstatus otherbody #k #l.
              (Fresh_Redirnonce( browser, redirnonce, reqbody, reqdom, method,
                                 secondinmsgnonce
               ) @ #l) ∧
              (Continue_Redir( browser, otherdom, secondinmsgnonce, redirnonce,
                               otherstatus, thirdinmsgnonce, otherbody
               ) @ #k)
             ∧
              (¬(last(#l))) ∧ (¬(last(#k))) ∧ (#k < #j)) ∨
            (∃ method reqbody reqdom #k.
              (Fresh_Redirnonce( browser, redirnonce, reqbody, reqdom, method,
                                 inmsgnonce
               ) @ #k)
             ∧
              ¬(last(#k)))))  ∥
         (∃ cookie #i.
           (Uninit( cookie ) @ #i)
          ∧
           (¬(last(#i))) ∧
           (¬(cookie = NoCookies)) ∧
           (∀ a b.
             (cookie = (a++b))
            ⇒
             ∃ rest singleton.
              (cookie = (rest++singleton))
             ∧
              ∀ name. (singleton = <name, uninit>) ⇒ ⊥)) )
    case case_1
    solve( (last(#j))  ∥
           (∃ method reqbody reqdom otherdom secondinmsgnonce thirdinmsgnonce
              otherstatus otherbody #k #l.
             (Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom, method,
                                secondinmsgnonce
              ) @ #l) ∧
             (Continue_Redir( $Browser, otherdom, secondinmsgnonce, ~redirnonce,
                              otherstatus, thirdinmsgnonce, otherbody
              ) @ #k)
            ∧
             (¬(last(#l))) ∧ (¬(last(#k))) ∧ (#k < #j))  ∥
           (∃ method reqbody reqdom #k.
             (Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom, method,
                                ~nonce
              ) @ #k)
            ∧
             ¬(last(#k))) )
      case case_1
      solve( (∃ method reqbody reqdom otherdom secondinmsgnonce
                thirdinmsgnonce otherstatus otherbody #k #l.
               (Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom, method,
                                  secondinmsgnonce
                ) @ #l) ∧
               (Continue_Redir( $Browser, otherdom, secondinmsgnonce, ~redirnonce,
                                otherstatus, thirdinmsgnonce, otherbody
                ) @ #k))  ∥
             (∃ method reqbody reqdom #k.
               (Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom, method,
                                  ~nonce
                ) @ #k)) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        by contradiction /* from formulas */
      qed
    next
      case case_2
      by contradiction /* from formulas */
    next
      case case_3
      by contradiction /* from formulas */
    qed
  next
    case case_2
    solve( (cookie = NoCookies)  ∥
           (∃ a b.
             (cookie = (a++b))
            ∧
             ∀ rest singleton.
              (cookie = (rest++singleton))
             ⇒
              ∃ name. (singleton = <name, uninit>)) )
      case case_1
      by contradiction /* from formulas */
    next
      case case_2_case_1
      by contradiction /* from formulas */
    next
      case case_2_case_2
      by contradiction /* from formulas */
    qed
  qed
qed

lemma aux_first [reuse, hide_lemma=linearize]:
  all-traces
  "∀ browser redirnonce reqbody reqdom method inmsgnonce status
     outmsgnonce outbody outdom thirddom thirdin thirdstat thirdout
     thirdbod #i #j #k.
    (((Fresh_Redirnonce( browser, redirnonce, reqbody, reqdom, method,
                         inmsgnonce
       ) @ #i) ∧
      (Continue_Redir( browser, outdom, inmsgnonce, redirnonce, status,
                       outmsgnonce, outbody
       ) @ #j)) ∧
     (Continue_Redir( browser, thirddom, thirdin, redirnonce, thirdstat,
                      thirdout, thirdbod
      ) @ #k)) ⇒
    ((#j < #k) ∨ (#j = #k))"
/*
guarded formula characterizing all counter-examples:
"∃ browser redirnonce reqbody reqdom method inmsgnonce status
   outmsgnonce outbody outdom thirddom thirdin thirdstat thirdout
   thirdbod #i #j #k.
  (Fresh_Redirnonce( browser, redirnonce, reqbody, reqdom, method,
                     inmsgnonce
   ) @ #i) ∧
  (Continue_Redir( browser, outdom, inmsgnonce, redirnonce, status,
                   outmsgnonce, outbody
   ) @ #j) ∧
  (Continue_Redir( browser, thirddom, thirdin, redirnonce, thirdstat,
                   thirdout, thirdbod
   ) @ #k)
 ∧
  (¬(#j < #k)) ∧ (¬(#j = #k))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (#j = #k)  ∥ (#k < #j) )
    case case_1
    by contradiction /* from formulas */
  next
    case case_2
    solve( (∀ browser redirnonce reqbody reqdom method inmsgnonce
              status outmsgnonce outbody outdom thirddom thirdin thirdstat
              thirdout thirdbod #i #j #k.
             (Fresh_Redirnonce( browser, redirnonce, reqbody, reqdom, method,
                                inmsgnonce
              ) @ #i) ∧
             (Continue_Redir( browser, outdom, inmsgnonce, redirnonce, status,
                              outmsgnonce, outbody
              ) @ #j) ∧
             (Continue_Redir( browser, thirddom, thirdin, redirnonce, thirdstat,
                              thirdout, thirdbod
              ) @ #k)
            ⇒
             ((last(#k)) ∨ (last(#j)) ∨ (last(#i)) ∨ (#j < #k) ∨ (#j = #k)))  ∥
           (∃ cookie #i.
             (Uninit( cookie ) @ #i)
            ∧
             (¬(last(#i))) ∧
             (¬(cookie = NoCookies)) ∧
             (∀ a b.
               (cookie = (a++b))
              ⇒
               ∃ rest singleton.
                (cookie = (rest++singleton))
               ∧
                ∀ name. (singleton = <name, uninit>) ⇒ ⊥)) )
      case case_1
      solve( (last(#j))  ∥ (last(#i)) )
        case case_1
        solve( (∃ method reqbody reqdom otherdom secondinmsgnonce
                  thirdinmsgnonce otherstatus otherbody #k.1 #l.
                 (Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom, method,
                                    secondinmsgnonce
                  ) @ #l) ∧
                 (Continue_Redir( $Browser, otherdom, secondinmsgnonce, ~redirnonce,
                                  otherstatus, thirdinmsgnonce, otherbody
                  ) @ #k.1)
                ∧
                 #k.1 < #k)  ∥
               (∃ method reqbody reqdom #k.
                 (Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom, method,
                                    ~nonce.1
                  ) @ #k)) )
          case case_1
          solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom,
                                   method.3, ~nonce
                 ) @ #i )
            case AdversaryRunScriptFormGet
            solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom,
                                     method.3, ~nonce.2
                   ) @ #i )
              case AdversaryRunScriptFormGet
              by contradiction /* cyclic */
            qed
          next
            case AdversaryRunScriptFormPost
            solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody.2,
                                     otherdom, scheme, msgnonce.3
                   ) @ #i )
              case AdversaryRunScriptFormPost
              solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody.1, reqdom,
                                       method.3, ~nonce.2
                     ) @ #i )
                case AdversaryRunScriptFormPost
                by contradiction /* cyclic */
              qed
            qed
          next
            case AdversaryRunScriptHrefIframe
            solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody.2,
                                     otherdom, scheme, msgnonce.3
                   ) @ #i )
              case AdversaryRunScriptHrefIframe
              solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom,
                                       method.3, ~nonce.2
                     ) @ #i )
                case AdversaryRunScriptHrefIframe
                by contradiction /* cyclic */
              qed
            qed
          next
            case AdversaryRunScriptXHRGetHead
            solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody.2,
                                     otherdom, scheme, msgnonce.3
                   ) @ #i )
              case AdversaryRunScriptXHRGetHead
              solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom,
                                       method.4, ~nonce.2
                     ) @ #i )
                case AdversaryRunScriptXHRGetHead
                by contradiction /* cyclic */
              qed
            qed
          next
            case AdversaryRunScriptXHROther
            solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody.2,
                                     otherdom, scheme, msgnonce.3
                   ) @ #i )
              case AdversaryRunScriptXHROther
              solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody.1, reqdom,
                                       method.4, ~nonce.2
                     ) @ #i )
                case AdversaryRunScriptXHROther
                by contradiction /* cyclic */
              qed
            qed
          next
            case BrowserOutUser
            solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody.2,
                                     otherdom, scheme.1, msgnonce.3
                   ) @ #i )
              case BrowserOutUser
              solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody.1, reqdom,
                                       method.4, ~nonce.2
                     ) @ #i )
                case BrowserOutUser
                by contradiction /* cyclic */
              qed
            qed
          next
            case CompromisedBrowserSend
            solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody.2,
                                     otherdom, scheme, msgnonce.3
                   ) @ #i )
              case CompromisedBrowserSend
              solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody.1, reqdom,
                                       method.4, ~nonce.2
                     ) @ #i )
                case CompromisedBrowserSend
                by contradiction /* cyclic */
              qed
            qed
          next
            case OpenURL
            solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody.2,
                                     otherdom, scheme, msgnonce.3
                   ) @ #i )
              case OpenURL
              solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom,
                                       method.3, ~nonce.2
                     ) @ #i )
                case OpenURL
                by contradiction /* cyclic */
              qed
            qed
          next
            case ServerCreateRequestUser
            solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody.2,
                                     otherdom, scheme, msgnonce.3
                   ) @ #i )
              case ServerCreateRequestUser
              solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody.1, reqdom,
                                       method.4, ~nonce.2
                     ) @ #i )
                case ServerCreateRequestUser
                by contradiction /* cyclic */
              qed
            qed
          qed
        next
          case case_2
          solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom,
                                   method.2, ~nonce
                 ) @ #i )
            case AdversaryRunScriptFormGet
            solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody.3,
                                     otherdom.3, scheme.3, msgnonce.5
                   ) @ #i )
              case AdversaryRunScriptFormGet
              solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody,
                                       otherdom, scheme, msgnonce.2
                     ) @ #i )
                case AdversaryRunScriptFormGet
                solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody.1,
                                         otherdom.1, scheme.1, msgnonce.3
                       ) @ #i )
                  case AdversaryRunScriptFormGet
                  solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody,
                                           otherdom, scheme, msgnonce.2
                         ) @ #i )
                    case AdversaryRunScriptFormGet
                    solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom,
                                             method.2, ~nonce.1
                           ) @ #i )
                      case AdversaryRunScriptFormGet
                      by contradiction /* cyclic */
                    qed
                  qed
                qed
              qed
            qed
          next
            case AdversaryRunScriptFormPost
            solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody,
                                     otherdom, scheme, msgnonce.2
                   ) @ #i )
              case AdversaryRunScriptFormPost
              solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody.3,
                                       otherdom.2, scheme.2, msgnonce.4
                     ) @ #i )
                case AdversaryRunScriptFormPost
                solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody.2,
                                         otherdom.1, scheme.1, msgnonce.3
                       ) @ #i )
                  case AdversaryRunScriptFormPost
                  solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody.1,
                                           otherdom, scheme, msgnonce.2
                         ) @ #i )
                    case AdversaryRunScriptFormPost
                    solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom,
                                             method.2, ~nonce.1
                           ) @ #i )
                      case AdversaryRunScriptFormPost
                      by contradiction /* cyclic */
                    qed
                  qed
                qed
              qed
            qed
          next
            case AdversaryRunScriptHrefIframe
            solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom,
                                     method.2, ~nonce.1
                   ) @ #i )
              case AdversaryRunScriptHrefIframe
              by contradiction /* cyclic */
            qed
          next
            case AdversaryRunScriptXHRGetHead
            solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom,
                                     method.3, ~nonce.1
                   ) @ #i )
              case AdversaryRunScriptXHRGetHead
              by contradiction /* cyclic */
            qed
          next
            case AdversaryRunScriptXHROther
            solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody.1, reqdom,
                                     method.3, ~nonce.1
                   ) @ #i )
              case AdversaryRunScriptXHROther
              by contradiction /* cyclic */
            qed
          next
            case BrowserOutUser
            solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody.1, reqdom,
                                     method.3, ~nonce.1
                   ) @ #i )
              case BrowserOutUser
              by contradiction /* cyclic */
            qed
          next
            case CompromisedBrowserSend
            solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody.1, reqdom,
                                     method.3, ~nonce.1
                   ) @ #i )
              case CompromisedBrowserSend
              by contradiction /* cyclic */
            qed
          next
            case OpenURL
            solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom,
                                     method.2, ~nonce.1
                   ) @ #i )
              case OpenURL
              by contradiction /* cyclic */
            qed
          next
            case ServerCreateRequestUser
            solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody.1, reqdom,
                                     method.3, ~nonce.1
                   ) @ #i )
              case ServerCreateRequestUser
              by contradiction /* cyclic */
            qed
          qed
        qed
      next
        case case_2
        solve( Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom,
                                 method.2, ~nonce
               ) @ #i )
          case AdversaryRunScriptFormGet
          by contradiction /* node #j after last node #i */
        next
          case AdversaryRunScriptFormPost
          by contradiction /* node #j after last node #i */
        next
          case AdversaryRunScriptHrefIframe
          by contradiction /* node #j after last node #i */
        next
          case AdversaryRunScriptXHRGetHead
          by contradiction /* node #j after last node #i */
        next
          case AdversaryRunScriptXHROther
          by contradiction /* node #j after last node #i */
        next
          case BrowserOutUser
          by contradiction /* node #j after last node #i */
        next
          case CompromisedBrowserSend
          by contradiction /* node #j after last node #i */
        next
          case OpenURL
          by contradiction /* node #j after last node #i */
        next
          case ServerCreateRequestUser
          by contradiction /* node #j after last node #i */
        qed
      qed
    next
      case case_2
      solve( (cookie = NoCookies)  ∥
             (∃ a b.
               (cookie = (a++b))
              ∧
               ∀ rest singleton.
                (cookie = (rest++singleton))
               ⇒
                ∃ name. (singleton = <name, uninit>)) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2_case_1
        by contradiction /* from formulas */
      next
        case case_2_case_2
        by contradiction /* from formulas */
      qed
    qed
  qed
qed

lemma ordering_helper [reuse]:
  all-traces
  "∀ browser dom innonce redirnonce outnonce body domtwo innoncetwo
     outnoncetwo bodytwo status otherstatus #i #j.
    (((Continue_Redir( browser, dom, innonce, redirnonce, status,
                       outnonce, body
       ) @ #i) ∧
      (Continue_Redir( browser, domtwo, innoncetwo, redirnonce,
                       otherstatus, outnoncetwo, bodytwo
       ) @ #j)) ∧
     (#i < #j)) ⇒
    ((outnonce = innoncetwo) ∨
     (∃ thirddom thirdout thirdstat thirdbod #k.
       (Continue_Redir( browser, thirddom, outnonce, redirnonce,
                        thirdstat, thirdout, thirdbod
        ) @ #k) ∧
       (#k < #j)))"
/*
guarded formula characterizing all counter-examples:
"∃ browser dom innonce redirnonce outnonce body domtwo innoncetwo
   outnoncetwo bodytwo status otherstatus #i #j.
  (Continue_Redir( browser, dom, innonce, redirnonce, status,
                   outnonce, body
   ) @ #i) ∧
  (Continue_Redir( browser, domtwo, innoncetwo, redirnonce,
                   otherstatus, outnoncetwo, bodytwo
   ) @ #j)
 ∧
  (#i < #j) ∧
  (¬(outnonce = innoncetwo)) ∧
  (∀ thirddom thirdout thirdstat thirdbod #k.
    (Continue_Redir( browser, thirddom, outnonce, redirnonce,
                     thirdstat, thirdout, thirdbod
     ) @ #k)
   ⇒
    ¬(#k < #j))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ browser dom innonce redirnonce outnonce body domtwo
            innoncetwo outnoncetwo bodytwo status otherstatus #i #j.
           (Continue_Redir( browser, dom, innonce, redirnonce, status,
                            outnonce, body
            ) @ #i) ∧
           (Continue_Redir( browser, domtwo, innoncetwo, redirnonce,
                            otherstatus, outnoncetwo, bodytwo
            ) @ #j)
          ⇒
           ((last(#j)) ∨
            (last(#i)) ∨
            (#i = #j) ∨
            (#j < #i) ∨
            (outnonce = innoncetwo) ∨
            (∃ thirddom thirdout thirdstat thirdbod #k.
              (Continue_Redir( browser, thirddom, outnonce, redirnonce,
                               thirdstat, thirdout, thirdbod
               ) @ #k)
             ∧
              (¬(last(#k))) ∧ (#k < #j))))  ∥
         (∃ cookie #i.
           (Uninit( cookie ) @ #i)
          ∧
           (¬(last(#i))) ∧
           (¬(cookie = NoCookies)) ∧
           (∀ a b.
             (cookie = (a++b))
            ⇒
             ∃ rest singleton.
              (cookie = (rest++singleton))
             ∧
              ∀ name. (singleton = <name, uninit>) ⇒ ⊥)) )
    case case_1
    solve( (last(#j))  ∥ (~msgnonce = ~nonce.1)  ∥
           (∃ thirddom thirdout thirdstat thirdbod #k.
             (Continue_Redir( $Browser, thirddom, ~msgnonce, ~redirnonce,
                              thirdstat, thirdout, thirdbod
              ) @ #k)
            ∧
             (¬(last(#k))) ∧ (#k < #j)) )
      case case_1
      solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody,
                               otherdom, scheme, msgnonce.2
