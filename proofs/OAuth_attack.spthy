  /* has exactly the trivial AC variant */

rule (modulo E) LeakSecrets:
   [
   !LeakState( $Browser, $Domain, $Scheme, $TLW ),
   !Secrets( $Browser, $Domain, $Scheme, data )
   ]
  -->
   [ Out( data ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) LeakServerSecrets:
   [ !CompromisedDomain( $Domain ), !ServerSecret( $Domain, secret ) ]
  -->
   [ Out( secret ) ]

  /* has exactly the trivial AC variant */

restriction OnlyOnce:
  "∀ x #i #j.
    ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction Equality:
  "∀ a b #i. (Eq( a, b ) @ #i) ⇒ (a = b)"
  // safety formula

restriction Init:
  "∀ cookie #i.
    (Uninit( cookie ) @ #i) ⇒
    ((cookie = NoCookies) ∨
     (∃ a b.
       (cookie = (a++b)) ∧
       (∀ rest singleton.
         (cookie = (rest++singleton)) ⇒
         (∃ name. singleton = <name, uninit>))))"

lemma aux_unique_requests [reuse]:
  all-traces
  "∀ nonce #i #j.
    ((Send_Request_Nonce( nonce ) @ #i) ∧
     (Send_Request_Nonce( nonce ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ nonce #i #j.
  (Send_Request_Nonce( nonce ) @ #i) ∧
  (Send_Request_Nonce( nonce ) @ #j)
 ∧
  ¬(#i = #j)"
*/
by sorry

rule (modulo E) preShareLoginDetails:
   [
   !ClaimDomain( $Domain, 'AuthServer' ), !Browser( ~bid, $Browser ),
   Fr( ~login )
   ]
  --[
  Credentials( $Browser, $Domain, ~login ),
  OnlyOnce( <'PreShareLogin', $Browser, $Domain> )
  ]->
   [
   !LoginDetails( $Domain, ~login ),
   !Secrets( $Browser, $Domain, 'https', ~login )
   ]

  /* has exactly the trivial AC variant */

restriction Restr_SetupEndPointsAuth_1:
  "∀ x #NOW x.1.
    (Restr_SetupEndPointsAuth_1( x, x.1 ) @ #NOW) ⇒ (¬(x = x.1))"
  // safety formula

rule (modulo E) SetupEndPointsAuth:
   [ !ClaimDomain( $AuthDomain, 'AuthServer' ) ]
  --[
  Auth( $AuthDomain ),
  Restr_SetupEndPointsAuth_1( $AuthEndPoint, $TokenEndPoint )
  ]->
   [
   !AuthEndPoint( $AuthDomain, $AuthEndPoint ),
   !TokenEndPoint( $AuthDomain, $TokenEndPoint )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) RegisterClient:
   [
   !ClaimDomain( $AuthDomain, 'AuthServer' ),
   !ClaimDomain( $ClientDomain, 'Client' ), Fr( ~login )
   ]
  --[
  OnlyOnce( <'RegisterClient', $ClientDomain, $AuthDomain> ),
  Client( $ClientDomain )
  ]->
   [
   !ClientCredentials( $ClientDomain, $AuthDomain, ~login ),
   !RedirectEndPoint( $ClientDomain, $AuthDomain, $RedirectEndPoint )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) miniServerIn:
   [
   !ClaimDomain( $ClientDomain, 'Client' ),
   !AuthEndPoint( $AuthDomain, $AuthEndPoint ),
   Server_In( $Browser, $ClientDomain, 'https', ~nonce, 'GET',
              '/init', parameters, newPlain, newSec, origin, NewReferer, NewAuth,
              newbody, adv
   )
   ]
  -->
   [
   Server_Out( $ClientDomain, $Browser, 'https', ~nonce, '200',
               NoCookies, NoCookies, NoLocation, 'top', NoRefPolicy,
               <'AuthenticateClient', 
                Container(<$AuthDomain, $AuthEndPoint, $ClientDomain>)>,
               'honest'
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) InitiateAuth:
   [
   Document( ~did, $Browser, $TLW,
             <$Scheme, $DocDomain, path, params, fragment>, referer, refpolicy,
             'AuthenticateClient',
             Container(<$AuthDomain, $AuthEndPoint, $ClientDomain>)
   ),
   !Secrets( $Browser, $AuthDomain, 'https', ~login )
   ]
  --[
  InitAuth( ), PDAddBody( <~login, $ClientDomain, 'ScopeOfRequest'> )
  ]->
   [
   Send_Request_Browser( $Browser, $TLW, 'REQ', 'https', $AuthDomain,
                         $AuthEndPoint, NoParams, 'bot', 'POST', NoAuth,
                         <$Scheme, $DocDomain>, NoReferrer, NoRefPolicy,
                         <~login, $ClientDomain, 'ScopeOfRequest'>
   ),
   Document( ~did, $Browser, $TLW,
             <$Scheme, $DocDomain, path, params, fragment>, referer, refpolicy,
             'AuthenticateClient',
             Container(<$AuthDomain, $AuthEndPoint, $ClientDomain, 'Clicked'>)
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) SuccessfulAuth307:
   [
   !ClaimDomain( $AuthDomain, 'AuthServer' ),
   !AuthEndPoint( $AuthDomain, $AuthEndPoint ),
   !RedirectEndPoint( $ClientDomain, $AuthDomain, $RedirectEndPoint ),
   Fr( ~authcode ), !LoginDetails( $AuthDomain, ~login ),
   Server_In( $Browser, $AuthDomain, 'https', ~nonce, 'POST',
              $AuthEndPoint, parameters, newPlain, newSec, origin, NewReferer,
              NewAuth, <~login, $ClientDomain, 'ScopeOfRequest'>, adv
   )
   ]
  --[ Test( ), CredentialsSent( ~login ) ]->
   [
   Server_Out( $AuthDomain, $Browser, 'https', ~nonce, '307',
               NoCookies, NoCookies,
               <'https', $ClientDomain, $RedirectEndPoint, 
                (NoParams++<'Authcode', ~authcode>), 'bot'>,
               'bot', NoRefPolicy, NoBody, 'honest'
   ),
   !RedirectURL( $AuthDomain, ~authcode,
                 <'https', $ClientDomain, $RedirectEndPoint, 
                  (NoParams++<'Authcode', ~authcode>), 'bot'>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) GotRedirected:
   [
   !ClaimDomain( $ClientDomain, 'Client' ),
   !RedirectURL( $AuthDomain, ~authcode,
                 <'https', $ClientDomain, $RedirectEndPoint, 
                  (NoParams++<'Authcode', ~authcode>), 'bot'>
   ),
   !TokenEndPoint( $AuthDomain, $TokenEndPoint ),
   !ClientCredentials( $ClientDomain, $AuthDomain, ~ClientCredentials
   ),
   Server_In( $Browser, $ClientDomain, 'https', ~recvnonce, 'GET',
              $RedirectEndPoint, (parameters++<'Authcode', ~authcode>), newPlain,
              newSec, origin, NewReferer, NewAuth, newbody, adv
   ),
   Fr( ~nonce )
   ]
  --[
  Done( ),
  PDAddBody( <
              <'https', $ClientDomain, $RedirectEndPoint, 
               (NoParams++<'Authcode', ~authcode>), 'bot'>, 
              ~authcode, ~ClientCredentials>
  )
  ]->
   [
   Send_Request( $ClientDomain, $AuthDomain, 'https', ~nonce, 'POST',
                 $TokenEndPoint, NoParams, NoCookies, NoCookies, NoOrigin,
                 NoReferrer, NoAuth,
                 <
                  <'https', $ClientDomain, $RedirectEndPoint, 
                   (NoParams++<'Authcode', ~authcode>), 'bot'>, 
                  ~authcode, ~ClientCredentials>
   ),
   TokenRequest( $ClientDomain, $AuthDomain, ~nonce )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) ReturnToken:
   [
   !ClientCredentials( $ClientDomain, $AuthDomain, ~ClientCredentials
   ),
   !TokenEndPoint( $AuthDomain, $TokenEndPoint ),
   !RedirectURL( $AuthDomain, ~authcode, redirectURL ),
   Server_In( $ClientDomain, $AuthDomain, 'https', ~nonce, 'POST',
              $TokenEndPoint, parameters, newPlain, newSec, origin, NewReferer,
              NewAuth, <redirectURL, ~authcode, ~ClientCredentials>, adv
   ),
   Fr( ~token )
   ]
  --[ TokenSent( ~token ) ]->
   [
   Server_Out( $AuthDomain, $ClientDomain, 'https', ~nonce, '200',
               NoCookies, NoCookies, NoLocation, NoSTS, NoRefPolicy, ~token,
               'honest'
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) GetToken:
   [
   TokenRequest( $ClientDomain, $AuthDomain, ~nonce ),
   Browser_In( $AuthDomain, $ClientDomain, 'https', ~nonce, status,
               setcookiesplain, setcookiessec, location, sts, refpolicy, ~token
   )
   ]
  --[ TokenReceived( ~token ) ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma executability:
  exists-trace
  "∃ #i.
    ((Done( ) @ #i) ∧ (¬(∃ #j. AdvActive( ) @ #j))) ∧
    (∀ browser b2 domain d2 nonce n2 s1 s2 #i.1 #j.
      ((RedirFrom( browser, domain, s1, nonce ) @ #i.1) ∧
       (RedirFrom( b2, d2, s2, n2 ) @ #j)) ⇒
      (#i.1 = #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ #i.
  (Done( ) @ #i)
 ∧
  (∀ #j. (AdvActive( ) @ #j) ⇒ ⊥) ∧
  (∀ browser b2 domain d2 nonce n2 s1 s2 #i.1 #j.
    (RedirFrom( browser, domain, s1, nonce ) @ #i.1) ∧
    (RedirFrom( b2, d2, s2, n2 ) @ #j)
   ⇒
    #i.1 = #j)"
*/
by sorry

lemma exec307Attack:
  exists-trace
  "(((∃ credentials browser authdom #i #j.
       ((K( credentials ) @ #i) ∧
        (Credentials( browser, authdom, credentials ) @ #j)) ∧
       (¬(∃ #k. CompromiseDomain( authdom ) @ #k))) ∧
     (∀ browser domain scheme #i.
       (Send_Out( browser, domain, scheme ) @ #i) ⇒ (scheme = 'https'))) ∧
    (¬(∃ #i browser. CompromiseBrowser( browser ) @ #i))) ∧
   (∀ #i #j b d.
     ((CreateBrowser( b ) @ #i) ∧ (CreateBrowser( d ) @ #j)) ⇒
     ((b = d) ∧
      (∀ browser b2 domain d2 nonce n2 s1 s2 #i.1 #j.1.
        ((RedirFrom( browser, domain, s1, nonce ) @ #i.1) ∧
         (RedirFrom( b2, d2, s2, n2 ) @ #j.1)) ⇒
        (#i.1 = #j.1))))"
/*
guarded formula characterizing all satisfying traces:
"(∃ credentials browser authdom #i #j.
   (K( credentials ) @ #i) ∧
   (Credentials( browser, authdom, credentials ) @ #j)
  ∧
   ∀ #k. (CompromiseDomain( authdom ) @ #k) ⇒ ⊥) ∧
 (∀ browser domain scheme #i.
   (Send_Out( browser, domain, scheme ) @ #i) ⇒ scheme = 'https') ∧
 (∀ #i browser. (CompromiseBrowser( browser ) @ #i) ⇒ ⊥) ∧
 (∀ #i #j b d.
   (CreateBrowser( b ) @ #i) ∧ (CreateBrowser( d ) @ #j)
  ⇒
   (b = d) ∧
   (∀ browser b2 domain d2 nonce n2 s1 s2 #i.1 #j.1.
     (RedirFrom( browser, domain, s1, nonce ) @ #i.1) ∧
     (RedirFrom( b2, d2, s2, n2 ) @ #j.1)
    ⇒
     #i.1 = #j.1))"
*/
simplify
