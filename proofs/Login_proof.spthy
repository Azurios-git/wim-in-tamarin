lemma aux_honest_replies [reuse, use_induction]:
  all-traces
  "∀ browser redirnonce body dom otherbody otherdom msgnonce scheme
     #i #j.
    ((Fresh_Redirnonce( browser, redirnonce, body, dom, scheme,
                        msgnonce
      ) @ #i) ∧
     (Send_redirnonce( browser, redirnonce, otherbody, otherdom
      ) @ #j)) ⇒
    ((Send_Request_Nonce( msgnonce ) @ #j) ∨
     (∃ status secondmsgnonce redirbody thirddom #l.
       (((status = '303') ∨ (status = '307')) ∧
        (Continue_Redir( browser, thirddom, msgnonce, redirnonce, status,
                         secondmsgnonce, redirbody
         ) @ #l)) ∧
       (#l < #j)))"
/*
guarded formula characterizing all counter-examples:
"∃ browser redirnonce body dom otherbody otherdom msgnonce scheme
   #i #j.
  (Fresh_Redirnonce( browser, redirnonce, body, dom, scheme, msgnonce
   ) @ #i) ∧
  (Send_redirnonce( browser, redirnonce, otherbody, otherdom ) @ #j)
 ∧
  (¬(Send_Request_Nonce( msgnonce ) @ #j)) ∧
  (∀ status secondmsgnonce redirbody thirddom #l.
    (Continue_Redir( browser, thirddom, msgnonce, redirnonce, status,
                     secondmsgnonce, redirbody
     ) @ #l)
   ⇒
    (((¬(status = '303')) ∧ (¬(status = '307'))) ∨ (¬(#l < #j))))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ browser redirnonce body dom otherbody otherdom msgnonce
            scheme #i #j.
           (Fresh_Redirnonce( browser, redirnonce, body, dom, scheme, msgnonce
            ) @ #i) ∧
           (Send_redirnonce( browser, redirnonce, otherbody, otherdom ) @ #j)
          ⇒
           ((last(#j)) ∨
            (last(#i)) ∨
            (Send_Request_Nonce( msgnonce ) @ #j) ∨
            (∃ status secondmsgnonce redirbody thirddom #l.
              (Continue_Redir( browser, thirddom, msgnonce, redirnonce, status,
                               secondmsgnonce, redirbody
               ) @ #l)
             ∧
              (¬(last(#l))) ∧
              (((status = '303') ∨ (status = '307'))) ∧
              (#l < #j))))  ∥
         (∃ cookie #i.
           (Uninit( cookie ) @ #i)
          ∧
           (¬(last(#i))) ∧
           (¬(cookie = NoCookies)) ∧
           (∀ a b.
             (cookie = (a++b))
            ⇒
             ∃ rest singleton.
              (cookie = (rest++singleton))
             ∧
              ∀ name. (singleton = <name, uninit>) ⇒ ⊥)) )
    case case_1
    solve( Browser_Out( $Browser, window_or_doc_reference, $Domain,
                        $Scheme, $type, fragment, ~nonce, $method, $path, parameters,
                        plaincookies, seccookies, origin, referrer, auth, otherbody, adv,
                        ~redirnonce
           )[no_precomp] ▶₀ #j )
      case BrowserSendPlain_case_01
      solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody.1,
                               otherdom.1, scheme.2, msgnonce.2
             ) @ #i )
        case OpenURL
        solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody,
                                 otherdom, scheme.1, msgnonce.1
               ) @ #i )
          case OpenURL
          solve( Fresh_Redirnonce( $Browser, ~redirnonce, body, dom, scheme,
                                   msgnonce
                 ) @ #i )
            case OpenURL
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case BrowserSendPlain_case_02
      solve( (last(#i))  ∥ (Send_Request_Nonce( msgnonce ) @ #vr.7)  ∥
             (∃ status secondmsgnonce redirbody thirddom #l.
               (Continue_Redir( $Browser, thirddom, msgnonce, ~redirnonce, status,
                                secondmsgnonce, redirbody
                ) @ #l)
              ∧
               (¬(last(#l))) ∧
               (((status = '303') ∨ (status = '307'))) ∧
               (#l < #vr.7)) )
        case case_1
        solve( Fresh_Redirnonce( $Browser, ~redirnonce, body.2, dom,
                                 scheme.2, msgnonce
               ) @ #i )
          case AdversaryRunScriptFormGet
          by contradiction /* node #j after last node #i */
        next
          case AdversaryRunScriptFormPost
          by contradiction /* node #j after last node #i */
        next
          case AdversaryRunScriptHrefIframe
          by contradiction /* node #j after last node #i */
        next
          case AdversaryRunScriptXHRGetHead
          by contradiction /* node #j after last node #i */
        next
          case AdversaryRunScriptXHROther
          by contradiction /* node #j after last node #i */
        next
          case BrowserOutUser
          by contradiction /* node #j after last node #i */
        next
          case CompromisedBrowserSend
          by contradiction /* node #j after last node #i */
        next
          case OpenURL
          by contradiction /* node #j after last node #i */
        next
          case ServerCreateRequestUser
          by contradiction /* node #j after last node #i */
        qed
      next
        case case_2
        by contradiction /* from formulas */
      next
        case case_3
        solve( ProcessRedirectFinish( ~processid.1, $Browser, ~nonce.2,
                                      $status, finalorigin, $method.1, redirbody, refpolicy,
                                      $respScheme, $respDomain, resppath, respparams, finalfragment,
                                      referrer.1, ~redirnonce
               ) ▶₀ #l )
          case ProcessRedirect303BadMethod_case_1
          by contradiction /* from formulas */
        next
          case ProcessRedirect303BadMethod_case_2
          by contradiction /* from formulas */
        next
          case ProcessRedirect303BadMethod_case_3
          by contradiction /* from formulas */
        next
          case ProcessRedirect303BadMethod_case_4
          by contradiction /* from formulas */
        next
          case ProcessRedirect303_case_1
          by contradiction /* from formulas */
        next
          case ProcessRedirect303_case_2
          by contradiction /* from formulas */
        next
          case ProcessRedirect303_case_3
          by contradiction /* from formulas */
        next
          case ProcessRedirect303_case_4
          by contradiction /* from formulas */
        next
          case ProcessRedirect307_case_1
          by contradiction /* from formulas */
        next
          case ProcessRedirect307_case_2
          by contradiction /* from formulas */
        next
          case ProcessRedirect307_case_3
          by contradiction /* from formulas */
        next
          case ProcessRedirect307_case_4
          by contradiction /* from formulas */
        qed
      qed
    next
      case BrowserSendPlain_case_03
      solve( (last(#i))  ∥ (Send_Request_Nonce( msgnonce ) @ #vr.7)  ∥
             (∃ status secondmsgnonce redirbody thirddom #l.
               (Continue_Redir( $Browser, thirddom, msgnonce, ~redirnonce, status,
                                secondmsgnonce, redirbody
                ) @ #l)
              ∧
               (¬(last(#l))) ∧
               (((status = '303') ∨ (status = '307'))) ∧
               (#l < #vr.7)) )
        case case_1
        solve( Fresh_Redirnonce( $Browser, ~redirnonce, body.2, dom,
                                 scheme.2, msgnonce
               ) @ #i )
          case AdversaryRunScriptFormGet
          by contradiction /* node #j after last node #i */
        next
          case AdversaryRunScriptFormPost
          by contradiction /* node #j after last node #i */
        next
          case AdversaryRunScriptHrefIframe
          by contradiction /* node #j after last node #i */
        next
          case AdversaryRunScriptXHRGetHead
          by contradiction /* node #j after last node #i */
        next
          case AdversaryRunScriptXHROther
          by contradiction /* node #j after last node #i */
        next
          case BrowserOutUser
          by contradiction /* node #j after last node #i */
        next
          case CompromisedBrowserSend
          by contradiction /* node #j after last node #i */
        next
          case OpenURL
          by contradiction /* node #j after last node #i */
        next
          case ServerCreateRequestUser
          by contradiction /* node #j after last node #i */
        qed
      next
        case case_2
        by contradiction /* from formulas */
      next
        case case_3
        solve( ProcessRedirectFinish( ~processid.1, $Browser, ~nonce.2,
                                      $status, finalorigin, $method.1, redirbody, refpolicy,
                                      $respScheme, $respDomain, resppath, respparams, finalfragment,
                                      referrer.1, ~redirnonce
               ) ▶₀ #l )
          case ProcessRedirect303BadMethod_case_1
          by contradiction /* from formulas */
        next
          case ProcessRedirect303BadMethod_case_2
