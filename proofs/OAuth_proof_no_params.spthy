 ∧
  (¬(params = NoParams)) ∧
  (∀ #j. (!KU( params ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #k. (PDAddParams( params ) @ #k) ⇒ ¬(#k < #i))"
*/
by sorry

lemma sourceRefLeak [reuse]:
  all-traces
  "∀ Ref #i.
    (PDLeakRef( Ref ) @ #i) ⇒
    (((∃ #j. (!KU( Ref ) @ #j) ∧ (#j < #i)) ∨
      (∃ scheme dom path params fragment.
        (Ref = <scheme, dom, path, params, fragment>) ∧
        (((∃ #j. (PDAddParams( params ) @ #j) ∧ (#j < #i)) ∨
          (∃ #j. (!KU( params ) @ #j) ∧ (#j < #i))) ∨
         (params = NoParams)))) ∨
     (Ref = NoReferrer))"
/*
guarded formula characterizing all counter-examples:
"∃ Ref #i.
  (PDLeakRef( Ref ) @ #i)
 ∧
  (∀ #j. (!KU( Ref ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ scheme dom path params fragment.
    (Ref = <scheme, dom, path, params, fragment>)
   ⇒
    (∀ #j. (PDAddParams( params ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #j. (!KU( params ) @ #j) ⇒ ¬(#j < #i)) ∧
    (¬(params = NoParams))) ∧
  (¬(Ref = NoReferrer))"
*/
by sorry

lemma sourcePlain [sources]:
  all-traces
  "(((∀ b d p #i.
       (PDPlainLeak( b, d, p ) @ #i) ⇒
       (((∃ #j. (!KU( p ) @ #j) ∧ (#j < #i)) ∨
         (∃ #j. (PDAddPlainCookie( d, b, p ) @ #j) ∧ (#j < #i))) ∨
        (∃ name. p = <name, uninit>))) ∧
     (∀ cid browser domain name content rest #i.
       (PlainCookiesLoop( cid, browser, domain, (rest++<name, content>)
        ) @ #i) ⇒
       (((∃ #j. (!KU( <name, content> ) @ #j) ∧ (#j < #i)) ∨
         (content = uninit)) ∨
        (∃ #j.
          (PDAddPlainCookie( domain, browser, <name, content> ) @ #j) ∧
          (#j < #i))))) ∧
    (∀ cid browser domain cookie #i.
      (PlainCookiesAddSingle( cid, browser, domain, cookie ) @ #i) ⇒
      ((∃ setcookiessec #j.
         ((ReceivePlainCookies( browser, domain, setcookiessec ) @ #j) ∧
          (#j < #i)) ∧
         (∃ rest. setcookiessec = (cookie++rest))) ∨
       (∃ name. cookie = <name, uninit>)))) ∧
   (∀ processid browser domain cookies #i.
     (IncomingPlainLoop( processid, browser, domain, cookies ) @ #i) ⇒
     ((∃ super rest #j.
        (ReceivePlainCookies( browser, domain, super ) @ #j) ∧
        (super = (cookies++rest))) ∨
      (∃ #j. ReceivePlainCookies( browser, domain, cookies ) @ #j)))"
/*
guarded formula characterizing all counter-examples:
"((∃ b d p #i.
    (PDPlainLeak( b, d, p ) @ #i)
   ∧
    (∀ #j. (!KU( p ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #j. (PDAddPlainCookie( d, b, p ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ name. (p = <name, uninit>) ⇒ ⊥)) ∨
  (∃ cid browser domain name content rest #i.
    (PlainCookiesLoop( cid, browser, domain, (rest++<name, content>)
     ) @ #i)
   ∧
    (∀ #j. (!KU( <name, content> ) @ #j) ⇒ ¬(#j < #i)) ∧
    (¬(content = uninit)) ∧
    (∀ #j.
      (PDAddPlainCookie( domain, browser, <name, content> ) @ #j)
     ⇒
      ¬(#j < #i))) ∨
  (∃ cid browser domain cookie #i.
    (PlainCookiesAddSingle( cid, browser, domain, cookie ) @ #i)
   ∧
    (∀ setcookiessec #j.
      (ReceivePlainCookies( browser, domain, setcookiessec ) @ #j)
     ⇒
      ((¬(#j < #i)) ∨ (∀ rest. (setcookiessec = (cookie++rest)) ⇒ ⊥))) ∧
    (∀ name. (cookie = <name, uninit>) ⇒ ⊥)) ∨
  (∃ processid browser domain cookies #i.
    (IncomingPlainLoop( processid, browser, domain, cookies ) @ #i)
   ∧
    (∀ super rest #j.
      (ReceivePlainCookies( browser, domain, super ) @ #j) ∧
      (super = (cookies++rest))
     ⇒
      ⊥) ∧
    (∀ #j.
      (ReceivePlainCookies( browser, domain, cookies ) @ #j) ⇒ ⊥)))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∃ b d p #i.
           (PDPlainLeak( b, d, p ) @ #i)
          ∧
           (∀ #j. (!KU( p ) @ #j) ⇒ ¬(#j < #i)) ∧
           (∀ #j. (PDAddPlainCookie( d, b, p ) @ #j) ⇒ ¬(#j < #i)) ∧
           (∀ name. (p = <name, uninit>) ⇒ ⊥))  ∥
         (∃ cid browser domain name content rest #i.
           (PlainCookiesLoop( cid, browser, domain, (rest++<name, content>)
            ) @ #i)
          ∧
           (∀ #j. (!KU( <name, content> ) @ #j) ⇒ ¬(#j < #i)) ∧
           (¬(content = uninit)) ∧
           (∀ #j.
             (PDAddPlainCookie( domain, browser, <name, content> ) @ #j)
            ⇒
             ¬(#j < #i)))  ∥
         (∃ cid browser domain cookie #i.
           (PlainCookiesAddSingle( cid, browser, domain, cookie ) @ #i)
          ∧
           (∀ setcookiessec #j.
             (ReceivePlainCookies( browser, domain, setcookiessec ) @ #j)
            ⇒
             ((¬(#j < #i)) ∨ (∀ rest. (setcookiessec = (cookie++rest)) ⇒ ⊥))) ∧
           (∀ name. (cookie = <name, uninit>) ⇒ ⊥))  ∥
         (∃ processid browser domain cookies #i.
           (IncomingPlainLoop( processid, browser, domain, cookies ) @ #i)
          ∧
           (∀ super rest #j.
             (ReceivePlainCookies( browser, domain, super ) @ #j) ∧
             (super = (cookies++rest))
            ⇒
             ⊥) ∧
           (∀ #j.
             (ReceivePlainCookies( browser, domain, cookies ) @ #j) ⇒ ⊥)) )
    case case_1
    solve( ((∀ b d p #i.
              (PDPlainLeak( b, d, p ) @ #i)
             ⇒
              ((last(#i)) ∨
               (∃ #j. (!KU( p ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) ∨
               (∃ #j.
                 (PDAddPlainCookie( d, b, p ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) ∨
               (∃ name. (p = <name, uninit>)))) ∧
            (∀ cid browser domain name content rest #i.
              (PlainCookiesLoop( cid, browser, domain, (rest++<name, content>)
               ) @ #i)
             ⇒
              ((last(#i)) ∨
               (∃ #j. (!KU( <name, content> ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) ∨
               (content = uninit) ∨
               (∃ #j.
                 (PDAddPlainCookie( domain, browser, <name, content> ) @ #j)
                ∧
                 (¬(last(#j))) ∧ (#j < #i)))) ∧
            (∀ cid browser domain cookie #i.
              (PlainCookiesAddSingle( cid, browser, domain, cookie ) @ #i)
             ⇒
              ((last(#i)) ∨
               (∃ setcookiessec #j.
                 (ReceivePlainCookies( browser, domain, setcookiessec ) @ #j)
                ∧
                 (¬(last(#j))) ∧
                 (#j < #i) ∧
                 (∃ rest. (setcookiessec = (cookie++rest)))) ∨
               (∃ name. (cookie = <name, uninit>)))) ∧
            (∀ processid browser domain cookies #i.
              (IncomingPlainLoop( processid, browser, domain, cookies ) @ #i)
             ⇒
              ((last(#i)) ∨
               (∃ super rest #j.
                 (ReceivePlainCookies( browser, domain, super ) @ #j) ∧
                 (super = (cookies++rest))
                ∧
                 ¬(last(#j))) ∨
               (∃ #j.
                 (ReceivePlainCookies( browser, domain, cookies ) @ #j)
                ∧
                 ¬(last(#j))))))  ∥
           (∃ cookie #i.
             (Uninit( cookie ) @ #i)
            ∧
             (¬(last(#i))) ∧
             (¬(cookie = NoCookies)) ∧
             (∀ a b.
               (cookie = (a++b))
              ⇒
               ∃ rest singleton.
                (cookie = (rest++singleton))
               ∧
                ∀ name. (singleton = <name, uninit>) ⇒ ⊥)) )
      case case_1
      solve( (last(#i))  ∥
             (∃ #j. (!KU( p ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i))  ∥
