lemma redir_loops [reuse]:
  all-traces
  "∀ browser dom inmsgnonce redirnonce status outmsgnonce body #j.
    (Continue_Redir( browser, dom, inmsgnonce, redirnonce, status,
                     outmsgnonce, body
     ) @ #j) ⇒
    ((∃ otherdom secondinmsgnonce otherstatus otherbody #k.
       Continue_Redir( browser, otherdom, secondinmsgnonce, redirnonce,
                       otherstatus, inmsgnonce, otherbody
       ) @ #k) ∨
     (∃ method reqbody reqdom #k.
       Fresh_Redirnonce( browser, redirnonce, reqbody, reqdom, method,
                         inmsgnonce
       ) @ #k))"
/*
guarded formula characterizing all counter-examples:
"∃ browser dom inmsgnonce redirnonce status outmsgnonce body #j.
  (Continue_Redir( browser, dom, inmsgnonce, redirnonce, status,
                   outmsgnonce, body
   ) @ #j)
 ∧
  (∀ otherdom secondinmsgnonce otherstatus otherbody #k.
    (Continue_Redir( browser, otherdom, secondinmsgnonce, redirnonce,
                     otherstatus, inmsgnonce, otherbody
     ) @ #k)
   ⇒
    ⊥) ∧
  (∀ method reqbody reqdom #k.
    (Fresh_Redirnonce( browser, redirnonce, reqbody, reqdom, method,
                       inmsgnonce
     ) @ #k)
   ⇒
    ⊥)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ browser dom inmsgnonce redirnonce status outmsgnonce body
            #j.
           (Continue_Redir( browser, dom, inmsgnonce, redirnonce, status,
                            outmsgnonce, body
            ) @ #j)
          ⇒
           ((last(#j)) ∨
            (∃ otherdom secondinmsgnonce otherstatus otherbody #k.
              (Continue_Redir( browser, otherdom, secondinmsgnonce, redirnonce,
                               otherstatus, inmsgnonce, otherbody
               ) @ #k)
             ∧
              ¬(last(#k))) ∨
            (∃ method reqbody reqdom #k.
              (Fresh_Redirnonce( browser, redirnonce, reqbody, reqdom, method,
                                 inmsgnonce
               ) @ #k)
             ∧
              ¬(last(#k)))))  ∥
         (∃ cookie #i.
           (Uninit( cookie ) @ #i)
          ∧
           (¬(last(#i))) ∧
           (¬(cookie = NoCookies)) ∧
           (∀ a b.
             (cookie = (a++b))
            ⇒
             ∃ rest singleton.
              (cookie = (rest++singleton))
             ∧
              ∀ name. (singleton = <name, uninit>) ⇒ ⊥)) )
    case case_1
    solve( (last(#j))  ∥
           (∃ otherdom secondinmsgnonce otherstatus otherbody #k.
             (Continue_Redir( $Browser, otherdom, secondinmsgnonce, ~redirnonce,
                              otherstatus, ~nonce, otherbody
              ) @ #k)
            ∧
             ¬(last(#k)))  ∥
           (∃ method reqbody reqdom #k.
             (Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom, method,
                                ~nonce
              ) @ #k)
            ∧
             ¬(last(#k))) )
      case case_1
      solve( ProcessRedirectFinish( ~processid, $Browser, ~nonce,
                                    $status, finalorigin, $method, body, refpolicy, $respScheme,
                                    $respDomain, resppath, respparams, finalfragment, referrer,
                                    ~redirnonce
             ) ▶₀ #j )
        case ProcessRedirect303BadMethod_case_1
        solve( Browser_Out( $Browser, $TLW, $requestDomain, $requestScheme,
                            'REQ', finalfragment, ~nonce, $method, $path, params, plaincookies,
                            seccookies, finalorigin, referrer, auth, body, adv, ~redirnonce
               )[no_precomp] ▶₀ #vr.4 )
          case BrowserSendPlain_case_01
          by contradiction /* from formulas */
        next
          case BrowserSendPlain_case_02
          by contradiction /* from formulas */
