lemma agreementCSRF:
  all-traces
  "∀ server browser path #i.
    (((Commit( server, browser, path ) @ #i) ∧
      (¬(∃ #r. CompromiseDomain( server ) @ #r))) ∧
     (¬(∃ #r. CompromiseBrowser( browser ) @ #r))) ⇒
    (∃ #j. (Run( browser, server, path ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ server browser path #i.
