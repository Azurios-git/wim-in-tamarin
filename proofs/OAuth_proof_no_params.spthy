               (∃ #k. (PDAddBody( body ) @ #k) ∧ (¬(last(#k))) ∧ (#k < #vr.7))  ∥
               (body = NoBody)  ∥
               (∃ #j. (!KU( body ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.7)) )
