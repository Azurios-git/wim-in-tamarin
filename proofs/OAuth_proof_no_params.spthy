lemma redir_loops_beginning [reuse, use_induction]:
  all-traces
  "∀ browser dom inmsgnonce redirnonce status outmsgnonce body #j.
    (Continue_Redir( browser, dom, inmsgnonce, redirnonce, status,
                     outmsgnonce, body
     ) @ #j) ⇒
    ((∃ method reqbody reqdom otherdom secondinmsgnonce thirdinmsgnonce
        otherstatus otherbody #k #l.
       (Fresh_Redirnonce( browser, redirnonce, reqbody, reqdom, method,
                          secondinmsgnonce
        ) @ #l) ∧
       (Continue_Redir( browser, otherdom, secondinmsgnonce, redirnonce,
                        otherstatus, thirdinmsgnonce, otherbody
        ) @ #k)) ∨
     (∃ method reqbody reqdom #k.
       Fresh_Redirnonce( browser, redirnonce, reqbody, reqdom, method,
                         inmsgnonce
       ) @ #k))"
/*
guarded formula characterizing all counter-examples:
"∃ browser dom inmsgnonce redirnonce status outmsgnonce body #j.
  (Continue_Redir( browser, dom, inmsgnonce, redirnonce, status,
                   outmsgnonce, body
   ) @ #j)
 ∧
  (∀ method reqbody reqdom otherdom secondinmsgnonce thirdinmsgnonce
     otherstatus otherbody #k #l.
    (Fresh_Redirnonce( browser, redirnonce, reqbody, reqdom, method,
                       secondinmsgnonce
     ) @ #l) ∧
    (Continue_Redir( browser, otherdom, secondinmsgnonce, redirnonce,
                     otherstatus, thirdinmsgnonce, otherbody
     ) @ #k)
   ⇒
    ⊥) ∧
  (∀ method reqbody reqdom #k.
    (Fresh_Redirnonce( browser, redirnonce, reqbody, reqdom, method,
                       inmsgnonce
     ) @ #k)
   ⇒
    ⊥)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ browser dom inmsgnonce redirnonce status outmsgnonce body
            #j.
           (Continue_Redir( browser, dom, inmsgnonce, redirnonce, status,
                            outmsgnonce, body
            ) @ #j)
          ⇒
           ((last(#j)) ∨
            (∃ method reqbody reqdom otherdom secondinmsgnonce thirdinmsgnonce
               otherstatus otherbody #k #l.
              (Fresh_Redirnonce( browser, redirnonce, reqbody, reqdom, method,
                                 secondinmsgnonce
               ) @ #l) ∧
              (Continue_Redir( browser, otherdom, secondinmsgnonce, redirnonce,
                               otherstatus, thirdinmsgnonce, otherbody
               ) @ #k)
             ∧
              (¬(last(#l))) ∧ (¬(last(#k)))) ∨
            (∃ method reqbody reqdom #k.
              (Fresh_Redirnonce( browser, redirnonce, reqbody, reqdom, method,
                                 inmsgnonce
               ) @ #k)
             ∧
              ¬(last(#k)))))  ∥
         (∃ cookie #i.
           (Uninit( cookie ) @ #i)
          ∧
           (¬(last(#i))) ∧
           (¬(cookie = NoCookies)) ∧
           (∀ a b.
             (cookie = (a++b))
            ⇒
             ∃ rest singleton.
              (cookie = (rest++singleton))
             ∧
              ∀ name. (singleton = <name, uninit>) ⇒ ⊥)) )
    case case_1
    solve( (last(#j))  ∥
           (∃ method reqbody reqdom otherdom secondinmsgnonce thirdinmsgnonce
              otherstatus otherbody #k #l.
             (Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom, method,
                                secondinmsgnonce
              ) @ #l) ∧
             (Continue_Redir( $Browser, otherdom, secondinmsgnonce, ~redirnonce,
                              otherstatus, thirdinmsgnonce, otherbody
              ) @ #k)
            ∧
             (¬(last(#l))) ∧ (¬(last(#k))))  ∥
           (∃ method reqbody reqdom #k.
             (Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom, method,
                                ~nonce
              ) @ #k)
            ∧
             ¬(last(#k))) )
      case case_1
      solve( (∃ otherdom secondinmsgnonce otherstatus otherbody #k.
               (Continue_Redir( $Browser, otherdom, secondinmsgnonce, ~redirnonce,
                                otherstatus, ~nonce, otherbody
                ) @ #k))  ∥
             (∃ method reqbody reqdom #k.
               (Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom, method,
                                  ~nonce
                ) @ #k)) )
        case case_1
        solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody.1,
                                 otherdom, scheme, msgnonce.1
               ) @ #j.1 )
          case AdversaryRunScriptFormGet
          solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody.1,
                                   otherdom, scheme, msgnonce.2
                 ) @ #j.1 )
            case AdversaryRunScriptFormGet
            solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody.1,
                                     otherdom, scheme, msgnonce.2
                   ) @ #j.1 )
              case AdversaryRunScriptFormGet
              solve( (∃ method reqbody reqdom otherdom secondinmsgnonce
                        thirdinmsgnonce otherstatus otherbody #k #l.
                       (Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom, method,
                                          secondinmsgnonce
                        ) @ #l) ∧
                       (Continue_Redir( $Browser, otherdom, secondinmsgnonce, ~redirnonce,
                                        otherstatus, thirdinmsgnonce, otherbody
                        ) @ #k)
                      ∧
                       (¬(last(#l))) ∧ (¬(last(#k))))  ∥
                     (∃ method reqbody reqdom #k.
                       (Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom, method,
                                          ~nonce.1
                        ) @ #k)
                      ∧
                       ¬(last(#k))) )
                case case_1
                by contradiction /* from formulas */
              next
                case case_2
                by contradiction /* from formulas */
              qed
            qed
          qed
        next
          case AdversaryRunScriptFormPost
          solve( (∃ method reqbody reqdom otherdom secondinmsgnonce
                    thirdinmsgnonce otherstatus otherbody #k #l.
                   (Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom, method,
                                      secondinmsgnonce
                    ) @ #l) ∧
                   (Continue_Redir( $Browser, otherdom, secondinmsgnonce, ~redirnonce,
                                    otherstatus, thirdinmsgnonce, otherbody
                    ) @ #k)
                  ∧
                   (¬(last(#l))) ∧ (¬(last(#k))))  ∥
                 (∃ method reqbody reqdom #k.
                   (Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom, method,
                                      ~nonce.1
                    ) @ #k)
                  ∧
                   ¬(last(#k))) )
            case case_1
            by contradiction /* from formulas */
          next
            case case_2
            by contradiction /* from formulas */
          qed
        next
          case AdversaryRunScriptHrefIframe
          solve( (∃ method reqbody reqdom otherdom secondinmsgnonce
                    thirdinmsgnonce otherstatus otherbody #k #l.
                   (Fresh_Redirnonce( $Browser, ~redirnonce, reqbody, reqdom, method,
