                         $Domain, $Path, parameters, fragment, $method, auth, origin,
                         referrer, referrerpolicy, body
   ),
   Fr( ~redirnonce ), Fr( ~msgnonce )
   ]
  --[
  Fresh_Redirnonce( $Browser, ~redirnonce, body, $Domain, $scheme,
                    ~msgnonce
  )
  ]->
   [
   Browser_Send_HTTP( $Browser, wid_or_did, $type, $scheme, $Domain,
                      $Path, parameters, fragment, $method, auth, origin, referrer,
                      referrerpolicy, body, 'honest', ~redirnonce, ~msgnonce
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) ServerCreateRequestUser:
   [
   Send_Request( $Browser, $Domain, $Scheme, ~nonce, $method, $path,
                 parameters, plaincookies, seccookies, origin, referrer, auth, body
   ),
   Fr( ~redirnonce )
   ]
  --[
  Fresh_Redirnonce( $Browser, ~redirnonce, body, $Domain, $Scheme,
                    ~nonce
  )
  ]->
   [
   Browser_Out( $Browser, $RandomTLW, $Domain, $Scheme, $type,
                $fragment, ~nonce, $method, $path, parameters, plaincookies,
                seccookies, origin, referrer, auth, body, 'honest', ~redirnonce
   )
