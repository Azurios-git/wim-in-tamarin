lemma single_iter_body [reuse]:
  all-traces
  "∀ browser redirnonce dom otherbody otherdom msgnonce
     secondmsgnonce thirdmessagenonce body status otherstatus #j #k.
    ((Continue_Redir( browser, dom, msgnonce, redirnonce, status,
                      secondmsgnonce, body
      ) @ #j) ∧
     (Continue_Redir( browser, otherdom, secondmsgnonce, redirnonce,
                      otherstatus, thirdmessagenonce, otherbody
      ) @ #k)) ⇒
    ((otherbody = body) ∨ (otherbody = NoBody))"
/*
guarded formula characterizing all counter-examples:
"∃ browser redirnonce dom otherbody otherdom msgnonce
   secondmsgnonce thirdmessagenonce body status otherstatus #j #k.
  (Continue_Redir( browser, dom, msgnonce, redirnonce, status,
                   secondmsgnonce, body
   ) @ #j) ∧
  (Continue_Redir( browser, otherdom, secondmsgnonce, redirnonce,
                   otherstatus, thirdmessagenonce, otherbody
   ) @ #k)
 ∧
  (¬(otherbody = body)) ∧ (¬(otherbody = NoBody))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ browser redirnonce dom otherbody otherdom msgnonce
            secondmsgnonce thirdmessagenonce body status otherstatus #j #k.
