lemma sourceRefLeak [sources]:
  all-traces
  "∀ Ref #i.
    (PDLeakRef( Ref ) @ #i) ⇒
    (((∃ #j. (!KU( Ref ) @ #j) ∧ (#j < #i)) ∨
      (∃ scheme dom path params fragment.
        (Ref = <scheme, dom, path, params, fragment>) ∧
        (((∃ #j. (PDAddParams( params ) @ #j) ∧ (#j < #i)) ∨
          (∃ #j. (!KU( params ) @ #j) ∧ (#j < #i))) ∨
         (params = NoParams)))) ∨
     (Ref = NoReferrer))"
/*
guarded formula characterizing all counter-examples:
"∃ Ref #i.
  (PDLeakRef( Ref ) @ #i)
 ∧
  (∀ #j. (!KU( Ref ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ scheme dom path params fragment.
