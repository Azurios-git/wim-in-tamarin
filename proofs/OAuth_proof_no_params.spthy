lemma executability:
  exists-trace
  "∃ #i.
    ((Done( ) @ #i) ∧ (¬(∃ #j. AdvActive( ) @ #j))) ∧
    (∀ browser b2 domain d2 nonce n2 s1 s2 #i.1 #j.
      ((RedirFrom( browser, domain, s1, nonce ) @ #i.1) ∧
       (RedirFrom( b2, d2, s2, n2 ) @ #j)) ⇒
      (#i.1 = #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ #i.
  (Done( ) @ #i)
 ∧
  (∀ #j. (AdvActive( ) @ #j) ⇒ ⊥) ∧
  (∀ browser b2 domain d2 nonce n2 s1 s2 #i.1 #j.
    (RedirFrom( browser, domain, s1, nonce ) @ #i.1) ∧
    (RedirFrom( b2, d2, s2, n2 ) @ #j)
   ⇒
    #i.1 = #j)"
*/
by sorry

lemma exec307Attack:
  exists-trace
  "(((∃ credentials browser authdom #i #j.
       ((K( credentials ) @ #i) ∧
        (Credentials( browser, authdom, credentials ) @ #j)) ∧
       (¬(∃ #k. CompromiseDomain( authdom ) @ #k))) ∧
     (∀ browser domain scheme #i.
       (Send_Out( browser, domain, scheme ) @ #i) ⇒ (scheme = 'https'))) ∧
    (¬(∃ #i browser. CompromiseBrowser( browser ) @ #i))) ∧
   (∀ #i #j b d.
     ((CreateBrowser( b ) @ #i) ∧ (CreateBrowser( d ) @ #j)) ⇒
     ((b = d) ∧
      (∀ browser b2 domain d2 nonce n2 s1 s2 #i.1 #j.1.
        ((RedirFrom( browser, domain, s1, nonce ) @ #i.1) ∧
         (RedirFrom( b2, d2, s2, n2 ) @ #j.1)) ⇒
        (#i.1 = #j.1))))"
/*
guarded formula characterizing all satisfying traces:
"(∃ credentials browser authdom #i #j.
   (K( credentials ) @ #i) ∧
   (Credentials( browser, authdom, credentials ) @ #j)
  ∧
   ∀ #k. (CompromiseDomain( authdom ) @ #k) ⇒ ⊥) ∧
 (∀ browser domain scheme #i.
   (Send_Out( browser, domain, scheme ) @ #i) ⇒ scheme = 'https') ∧
 (∀ #i browser. (CompromiseBrowser( browser ) @ #i) ⇒ ⊥) ∧
 (∀ #i #j b d.
   (CreateBrowser( b ) @ #i) ∧ (CreateBrowser( d ) @ #j)
  ⇒
   (b = d) ∧
   (∀ browser b2 domain d2 nonce n2 s1 s2 #i.1 #j.1.
     (RedirFrom( browser, domain, s1, nonce ) @ #i.1) ∧
     (RedirFrom( b2, d2, s2, n2 ) @ #j.1)
    ⇒
     #i.1 = #j.1))"
*/
by sorry

lemma secrecyOfCredentials:
  all-traces
  "∀ login authdomain browser #i #j.
    ((Credentials( browser, authdomain, login ) @ #i) ∧
     (K( login ) @ #j)) ⇒
    ((∃ #k. CompromiseDomain( authdomain ) @ #k) ∨
     (∃ #k. CompromiseBrowser( browser ) @ #k))"
/*
guarded formula characterizing all counter-examples:
"∃ login authdomain browser #i #j.
  (Credentials( browser, authdomain, login ) @ #i) ∧
  (K( login ) @ #j)
 ∧
  (∀ #k. (CompromiseDomain( authdomain ) @ #k) ⇒ ⊥) ∧
  (∀ #k. (CompromiseBrowser( browser ) @ #k) ⇒ ⊥)"
*/
simplify
solve( !ClaimDomain( $Domain, 'AuthServer' ) ▶₀ #i )
  case ClaimDomain
  solve( !Browser( ~bid, $Browser ) ▶₁ #i )
    case CreateBrowser
    solve( !KU( ~login ) @ #vk )
      case CompromisedServerReceiveParamAuthBody_case_1
      solve( Fresh_Redirnonce( $Browser.1, ~redirnonce,
                               <~login, $ClientDomain, 'ScopeOfRequest'>, otherdom, scheme,
                               msgnonce.1
             ) @ #j.1 )
        case AdversaryRunScriptFormPost
        by contradiction /* cyclic */
      next
        case AdversaryRunScriptXHROther
        by contradiction /* cyclic */
      next
        case BrowserOutUser
        solve( Send_Request_Browser( $Browser.1, wid_or_did, $type,
                                     $scheme, $Domain.1, $Path, parameters, fragment.1, $method,
                                     auth, origin, referrer, referrerpolicy,
                                     <~login, $ClientDomain, 'ScopeOfRequest'>
               ) ▶₀ #j.1 )
          case InitiateAuth_case_1
          solve( (Send_Request_Nonce( ~msgnonce ) @ #vr.5)  ∥
                 (∃ status secondmsgnonce redirbody thirddom #l.
                   (Continue_Redir( $Browser, thirddom, ~msgnonce, ~redirnonce,
                                    status, secondmsgnonce, redirbody
                    ) @ #l)
                  ∧
                   (((status = '303') ∨ (status = '307'))) ∧ (#l < #vr.5)) )
            case case_1
            solve( Browser_Out( $Browser, window_or_doc_reference, $Domain.1,
                                $Scheme.2, $type, fragment.1, ~msgnonce, $method, $path.1,
                                parameters, plaincookies, seccookies, origin, referrer, NoAuth,
                                <~login, $ClientDomain, 'ScopeOfRequest'>, 'honest', ~redirnonce
                   )[no_precomp] ▶₀ #vr.5 )
              case BrowserSendSec
              by contradiction /* from formulas */
            qed
          next
            case case_2
            solve( ProcessRedirectFinish( ~processid.2, $Browser, ~msgnonce,
                                          $status.2, finalorigin, $method.3, redirbody, refpolicy.2,
                                          $respScheme, $respDomain, resppath, respparams,
                                          finalfragment, referrer.1, ~redirnonce
                   ) ▶₀ #l )
              case ProcessRedirect303BadMethod_case_1
              solve( Browser_Out( $Browser, window_or_doc_reference, $Domain.1,
                                  $Scheme.2, $type, fragment.1, ~nonce, $method, $path.1,
                                  parameters, plaincookies, seccookies, origin, referrer.1, NoAuth,
                                  <~login, $ClientDomain, 'ScopeOfRequest'>, 'honest', ~redirnonce
                     )[no_precomp] ▶₀ #vr.5 )
                case BrowserSendPlain_case_1
                by contradiction /* from formulas */
