        by contradiction /* from formulas */
      next
        case BrowserSendSec_case_13
        by contradiction /* from formulas */
      next
        case BrowserSendSec_case_14
        by contradiction /* from formulas */
      next
        case BrowserSendSec_case_15
        by contradiction /* from formulas */
      next
        case BrowserSendSec_case_16
        by contradiction /* from formulas */
      next
        case BrowserSendSec_case_17
        by contradiction /* from formulas */
      next
        case BrowserSendSec_case_18
        by contradiction /* from formulas */
      next
        case BrowserSendSec_case_19
        by contradiction /* from formulas */
      next
        case BrowserSendSec_case_20
        by contradiction /* from formulas */
      next
        case CompromisedBrowserSend
        by contradiction /* from formulas */
      qed
    next
      case case_2
      by contradiction /* from formulas */
    next
      case case_3
      by contradiction /* from formulas */
    next
      case case_4
      by contradiction /* from formulas */
    qed
  next
    case case_2
    solve( (cookie = NoCookies)  ∥
           (∃ a b.
             (cookie = (a++b))
            ∧
             ∀ rest singleton.
              (cookie = (rest++singleton))
             ⇒
              ∃ name. (singleton = <name, uninit>)) )
      case case_1
      by contradiction /* from formulas */
    next
      case case_2_case_1
      by contradiction /* from formulas */
    next
      case case_2_case_2
      by contradiction /* from formulas */
    qed
  qed
qed

lemma sourceParamsLeak [sources]:
  all-traces
  "∀ params #i.
    (PDLeakParams( params ) @ #i) ⇒
    (((params = NoParams) ∨ (∃ #j. (!KU( params ) @ #j) ∧ (#j < #i))) ∨
     (∃ #k. (PDAddParams( params ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ params #i.
  (PDLeakParams( params ) @ #i)
 ∧
  (¬(params = NoParams)) ∧
  (∀ #j. (!KU( params ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #k. (PDAddParams( params ) @ #k) ⇒ ¬(#k < #i))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ params #i.
           (PDLeakParams( params ) @ #i)
          ⇒
           ((last(#i)) ∨
            (params = NoParams) ∨
            (∃ #j. (!KU( params ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) ∨
            (∃ #k.
              (PDAddParams( params ) @ #k) ∧ (¬(last(#k))) ∧ (#k < #i))))  ∥
         (∃ cookie #i.
           (Uninit( cookie ) @ #i)
          ∧
           (¬(last(#i))) ∧
           (¬(cookie = NoCookies)) ∧
           (∀ a b.
             (cookie = (a++b))
            ⇒
             ∃ rest singleton.
              (cookie = (rest++singleton))
             ∧
              ∀ name. (singleton = <name, uninit>) ⇒ ⊥)) )
    case case_1
    solve( (last(#i))  ∥ (params = NoParams)  ∥
           (∃ #j. (!KU( params ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i))  ∥
           (∃ #k. (PDAddParams( params ) @ #k) ∧ (¬(last(#k))) ∧ (#k < #i)) )
      case case_1
      solve( Browser_Out( $Browser, window_or_doc_reference, $Domain,
                          $Scheme, $type, fragment, ~nonce, $method, $path, params,
                          plaincookies, seccookies, origin, referrer, auth, body, adv,
                          ~redirnonce
             )[no_precomp] ▶₀ #i )
        case BrowserSendPlain_case_01
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_02
        solve( (params.1 = NoParams)  ∥
               (∃ #j. (!KU( params.1 ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.7))  ∥
               (∃ #k.
                 (PDAddParams( params.1 ) @ #k) ∧ (¬(last(#k))) ∧ (#k < #vr.7)) )
          case case_1
          solve( ProcessingDocument( ~processid, $Browser, $requestScheme,
                                     ~nonce.1, '303', body.1,
                                     <'http', $Domain, $path, params, 'bot'>, STS, referrerpolicy,
                                     body.1
                 ) ▶₀ #vr.6 )
            case ProcessResponse_case_001
            by contradiction /* from formulas */
          next
            case ProcessResponse_case_002
            by contradiction /* from formulas */
          next
            case ProcessResponse_case_003
            by contradiction /* from formulas */
