               setcookiesplain, setcookiessec, location, sts, refpolicy, body
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) ServerOutUser:
   [
   Send_Reply( $Domain, $Browser, $Scheme, ~nonce, $status,
               setcookiesplain, setcookiessec, location, sts, refpolicy, body
   )
   ]
  -->
   [
   Server_Out( $Domain, $Browser, $Scheme, ~nonce, $status,
               setcookiesplain, setcookiessec, location, sts, refpolicy, body,
               'honest'
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) ServerInUser:
   [
   Server_In( $Browser, $Domain, $Scheme, ~nonce, $method, $path,
              parameters, plaincookies, seccookies, origin, referrer, auth, body,
              adv
   )
   ]
  --[ RR( ) ]->
   [
   Receive_Request( $Browser, $Domain, $Scheme, ~nonce, $method,
                    $path, parameters, (plaincookies++seccookies), origin, referrer,
                    auth, body
   )
   ]

