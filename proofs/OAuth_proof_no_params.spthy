theory OAuth begin

// Function signature and definition of the equational theory E

builtins: multiset
functions: Container/1, NoAuth/0, NoBody/0, NoCookies/0,
           NoLocation/0, NoOrigin/0, NoParams/0, NoRefPolicy/0, NoReferrer/0,
           NoSTS/0, fst/1, pair/2, snd/1, uninit/0
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2





/*
looping facts with injective instances:
  Browser_State/3, CookiesPlain/4, CookiesSec/4, Document/8,
  IncomingPlain/4, IncomingSec/4, LocalStorage/5, SessionStorage/6
*/



rule (modulo E) HTTPRevealRequestParamAuthBody:
   [
   !Request( $Browser, $Domain, 'http', ~nonce, method, $path,
             parameters, plaincookies, seccookies, origin, referrer, auth, body,
             'honest'
   )[no_precomp]
   ]
  --[ PDLeakBody( body ) ]->
   [ Out( <auth, body> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) HTTPRevealRequestParam:
   [
   !Request( $Browser, $Domain, 'http', ~nonce, method, $path,
             (parameters++<$name, ~content>), plaincookies, seccookies, origin,
             referrer, auth, body, 'honest'
   )[no_precomp]
   ]
  -->
   [ Out( ~content ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) HTTPRevealRequestPlainCookie:
   [
   !Request( $Browser, $Domain, 'http', ~nonce, method, $path,
             parameters, (plaincookies++<$name, content>), seccookies, origin,
             referrer, auth, body, 'honest'
   )
   ]
  --[
  PDPlainLeak( $Browser, $Domain, <$name, content> ), AdvPassive( ),
  NoLeakingUninit( content )
  ]->
   [ Out( content ) ]

  /* has exactly the trivial AC variant */

restriction NoUninit:
  "∀ #i. (NoLeakingUninit( uninit ) @ #i) ⇒ (⊥)"
  // safety formula

lemma NoSecCookiesOverPlainHTTP:
  all-traces
  "∀ seccookies scheme #i.
    (SendSecCookies( seccookies, scheme ) @ #i) ⇒
    ((scheme = 'https') ∨
     ((seccookies = NoCookies) ∨
      (∃ #j. (!KU( seccookies ) @ #j) ∧ (#j < #i))))"
/*
guarded formula characterizing all counter-examples:
"∃ seccookies scheme #i.
  (SendSecCookies( seccookies, scheme ) @ #i)
 ∧
  (¬(scheme = 'https')) ∧
  (¬(seccookies = NoCookies)) ∧
  (∀ #j. (!KU( seccookies ) @ #j) ⇒ ¬(#j < #i))"
*/
simplify
solve( Browser_Out( $Browser, window_or_doc_reference, $Domain,
                    $Scheme, $type, fragment, ~nonce, $method, $path, parameters,
                    plaincookies, seccookies, origin, referrer, auth, body, adv,
                    ~redirnonce
       )[no_precomp] ▶₀ #i )
  case BrowserSendPlain_case_01
  by contradiction /* from formulas */
next
  case BrowserSendPlain_case_02
  by contradiction /* from formulas */
next
  case BrowserSendPlain_case_03
  by contradiction /* from formulas */
next
  case BrowserSendPlain_case_04
  by contradiction /* from formulas */
next
  case BrowserSendPlain_case_05
  by contradiction /* from formulas */
next
  case BrowserSendPlain_case_06
  by contradiction /* from formulas */
next
  case BrowserSendPlain_case_07
  by contradiction /* from formulas */
next
  case BrowserSendPlain_case_08
  by contradiction /* from formulas */
next
  case BrowserSendPlain_case_09
  by contradiction /* from formulas */
next
  case BrowserSendPlain_case_10
  by contradiction /* from formulas */
next
  case BrowserSendPlain_case_11
  by contradiction /* from formulas */
next
  case BrowserSendPlain_case_12
  by contradiction /* from formulas */
next
  case BrowserSendPlain_case_13
  by contradiction /* from formulas */
next
  case BrowserSendPlain_case_14
  by contradiction /* from formulas */
next
  case BrowserSendPlain_case_15
  by contradiction /* from formulas */
next
  case BrowserSendPlain_case_16
  by contradiction /* from formulas */
next
  case BrowserSendPlain_case_17
  by contradiction /* from formulas */
next
  case BrowserSendPlain_case_18
  by contradiction /* from formulas */
next
  case BrowserSendSec_case_01
  by contradiction /* from formulas */
next
  case BrowserSendSec_case_02
  by contradiction /* from formulas */
next
