// This rule allows an adversary-controller browser to generate new requests
// note that this rule uses Browser_Out instead of Browser_Send_HTTP to allow adversarial cookie control
rule CompromisedBrowserSend:
    let headers = <Origin, Referer, Auth>
        messageparameters = <window_or_doc_reference, fragment, parameters, plaincookies, seccookies, headers, body> in
    [ !CompromisedBrowser($Browser)
    , In(messageparameters)
    , Fr(~msgnonce)
    , Fr(~redirnonce)]
    --[AdvActive(), Fresh_Redirnonce($Browser, ~redirnonce, body, $Domain, $Scheme, ~msgnonce)]->
    [Browser_Out($Browser, window_or_doc_reference, $Domain, $Scheme, $type, fragment, ~msgnonce, $method, $path, parameters, plaincookies, seccookies, Origin,  Referer, Auth, body, 'adversary', ~redirnonce)]

// Adversary script
// Once an adversary script is loaded, the state of its origin can be leaked and modified
// And scriptactions can now be performed
rule AdversaryScript:
   let docURL = <$Scheme, $DocDomain, $path, params, fragment> in
   [ Document(~did, $Browser, $TLW, docURL, referer, refpolicy, 'Adversaryscript', scriptstate) ]
   --[AdvActive()]->
   [ !LeakState($Browser, $DocDomain, $Scheme, $TLW)
   , !ModifyState($Browser, $DocDomain, $Scheme, $TLW)
   , !AdvScript($Browser, ~did, docURL, refpolicy) ]

// TODO: AdvScript Cookie Manipulation

rule AdversaryRunScriptFormPost:
   let docURL = <$DocScheme, $DocDomain, $docpath, params, docfragment>
   strippedURL = <$DocScheme, $DocDomain, $docpath, params, 'bot'>
   docOrigin = <$DocDomain, $DocScheme> in
   [ !AdvScript($Browser, ~did, docURL, refpolicy)
   , In(<data, parameters, fragment>)
    , Fr(~redirnonce)
    , Fr(~msgnonce)]
   --[AdvActive(), Fresh_Redirnonce($Browser, ~redirnonce, data, $Domain, $Scheme, ~msgnonce)]->
   [ Browser_Send_HTTP($Browser, $TLW, 'REQ', $Scheme, $Domain, $Path, parameters, fragment, 'POST', NoAuth(), docOrigin, strippedURL, refpolicy,  data, 'honest', ~redirnonce, ~msgnonce) ]

#ifdef Advscript
// HREF and Iframe are similar enough to use one shared rule
rule AdversaryRunScriptHrefIframe:
   let docURL = <$DocScheme, $DocDomain, $docpath, params, docfragment>
   strippedURL = <$DocScheme, $DocDomain, $docpath, params, 'bot'>
   docOrigin = <$DocDomain, $DocScheme> in
   [ !AdvScript($Browser, ~did, docURL, refpolicy)
   , In(<parameters, fragment>)
   , Fr(~redirnonce)
   , Fr(~msgnonce)]
   --[AdvActive(), _restrict($Newrefpolicy = refpolicy | $Newrefpolicy = 'noreferrer'), Fresh_Redirnonce($Browser, ~redirnonce, NoBody(), $Domain, $Scheme, ~msgnonce)]->
   [ Browser_Send_HTTP($Browser, $TLW, 'REQ', $Scheme, $Domain, $Path, parameters, fragment, 'GET', NoAuth(), NoOrigin(), strippedURL, $Newrefpolicy, NoBody(), 'honest', ~redirnonce, ~msgnonce) ]

rule AdversaryRunScriptFormGet:
   let docURL = <$DocScheme, $DocDomain, $docpath, params, docfragment>
   strippedURL = <$DocScheme, $DocDomain, $docpath, params, 'bot'>
   docOrigin = <$DocDomain, $DocScheme> in
   [ !AdvScript($Browser, ~did, docURL, refpolicy)
   , In(<parameters, fragment>)
   , Fr(~redirnonce)
   , Fr(~msgnonce)]
   --[AdvActive(), Fresh_Redirnonce($Browser, ~redirnonce, NoBody(), $Domain, $Scheme, ~msgnonce)]->
   [ Browser_Send_HTTP($Browser, $TLW, 'REQ', $Scheme, $Domain, $Path, parameters, fragment, 'GET', NoAuth(), NoOrigin(), strippedURL, refpolicy, NoBody(), 'honest', ~redirnonce, ~msgnonce) ]

rule AdversaryRunScriptXHRGetHead:
    let docURL = <$DocScheme, $DocDomain, $docpath, params, docfragment>
    strippedURL = <$DocScheme, $DocDomain, $docpath, params, 'bot'>
    docOrigin = <$DocDomain, $DocScheme> in
    [ !AdvScript($Browser, ~did, docURL, refpolicy)
    , Fr(~refid)
    , In(<data, parameters, fragment>)
   , Fr(~redirnonce)
   , Fr(~msgnonce)]
    --[AdvActive(), Eq($Domain, $DocDomain), Eq($DocScheme, $Scheme), _restrict($method = 'GET' | $method = 'HEAD'), Fresh_Redirnonce($Browser, ~redirnonce, NoBody(), $Domain, $Scheme, ~msgnonce)]->
    [ Browser_Send_HTTP($Browser, <~did, ~refid>, 'XHR', $Scheme, $Domain, $Path, parameters, fragment, $method, NoAuth(), NoOrigin(), strippedURL, refpolicy, NoBody(), 'honest', ~redirnonce, ~msgnonce) ]

rule AdversaryRunScriptXHROther:
    let docURL = <$DocScheme, $DocDomain, $docpath, params, docfragment>
    strippedURL = <$DocScheme, $DocDomain, $docpath, params, 'bot'>
    docOrigin = <$DocDomain, $DocScheme> in
    [ !AdvScript($Browser, ~did, docURL, refpolicy)
    , Fr(~refid)
    , In(<data, parameters, fragment>)
   , Fr(~redirnonce)
   , Fr(~msgnonce)]
    --[AdvActive(),_restrict(not($method = 'GET' | $method = 'HEAD' | $method = 'TRACE' | $method = 'CONNECT' | $method = 'TRACK')), Fresh_Redirnonce($Browser, ~redirnonce, data, $Domain, $Scheme, ~msgnonce)]->
    [ Browser_Send_HTTP($Browser, <~did, ~refid>, 'XHR', $Scheme, $Domain, $Path, parameters, fragment, $method, NoAuth(), docOrigin, strippedURL, refpolicy, data, 'honest', ~redirnonce, ~msgnonce) ]

// Note: This rule loops the other documentfact which makes proofs somewhat complicated and is the reason for the DocLoop-AF
// Unsure if there's a smarter way of doing this, replacing the loop with a persistent fact like !Doc(~did, ~bid) destroys performance for some reason
rule AdversaryRunScriptPostMsg:
    let docURL = <$DocScheme, $DocDomain, $docpath, params, docfragment>
    otherURL = <$OtherScheme, $OtherDomain, $otherdocpath, otherparams, otherdocfragment>
    strippedURL = <$DocScheme, $DocDomain, $docpath, params, 'bot'>
    docOrigin = <$DocDomain, $DocScheme> in
    [ !AdvScript($Browser, ~did, docURL, refpolicy)
    , Document(~otherdid, $Browser, $OtherTLW, otherURL, otherReferer, $otherRefpolicy, $otherscript, otherscriptstate)
    , In(message)]
    --[AdvActive(), DocLoop(~otherdid, otherURL, $otherscript), _restrict(not ($otherscript = 'Adversaryscript'))]->
    [ ScriptinputPOST(~otherdid, ~did, docOrigin, message)
    , Document(~otherdid, $Browser, $OtherTLW, otherURL, otherReferer, $otherRefpolicy, $otherscript, otherscriptstate) ]
#endif

// Leak state rules
rule LeakPlainCookies:
let leakedcookie = <$name, content> in
    [!LeakState($Browser, $Domain, $Scheme, $TLW), CookiesPlain(~cid, $Browser, $Domain, rest ++ leakedcookie)[-]]
    --[PDPlainLeak($Browser, $Domain, leakedcookie), PlainCookiesLoop(~cid, $Browser, $Domain, rest ++ leakedcookie), NoLeakingUninit(content)]->
    [ CookiesPlain(~cid, $Browser, $Domain, rest ++ leakedcookie)[-]
    , Out(content)]

rule LeakSecCookies:
let leakedcookie = <$name, content> in
    [!LeakState($Browser, $Domain, 'https', $TLW), CookiesSec(~cid, $Browser, $Domain, rest ++ leakedcookie)[-]]
    --[PDSecLeak($Browser, $Domain, leakedcookie), SecCookiesLoop(~cid, $Browser, $Domain, rest ++ leakedcookie)]->
    [ CookiesSec(~cid, $Browser, $Domain, rest ++ leakedcookie)[-]
    , Out(content)]

rule LeakSecrets:
    [ !LeakState($Browser, $Domain, $Scheme, $TLW)
    , !Secrets($Browser, $Domain, $Scheme, data)]
    -->
    [ Out(data) ]

rule LeakServerSecrets:
    [ !CompromisedDomain($Domain)
    , !ServerSecret($Domain, secret)]
    -->
    [Out(secret)]

restriction OnlyOnce:
"All x #i #j. OnlyOnce(x)@i & OnlyOnce(x)@j ==> #i = #j"

restriction Equality:
"All a b #i. Eq(a,b)@i ==> a = b"

restriction Init:
"All cookie #i. Uninit(cookie)@i ==> cookie = NoCookies() | (Ex a b. cookie = a ++ b & (All rest singleton. cookie = rest ++ singleton ==> Ex name. singleton = <name, uninit()>))"


lemma aux_unique_requests[reuse]:
"All nonce #i #j. Send_Request_Nonce(nonce)@i & Send_Request_Nonce(nonce)@j ==> #i = #j"