lemma order [reuse]:
  all-traces
  "∀ browser redirnonce dom otherbody otherdom msgnonce
     secondmsgnonce thirdmessagenonce body status otherstatus #j #k.
    ((Continue_Redir( browser, dom, msgnonce, redirnonce, status,
                      secondmsgnonce, body
      ) @ #j) ∧
     (Continue_Redir( browser, otherdom, secondmsgnonce, redirnonce,
                      otherstatus, thirdmessagenonce, otherbody
      ) @ #k)) ⇒
    (¬(∃ thirddom msgin thirdstatus msgout thirdbody #l.
        ((Continue_Redir( browser, thirddom, msgin, redirnonce,
                          thirdstatus, msgout, thirdbody
          ) @ #l) ∧
         (#k < #l)) ∧
        (#l < #j)))"
/*
guarded formula characterizing all counter-examples:
"∃ browser redirnonce dom otherbody otherdom msgnonce
   secondmsgnonce thirdmessagenonce body status otherstatus #j #k.
  (Continue_Redir( browser, dom, msgnonce, redirnonce, status,
                   secondmsgnonce, body
   ) @ #j) ∧
  (Continue_Redir( browser, otherdom, secondmsgnonce, redirnonce,
                   otherstatus, thirdmessagenonce, otherbody
   ) @ #k)
 ∧
  ∃ thirddom msgin thirdstatus msgout thirdbody #l.
   (Continue_Redir( browser, thirddom, msgin, redirnonce, thirdstatus,
                    msgout, thirdbody
    ) @ #l)
  ∧
   (#k < #l) ∧ (#l < #j)"
*/
simplify
by contradiction /* cyclic */

lemma aux_303_clears_next [reuse]:
  all-traces
  "∀ browser redirnonce dom otherbody otherdom msgnonce
     secondmsgnonce body status thirdmsgnonce #j #k.
    ((Continue_Redir( browser, dom, msgnonce, redirnonce, '303',
                      secondmsgnonce, body
      ) @ #j) ∧
     (Continue_Redir( browser, otherdom, secondmsgnonce, redirnonce,
                      status, thirdmsgnonce, otherbody
      ) @ #k)) ⇒
    ((otherbody = NoBody) ∨ (∃ #i. CompromiseBrowser( browser ) @ #i))"
/*
guarded formula characterizing all counter-examples:
"∃ browser redirnonce dom otherbody otherdom msgnonce
   secondmsgnonce body status thirdmsgnonce #j #k.
  (Continue_Redir( browser, dom, msgnonce, redirnonce, '303',
                   secondmsgnonce, body
   ) @ #j) ∧
  (Continue_Redir( browser, otherdom, secondmsgnonce, redirnonce,
                   status, thirdmsgnonce, otherbody
   ) @ #k)
 ∧
  (¬(otherbody = NoBody)) ∧
  (∀ #i. (CompromiseBrowser( browser ) @ #i) ⇒ ⊥)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ browser redirnonce dom otherbody otherdom msgnonce
            secondmsgnonce body status thirdmsgnonce #j #k.
           (Continue_Redir( browser, dom, msgnonce, redirnonce, '303',
                            secondmsgnonce, body
            ) @ #j) ∧
           (Continue_Redir( browser, otherdom, secondmsgnonce, redirnonce,
                            status, thirdmsgnonce, otherbody
            ) @ #k)
          ⇒
           ((last(#k)) ∨
            (last(#j)) ∨
            (otherbody = NoBody) ∨
            (∃ #i. (CompromiseBrowser( browser ) @ #i) ∧ ¬(last(#i)))))  ∥
         (∃ cookie #i.
           (Uninit( cookie ) @ #i)
          ∧
           (¬(last(#i))) ∧
           (¬(cookie = NoCookies)) ∧
           (∀ a b.
             (cookie = (a++b))
            ⇒
             ∃ rest singleton.
              (cookie = (rest++singleton))
             ∧
              ∀ name. (singleton = <name, uninit>) ⇒ ⊥)) )
    case case_1
    solve( ProcessRedirectFinish( ~processid.1, $Browser, ~msgnonce,
                                  $status, finalorigin.1, $method.1, otherbody, refpolicy.1,
                                  $respScheme.1, $respDomain.1, resppath.1, respparams.1,
                                  finalfragment.1, referrer.1, ~redirnonce
