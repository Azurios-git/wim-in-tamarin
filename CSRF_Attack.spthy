restriction Restr_ProcessRedirect303_1:
  "∀ x #NOW x.1.
    (Restr_ProcessRedirect303_1( x, x.1 ) @ #NOW) ⇒
    ((x = 'GET') ∨ (x.1 = 'HEAD'))"
  // safety formula

rule (modulo E) ProcessRedirect303:
