   !LeakState( $Browser, $Domain, $Scheme, $TLW ),
   CookiesPlain( ~cid, $Browser, $Domain, (rest++<$name, content>)
   )[-]
   ]
  --[
  PDPlainLeak( $Browser, $Domain, <$name, content> ),
  PlainCookiesLoop( ~cid, $Browser, $Domain, (rest++<$name, content>)
  ),
  NoLeakingUninit( content )
  ]->
   [
   CookiesPlain( ~cid, $Browser, $Domain, (rest++<$name, content>)
   )[-],
   Out( content )
   ]

  // loop breaker: [1]
  /* has exactly the trivial AC variant */

rule (modulo E) LeakSecCookies:
   [
   !LeakState( $Browser, $Domain, 'https', $TLW ),
   CookiesSec( ~cid, $Browser, $Domain, (rest++<$name, content>) )[-]
   ]
  --[
  PDSecLeak( $Browser, $Domain, <$name, content> ),
  SecCookiesLoop( ~cid, $Browser, $Domain, (rest++<$name, content>) )
  ]->
   [
   CookiesSec( ~cid, $Browser, $Domain, (rest++<$name, content>) )[-],
   Out( content )
   ]

  // loop breaker: [1]
  /* has exactly the trivial AC variant */

rule (modulo E) LeakSecrets:
   [
   !LeakState( $Browser, $Domain, $Scheme, $TLW ),
   !Secrets( $Browser, $Domain, $Scheme, data )
   ]
  -->
   [ Out( data ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) LeakServerSecrets:
   [ !CompromisedDomain( $Domain ), !ServerSecret( $Domain, secret ) ]
  -->
   [ Out( secret ) ]

  /* has exactly the trivial AC variant */

restriction OnlyOnce:
  "∀ x #i #j.
    ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction Equality:
  "∀ a b #i. (Eq( a, b ) @ #i) ⇒ (a = b)"
  // safety formula

restriction Init:
  "∀ cookie #i.
    (Uninit( cookie ) @ #i) ⇒
    ((cookie = NoCookies) ∨
     (∃ a b.
       (cookie = (a++b)) ∧
       (∀ rest singleton.
         (cookie = (rest++singleton)) ⇒
         (∃ name. singleton = <name, uninit>))))"

lemma aux_unique_requests [reuse]:
  all-traces
  "∀ nonce #i #j.
    ((Send_Request_Nonce( nonce ) @ #i) ∧
     (Send_Request_Nonce( nonce ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ nonce #i #j.
  (Send_Request_Nonce( nonce ) @ #i) ∧
  (Send_Request_Nonce( nonce ) @ #j)
 ∧
  ¬(#i = #j)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (#i < #j)  ∥ (#j < #i) )
    case case_1
    solve( (∀ nonce #i #j.
             (Send_Request_Nonce( nonce ) @ #i) ∧
             (Send_Request_Nonce( nonce ) @ #j)
            ⇒
             ((last(#j)) ∨ (last(#i)) ∨ (#i = #j)))  ∥
           (∃ cookie #i.
             (Uninit( cookie ) @ #i)
            ∧
             (¬(last(#i))) ∧
             (¬(cookie = NoCookies)) ∧
             (∀ a b.
               (cookie = (a++b))
              ⇒
               ∃ rest singleton.
                (cookie = (rest++singleton))
               ∧
                ∀ name. (singleton = <name, uninit>) ⇒ ⊥)) )
      case case_1
      solve( Browser_Out( $Browser, window_or_doc_reference, $Domain,
                          $Scheme, $type, fragment, ~nonce, $method, $path, parameters,
                          plaincookies, seccookies, origin, referrer, auth, body, adv,
                          ~redirnonce
             )[no_precomp] ▶₀ #i )
        case BrowserSendPlain_case_01
        solve( Browser_Out( $Browser.1, window_or_doc_reference, $Domain.1,
                            $Scheme, $type, fragment.1, ~nonce, $method, $path.1, parameters.1,
                            plaincookies.1, seccookies, origin, referrer, auth, body, adv,
                            ~redirnonce.1
               )[no_precomp] ▶₀ #j )
