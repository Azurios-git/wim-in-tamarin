   Browser_Send_HTTP( $Browser, wid_or_did, $type, $scheme, $Domain,
                      $Path, parameters, fragment, $method, auth, origin, referrer,
                      referrerpolicy, body, 'honest', ~redirnonce, ~msgnonce
