  /* has exactly the trivial AC variant */

rule (modulo E) LeakPlainCookies:
   [
   !LeakState( $Browser, $Domain, $Scheme, $TLW ),
   CookiesPlain( ~cid, $Browser, $Domain, (rest++<$name, content>)
   )[-]
   ]
  --[
  PDPlainLeak( $Browser, $Domain, <$name, content> ),
  PlainCookiesLoop( ~cid, $Browser, $Domain, (rest++<$name, content>)
  ),
  NoLeakingUninit( content )
  ]->
   [
   CookiesPlain( ~cid, $Browser, $Domain, (rest++<$name, content>)
   )[-],
   Out( content )
   ]

  // loop breaker: [1]
  /* has exactly the trivial AC variant */

rule (modulo E) LeakSecCookies:
   [
   !LeakState( $Browser, $Domain, 'https', $TLW ),
   CookiesSec( ~cid, $Browser, $Domain, (rest++<$name, content>) )[-]
   ]
  --[
  PDSecLeak( $Browser, $Domain, <$name, content> ),
  SecCookiesLoop( ~cid, $Browser, $Domain, (rest++<$name, content>) )
  ]->
   [
   CookiesSec( ~cid, $Browser, $Domain, (rest++<$name, content>) )[-],
   Out( content )
   ]

  // loop breaker: [1]
  /* has exactly the trivial AC variant */

rule (modulo E) LeakSecrets:
   [
   !LeakState( $Browser, $Domain, $Scheme, $TLW ),
   !Secrets( $Browser, $Domain, $Scheme, data )
   ]
  -->
   [ Out( data ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) LeakServerSecrets:
   [ !CompromisedDomain( $Domain ), !ServerSecret( $Domain, secret ) ]
  -->
   [ Out( secret ) ]

  /* has exactly the trivial AC variant */

restriction OnlyOnce:
  "∀ x #i #j.
    ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction Equality:
  "∀ a b #i. (Eq( a, b ) @ #i) ⇒ (a = b)"
  // safety formula

restriction Init:
  "∀ cookie #i.
    (Uninit( cookie ) @ #i) ⇒
    ((cookie = NoCookies) ∨
     (∃ a b.
       (cookie = (a++b)) ∧
       (∀ rest singleton.
         (cookie = (rest++singleton)) ⇒
         (∃ name. singleton = <name, uninit>))))"

lemma aux_unique_requests [reuse]:
  all-traces
  "∀ nonce #i #j.
    ((Send_Request_Nonce( nonce ) @ #i) ∧
     (Send_Request_Nonce( nonce ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ nonce #i #j.
  (Send_Request_Nonce( nonce ) @ #i) ∧
  (Send_Request_Nonce( nonce ) @ #j)
 ∧
  ¬(#i = #j)"
*/
by sorry

rule (modulo E) miniServerIn:
   [
   !ClaimDomain( $Domain, 'miniServer' ),
   Receive_Request( $Browser, $Domain, 'https', ~nonce, 'GET',
                    '/init', parameters, cookies, origin, NewReferer, NewAuth, newbody
   ),
   Fr( ~token )
   ]
  --[
  PDAddSecCookies( $Domain, $Browser, <'SessionToken', ~token> ),
  PDAddedListSec( <<'SessionToken', ~token>, 'bot'> )
  ]->
   [
   Send_Reply( $Domain, $Browser, 'https', ~nonce, '200', NoCookies,
               (NoCookies++<'SessionToken', ~token>), NoLocation, 'bot',
               NoRefPolicy, <'MyScript', $Domain>
   ),
   !SessionToken( $Domain, ~token )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) miniServerDelete:
   [
   Receive_Request( $Browser, $Domain, 'https', ~nonce, 'POST',
                    '/deleteme', parameters, (cookies++<'SessionToken', ~token>),
                    origin, NewReferer, NewAuth, newbody
   ),
   !SessionToken( $Domain, ~token )
   ]
  --[ Deleted( ), Commit( $Domain, $Browser, '/deleteme' ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) clickDeleteMe:
   [
   Document( ~did, $Browser, $TLW,
             <$Scheme, $DocDomain, path, params, fragment>, referer, refpolicy,
             'MyScript', $ScriptDomain
   )
   ]
  --[ Run( $Browser, $ScriptDomain, '/deleteme' ) ]->
   [
   Send_Request_Browser( $Browser, $TLW, 'REQ', $Scheme,
                         $ScriptDomain, '/deleteme', 'bot', 'bot', 'POST', NoAuth,
                         <$DocDomain, $Scheme>, NoReferrer, NoRefPolicy, NoBody
   ),
   Document( ~did, $Browser, $TLW,
             <$Scheme, $DocDomain, path, params, fragment>, referer, refpolicy,
             'MyScript', <$ScriptDomain, 'ran'>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) compromiseServer:
   [ !CompromisedDomain( $Domain ), !SessionToken( $Domain, ~token ) ]
  -->
   [ Out( ~token ) ]

  /* has exactly the trivial AC variant */

lemma executability:
  exists-trace
  "∃ #i.
    ((Deleted( ) @ #i) ∧ (¬(∃ #j. AdvActive( ) @ #j))) ∧
    (¬(∃ b d r #j. RedirFrom( b, d, r ) @ #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ #i.
  (Deleted( ) @ #i)
 ∧
  (∀ #j. (AdvActive( ) @ #j) ⇒ ⊥) ∧
  (∀ b d r #j. (RedirFrom( b, d, r ) @ #j) ⇒ ⊥)"
*/
simplify
solve( Receive_Request( $Browser, $Domain, 'https', ~nonce, 'POST',
                        '/deleteme', parameters, (cookies++<'SessionToken', ~token>),
                        origin, NewReferer, NewAuth, newbody
       ) ▶₀ #i )
  case ServerInUser_case_1
  solve( Browser_Out( $Browser, window_or_doc_reference, $Domain,
                      'https', $type, fragment, ~nonce, 'POST', '/deleteme', parameters,
                      <'SessionToken', ~token>, cookies, origin, NewReferer, NewAuth,
                      newbody, adv, ~redirnonce
         )[no_precomp] ▶₀ #vr.2 )
    case BrowserSendSec_case_1
    by sorry
  next
    case BrowserSendSec_case_2
    by contradiction /* from formulas */
  next
    case CompromisedBrowserSend
    by contradiction /* from formulas */
  qed
next
  case ServerInUser_case_2
  by sorry
next
  case ServerInUser_case_3
  by sorry
next
  case ServerInUser_case_4
  solve( Browser_Out( $Browser, window_or_doc_reference, $Domain,
                      'https', $type, fragment, ~nonce, 'POST', '/deleteme', parameters,
                      plaincookies, (x++<'SessionToken', ~token>), origin, NewReferer,
                      NewAuth, newbody, adv, ~redirnonce
         )[no_precomp] ▶₀ #vr.2 )
    case BrowserSendSec_case_1
    solve( Browser_Out( $Browser, $TLW, $DocDomain, 'https', 'REQ',
                        fragment, ~nonce.1, $method, $path, params, plaincookies.1,
                        seccookies, origin, referer, auth, reqbody, adv, ~redirnonce.1
           )[no_precomp] ▶₀ #vr.8 )
      case BrowserSendSec_case_1
      solve( ProcessingDocument( ~processid, $Browser, 'https', ~nonce.1,
                                 $status, <'MyScript', $Domain>, location, STS, refpolicy,
                                 <'MyScript', $Domain>
             ) ▶₀ #vr.7 )
        case ProcessResponse_case_01
        by sorry
      next
        case ProcessResponse_case_02
        by contradiction /* from formulas */
      next
        case ProcessResponse_case_03
        solve( CookiesSec( ~cid, $Browser, $DocDomain,
                           (x++<'SessionToken', ~token>)
               )[no_precomp] ▶₃ #vr.3 )
          case BrowserSendSec_case_1
          by sorry
        next
          case BrowserSendSec_case_2
          by sorry
        next
          case BrowserSendSec_case_3
          by contradiction /* from formulas */
        next
          case LeakSecCookies_case_1
          by contradiction /* from formulas */
        next
          case LeakSecCookies_case_2
          by contradiction /* from formulas */
        next
          case LeakSecCookies_case_3
          by contradiction /* from formulas */
        next
          case LeakSecCookies_case_4
          by contradiction /* from formulas */
        next
          case LeakSecCookies_case_5
          by contradiction /* from formulas */
        next
          case LeakSecCookies_case_6
          by contradiction /* from formulas */
        next
          case ProcessCookiesSecLoopReplace_case_1
          by sorry
        next
          case ProcessCookiesSecLoopReplace_case_2
          solve( CookiesSec( ~cid, $Browser, $DocDomain,
                             (x++<'SessionToken', oldcontent>)
                 )[-] ▶₁ #vr.25 )
            case AddUninitialisedCookieSec_case_1
            by sorry
          next
            case AddUninitialisedCookieSec_case_2
            solve( (x = NoCookies)  ∥
                   (∃ a b.
                     (x = (a++b))
                    ∧
                     ∀ rest singleton.
                      (x = (rest++singleton)) ⇒ ∃ name. (singleton = <name, uninit>)) )
              case case_1
              solve( CookiesSec( ~cid, $Browser, $DocDomain, NoCookies
