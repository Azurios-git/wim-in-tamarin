lemma sourceSec [sources]:
  all-traces
  "(((∀ b d p #i.
       (PDSecLeak( b, d, p ) @ #i) ⇒
       (((∃ #j. (!KU( p ) @ #j) ∧ (#j < #i)) ∨
         (∃ #j. PDAddSecCookies( d, b, p ) @ #j)) ∨
        (∃ name. p = <name, uninit>))) ∧
     (∀ cid browser domain name content rest #i.
       (SecCookiesLoop( cid, browser, domain, (rest++<name, content>)
        ) @ #i) ⇒
       (((∃ #j. (!KU( <name, content> ) @ #j) ∧ (#j < #i)) ∨
         (content = uninit)) ∨
        (∃ #j.
          PDAddSecCookies( domain, browser, <name, content> ) @ #j)))) ∧
    (∀ cid browser domain cookie #i.
      (SecCookiesAddSingle( cid, browser, domain, cookie ) @ #i) ⇒
      ((∃ setcookiessec #j.
         ((ReceiveSecCookies( browser, domain, setcookiessec ) @ #j) ∧
          (#j < #i)) ∧
         (∃ rest. setcookiessec = (cookie++rest))) ∨
       (∃ name. cookie = <name, uninit>)))) ∧
   (∀ processid browser domain cookies #i.
     (IncomingSecLoop( processid, browser, domain, cookies ) @ #i) ⇒
     ((∃ super rest #j.
        (ReceiveSecCookies( browser, domain, super ) @ #j) ∧
        (super = (cookies++rest))) ∨
      (∃ #j. ReceiveSecCookies( browser, domain, cookies ) @ #j)))"
/*
guarded formula characterizing all counter-examples:
"((∃ b d p #i.
    (PDSecLeak( b, d, p ) @ #i)
   ∧
    (∀ #j. (!KU( p ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #j. (PDAddSecCookies( d, b, p ) @ #j) ⇒ ⊥) ∧
    (∀ name. (p = <name, uninit>) ⇒ ⊥)) ∨
  (∃ cid browser domain name content rest #i.
    (SecCookiesLoop( cid, browser, domain, (rest++<name, content>)
     ) @ #i)
   ∧
    (∀ #j. (!KU( <name, content> ) @ #j) ⇒ ¬(#j < #i)) ∧
    (¬(content = uninit)) ∧
    (∀ #j.
      (PDAddSecCookies( domain, browser, <name, content> ) @ #j) ⇒ ⊥)) ∨
  (∃ cid browser domain cookie #i.
    (SecCookiesAddSingle( cid, browser, domain, cookie ) @ #i)
   ∧
    (∀ setcookiessec #j.
      (ReceiveSecCookies( browser, domain, setcookiessec ) @ #j)
     ⇒
      ((¬(#j < #i)) ∨ (∀ rest. (setcookiessec = (cookie++rest)) ⇒ ⊥))) ∧
    (∀ name. (cookie = <name, uninit>) ⇒ ⊥)) ∨
  (∃ processid browser domain cookies #i.
    (IncomingSecLoop( processid, browser, domain, cookies ) @ #i)
   ∧
    (∀ super rest #j.
      (ReceiveSecCookies( browser, domain, super ) @ #j) ∧
      (super = (cookies++rest))
     ⇒
      ⊥) ∧
    (∀ #j. (ReceiveSecCookies( browser, domain, cookies ) @ #j) ⇒ ⊥)))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∃ b d p #i.
           (PDSecLeak( b, d, p ) @ #i)
          ∧
           (∀ #j. (!KU( p ) @ #j) ⇒ ¬(#j < #i)) ∧
           (∀ #j. (PDAddSecCookies( d, b, p ) @ #j) ⇒ ⊥) ∧
           (∀ name. (p = <name, uninit>) ⇒ ⊥))  ∥
         (∃ cid browser domain name content rest #i.
           (SecCookiesLoop( cid, browser, domain, (rest++<name, content>)
            ) @ #i)
          ∧
           (∀ #j. (!KU( <name, content> ) @ #j) ⇒ ¬(#j < #i)) ∧
           (¬(content = uninit)) ∧
           (∀ #j.
             (PDAddSecCookies( domain, browser, <name, content> ) @ #j) ⇒ ⊥))  ∥
         (∃ cid browser domain cookie #i.
           (SecCookiesAddSingle( cid, browser, domain, cookie ) @ #i)
          ∧
           (∀ setcookiessec #j.
             (ReceiveSecCookies( browser, domain, setcookiessec ) @ #j)
            ⇒
             ((¬(#j < #i)) ∨ (∀ rest. (setcookiessec = (cookie++rest)) ⇒ ⊥))) ∧
           (∀ name. (cookie = <name, uninit>) ⇒ ⊥))  ∥
         (∃ processid browser domain cookies #i.
           (IncomingSecLoop( processid, browser, domain, cookies ) @ #i)
          ∧
           (∀ super rest #j.
             (ReceiveSecCookies( browser, domain, super ) @ #j) ∧
             (super = (cookies++rest))
            ⇒
             ⊥) ∧
           (∀ #j. (ReceiveSecCookies( browser, domain, cookies ) @ #j) ⇒ ⊥)) )
    case case_1
    solve( ((∀ b d p #i.
              (PDSecLeak( b, d, p ) @ #i)
             ⇒
              ((last(#i)) ∨
               (∃ #j. (!KU( p ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) ∨
               (∃ #j. (PDAddSecCookies( d, b, p ) @ #j) ∧ ¬(last(#j))) ∨
               (∃ name. (p = <name, uninit>)))) ∧
            (∀ cid browser domain name content rest #i.
              (SecCookiesLoop( cid, browser, domain, (rest++<name, content>)
               ) @ #i)
             ⇒
              ((last(#i)) ∨
               (∃ #j. (!KU( <name, content> ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) ∨
               (content = uninit) ∨
               (∃ #j.
                 (PDAddSecCookies( domain, browser, <name, content> ) @ #j)
                ∧
                 ¬(last(#j))))) ∧
            (∀ cid browser domain cookie #i.
              (SecCookiesAddSingle( cid, browser, domain, cookie ) @ #i)
             ⇒
              ((last(#i)) ∨
               (∃ setcookiessec #j.
                 (ReceiveSecCookies( browser, domain, setcookiessec ) @ #j)
                ∧
                 (¬(last(#j))) ∧
                 (#j < #i) ∧
                 (∃ rest. (setcookiessec = (cookie++rest)))) ∨
               (∃ name. (cookie = <name, uninit>)))) ∧
            (∀ processid browser domain cookies #i.
              (IncomingSecLoop( processid, browser, domain, cookies ) @ #i)
             ⇒
              ((last(#i)) ∨
               (∃ super rest #j.
                 (ReceiveSecCookies( browser, domain, super ) @ #j) ∧
                 (super = (cookies++rest))
                ∧
                 ¬(last(#j))) ∨
               (∃ #j.
                 (ReceiveSecCookies( browser, domain, cookies ) @ #j)
                ∧
                 ¬(last(#j))))))  ∥
           (∃ cookie #i.
             (Uninit( cookie ) @ #i)
            ∧
             (¬(last(#i))) ∧
             (¬(cookie = NoCookies)) ∧
             (∀ a b.
               (cookie = (a++b))
              ⇒
               ∃ rest singleton.
                (cookie = (rest++singleton))
               ∧
                ∀ name. (singleton = <name, uninit>) ⇒ ⊥)) )
      case case_1
      solve( (last(#i))  ∥
             (∃ #j. (!KU( p ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i))  ∥
             (∃ #j. (PDAddSecCookies( d, b, p ) @ #j) ∧ ¬(last(#j)))  ∥
             (∃ name. (p = <name, uninit>)) )
        case case_1
        solve( PDSecLeak( b, d, p ) @ #i )
          case CompromisedServerReceiveSecCookie
          solve( !Request( $Browser, $Domain, $Scheme, ~nonce, method, $path,
                           parameters, plaincookies, (seccookies++<$name, content>), origin,
                           referrer, auth, body, 'honest'
                 ) ▶₁ #i )
            case SendRequest
            solve( Browser_Out( $Browser, window_or_doc_reference, $Domain,
                                $Scheme, $type, fragment, ~nonce, $method, $path, parameters,
                                plaincookies, (seccookies++<$name, content>), origin, referrer,
                                auth, body, 'honest', ~redirnonce
                   )[no_precomp] ▶₀ #vr )
              case BrowserSendSec_case_01
              solve( (∃ #j.
                       (!KU( <$name, content> ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.1))  ∥
                     (content = uninit)  ∥
                     (∃ #j.
                       (PDAddSecCookies( $Domain, $Browser, <$name, content> ) @ #j)
                      ∧
                       ¬(last(#j))) )
                case case_1
                by contradiction /* from formulas */
              next
                case case_2
                by contradiction /* from formulas */
              next
                case case_3
                by contradiction /* from formulas */
              qed
            next
              case BrowserSendSec_case_02
              solve( (∃ #j.
                       (!KU( <$name, content> ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.1))  ∥
                     (content = uninit)  ∥
                     (∃ #j.
                       (PDAddSecCookies( $Domain, $Browser, <$name, content> ) @ #j)
                      ∧
                       ¬(last(#j))) )
                case case_1
                by contradiction /* from formulas */
              next
                case case_2
                by contradiction /* from formulas */
              next
                case case_3
                by contradiction /* from formulas */
              qed
            next
              case BrowserSendSec_case_03
              solve( (∃ #j.
                       (!KU( <$name, content> ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.1))  ∥
                     (content = uninit)  ∥
                     (∃ #j.
                       (PDAddSecCookies( $Domain, $Browser, <$name, content> ) @ #j)
                      ∧
                       ¬(last(#j))) )
                case case_1
                by contradiction /* from formulas */
              next
                case case_2
                by contradiction /* from formulas */
              next
                case case_3
                by contradiction /* from formulas */
              qed
            next
              case BrowserSendSec_case_04
              solve( (∃ #j.
                       (!KU( <$name, content> ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.1))  ∥
                     (content = uninit)  ∥
                     (∃ #j.
                       (PDAddSecCookies( $Domain, $Browser, <$name, content> ) @ #j)
                      ∧
                       ¬(last(#j))) )
                case case_1
                by contradiction /* from formulas */
              next
                case case_2
                by contradiction /* from formulas */
              next
                case case_3
                by contradiction /* from formulas */
              qed
            next
              case BrowserSendSec_case_05
              solve( (∃ #j.
                       (!KU( <$name, content> ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.1))  ∥
                     (content = uninit)  ∥
                     (∃ #j.
                       (PDAddSecCookies( $Domain, $Browser, <$name, content> ) @ #j)
                      ∧
                       ¬(last(#j))) )
                case case_1
                by contradiction /* from formulas */
