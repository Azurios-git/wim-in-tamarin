        by contradiction /* from formulas */
      next
        case BrowserSendSec_case_20
        by contradiction /* from formulas */
      next
        case CompromisedBrowserSend
        by contradiction /* from formulas */
      qed
    next
      case case_2
      solve( (body = NoBody)  ∥ (otherbody = body) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2
        by contradiction /* from formulas */
      qed
    qed
  next
    case case_2
    solve( (cookie = NoCookies)  ∥
           (∃ a b.
             (cookie = (a++b))
            ∧
             ∀ rest singleton.
              (cookie = (rest++singleton))
             ⇒
              ∃ name. (singleton = <name, uninit>)) )
      case case_1
      by contradiction /* from formulas */
    next
      case case_2_case_1
      by contradiction /* from formulas */
    next
      case case_2_case_2
      by contradiction /* from formulas */
    qed
  qed
qed

lemma aux_redirect_chain2 [reuse, use_induction]:
  all-traces
  "∀ browser nonce body dom inmsg status outmsg #i.
    (Continue_Redir( browser, dom, inmsg, nonce, status, outmsg, body
     ) @ #i) ⇒
    (∃ otherbody otherdom scheme msgnonce #j.
      (Fresh_Redirnonce( browser, nonce, otherbody, otherdom, scheme,
                         msgnonce
       ) @ #j) ∧
