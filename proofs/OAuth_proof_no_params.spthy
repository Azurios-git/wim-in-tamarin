lemma aux_redirect_chain2 [reuse, use_induction]:
  all-traces
  "∀ browser nonce body dom inmsg status outmsg #i.
    (Continue_Redir( browser, dom, inmsg, nonce, status, outmsg, body
     ) @ #i) ⇒
    (∃ otherbody otherdom scheme msgnonce #j.
      (Fresh_Redirnonce( browser, nonce, otherbody, otherdom, scheme,
                         msgnonce
       ) @ #j) ∧
      ((body = NoBody) ∨ (otherbody = body)))"
/*
guarded formula characterizing all counter-examples:
"∃ browser nonce body dom inmsg status outmsg #i.
  (Continue_Redir( browser, dom, inmsg, nonce, status, outmsg, body
   ) @ #i)
 ∧
  ∀ otherbody otherdom scheme msgnonce #j.
   (Fresh_Redirnonce( browser, nonce, otherbody, otherdom, scheme,
                      msgnonce
    ) @ #j)
  ⇒
   (¬(body = NoBody)) ∧ (¬(otherbody = body))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ browser nonce body dom inmsg status outmsg #i.
           (Continue_Redir( browser, dom, inmsg, nonce, status, outmsg, body
            ) @ #i)
          ⇒
           ((last(#i)) ∨
            (∃ otherbody otherdom scheme msgnonce #j.
              (Fresh_Redirnonce( browser, nonce, otherbody, otherdom, scheme,
                                 msgnonce
               ) @ #j)
             ∧
              (¬(last(#j))) ∧ (((body = NoBody) ∨ (otherbody = body))))))  ∥
         (∃ cookie #i.
           (Uninit( cookie ) @ #i)
          ∧
           (¬(last(#i))) ∧
           (¬(cookie = NoCookies)) ∧
           (∀ a b.
             (cookie = (a++b))
            ⇒
             ∃ rest singleton.
              (cookie = (rest++singleton))
             ∧
              ∀ name. (singleton = <name, uninit>) ⇒ ⊥)) )
    case case_1
    solve( (last(#i))  ∥
           (∃ otherbody otherdom scheme msgnonce #j.
             (Fresh_Redirnonce( $Browser, ~redirnonce, otherbody, otherdom,
                                scheme, msgnonce
              ) @ #j)
            ∧
             (¬(last(#j))) ∧ (((body = NoBody) ∨ (otherbody = body)))) )
      case case_1
      solve( ProcessRedirectFinish( ~processid, $Browser, ~nonce,
                                    $status, finalorigin, $method, body, refpolicy, $respScheme,
                                    $respDomain, resppath, respparams, finalfragment, referrer,
                                    ~redirnonce
             ) ▶₀ #i )
        case ProcessRedirect303BadMethod_case_1
        by contradiction /* from formulas */
      next
        case ProcessRedirect303BadMethod_case_2
        by contradiction /* from formulas */
      next
        case ProcessRedirect303BadMethod_case_3
        by contradiction /* from formulas */
      next
        case ProcessRedirect303BadMethod_case_4
        by contradiction /* from formulas */
      next
        case ProcessRedirect303_case_1
        solve( (body = NoBody)  ∥ (otherbody = body) )
          case case_1
          by contradiction /* from formulas */
        next
          case case_2
          by contradiction /* from formulas */
        qed
      next
        case ProcessRedirect303_case_2
        solve( (body = NoBody)  ∥ (otherbody = body) )
          case case_1
          by contradiction /* from formulas */
        next
          case case_2
          by contradiction /* from formulas */
        qed
      next
        case ProcessRedirect303_case_3
        solve( (body = NoBody)  ∥ (otherbody = body) )
          case case_1
          by contradiction /* from formulas */
        next
          case case_2
          by contradiction /* from formulas */
        qed
      next
