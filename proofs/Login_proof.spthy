  SecCookiesLoop( ~cid, $Browser, $Domain,
                  (oldcookies++<$name, oldcontent>)
  ),
  AddSecLoop( ~processid ),
  IncomingSecLoop( ~processid, $Browser, $Domain,
                   (rest++<$name, content>)
  )
  ]->
   [
   CookiesSec( ~cid, $Browser, $Domain, (oldcookies++<$name, content>)
   )[-],
   IncomingSec( ~processid, $Browser, rest, $Domain )
   ]

  // loop breakers: [1,0]
