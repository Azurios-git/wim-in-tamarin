lemma aux_redirnonce_unique [reuse]:
  all-traces
  "∀ browser nonce body otherbody dom otherdom scheme otherscheme
     msgnonce othermsgnonce #i #j.
    ((Fresh_Redirnonce( browser, nonce, otherbody, otherdom, scheme,
                        msgnonce
      ) @ #j) ∧
     (Fresh_Redirnonce( browser, nonce, body, dom, otherscheme,
                        othermsgnonce
      ) @ #i)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ browser nonce body otherbody dom otherdom scheme otherscheme
   msgnonce othermsgnonce #i #j.
  (Fresh_Redirnonce( browser, nonce, otherbody, otherdom, scheme,
                     msgnonce
   ) @ #j) ∧
  (Fresh_Redirnonce( browser, nonce, body, dom, otherscheme,
                     othermsgnonce
   ) @ #i)
 ∧
  ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( Fresh_Redirnonce( browser, nonce, otherbody, otherdom,
                           scheme, msgnonce
         ) @ #j )
    case AdversaryRunScriptFormGet
    solve( Fresh_Redirnonce( $Browser, ~redirnonce, body, dom,
                             otherscheme, othermsgnonce
           ) @ #i )
      case AdversaryRunScriptFormGet
      by contradiction /* cyclic */
    qed
  next
    case AdversaryRunScriptFormPost
    solve( Fresh_Redirnonce( $Browser, ~redirnonce, body, dom,
                             otherscheme, othermsgnonce
           ) @ #i )
      case AdversaryRunScriptFormPost
      by contradiction /* cyclic */
    qed
  next
    case AdversaryRunScriptHrefIframe
    solve( Fresh_Redirnonce( $Browser, ~redirnonce, body, dom,
                             otherscheme, othermsgnonce
           ) @ #i )
      case AdversaryRunScriptHrefIframe
      by contradiction /* cyclic */
    qed
  next
    case AdversaryRunScriptXHRGetHead
    solve( Fresh_Redirnonce( $Browser, ~redirnonce, body, dom,
                             otherscheme, othermsgnonce
           ) @ #i )
      case AdversaryRunScriptXHRGetHead
      by contradiction /* cyclic */
    qed
  next
    case AdversaryRunScriptXHROther
    solve( Fresh_Redirnonce( $Browser, ~redirnonce, body, dom,
                             otherscheme, othermsgnonce
           ) @ #i )
      case AdversaryRunScriptXHROther
      by contradiction /* cyclic */
    qed
  next
    case BrowserOutUser
    solve( Fresh_Redirnonce( $Browser, ~redirnonce, body, dom,
                             otherscheme, othermsgnonce
           ) @ #i )
      case BrowserOutUser
      by contradiction /* cyclic */
    qed
  next
    case CompromisedBrowserSend
    solve( Fresh_Redirnonce( $Browser, ~redirnonce, body, dom,
                             otherscheme, othermsgnonce
           ) @ #i )
      case CompromisedBrowserSend
      by contradiction /* cyclic */
    qed
  next
    case OpenURL
    solve( Fresh_Redirnonce( $Browser, ~redirnonce, body, dom,
                             otherscheme, othermsgnonce
           ) @ #i )
      case OpenURL
      by contradiction /* cyclic */
    qed
  next
    case ServerCreateRequestUser
    solve( Fresh_Redirnonce( $Browser, ~redirnonce, body, dom,
                             otherscheme, othermsgnonce
           ) @ #i )
      case ServerCreateRequestUser
      by contradiction /* cyclic */
    qed
  qed
next
  case case_2
  solve( Fresh_Redirnonce( browser, nonce, body, dom, otherscheme,
                           othermsgnonce
         ) @ #i )
    case AdversaryRunScriptFormGet
    solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody,
                             otherdom, scheme, msgnonce.1
           ) @ #j )
      case AdversaryRunScriptFormGet
      by contradiction /* cyclic */
    qed
  next
    case AdversaryRunScriptFormPost
    solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody,
                             otherdom, scheme, msgnonce.1
           ) @ #j )
      case AdversaryRunScriptFormPost
      by contradiction /* cyclic */
    qed
  next
    case AdversaryRunScriptHrefIframe
    solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody,
                             otherdom, scheme, msgnonce.1
           ) @ #j )
      case AdversaryRunScriptHrefIframe
      by contradiction /* cyclic */
    qed
  next
    case AdversaryRunScriptXHRGetHead
    solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody,
                             otherdom, scheme, msgnonce.1
           ) @ #j )
      case AdversaryRunScriptXHRGetHead
      by contradiction /* cyclic */
    qed
  next
    case AdversaryRunScriptXHROther
    solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody,
                             otherdom, scheme, msgnonce.1
           ) @ #j )
      case AdversaryRunScriptXHROther
      by contradiction /* cyclic */
    qed
  next
    case BrowserOutUser
    solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody,
                             otherdom, scheme.1, msgnonce.1
           ) @ #j )
      case BrowserOutUser
      by contradiction /* cyclic */
    qed
  next
    case CompromisedBrowserSend
    solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody,
                             otherdom, scheme, msgnonce.1
           ) @ #j )
      case CompromisedBrowserSend
      by contradiction /* cyclic */
    qed
  next
    case OpenURL
    solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody,
                             otherdom, scheme, msgnonce.1
           ) @ #j )
      case OpenURL
      by contradiction /* cyclic */
    qed
  next
    case ServerCreateRequestUser
    solve( Fresh_Redirnonce( $Browser, ~redirnonce, otherbody,
                             otherdom, scheme, msgnonce
           ) @ #j )
      case ServerCreateRequestUser
      by contradiction /* cyclic */
    qed
  qed
qed

lemma aux_redirect_chain [reuse, use_induction]:
  all-traces
  "∀ browser nonce body dom #i.
    (Send_redirnonce( browser, nonce, body, dom ) @ #i) ⇒
    (∃ otherbody otherdom scheme msgnonce #j.
      (Fresh_Redirnonce( browser, nonce, otherbody, otherdom, scheme,
                         msgnonce
       ) @ #j) ∧
      ((body = NoBody) ∨ (otherbody = body)))"
/*
guarded formula characterizing all counter-examples:
"∃ browser nonce body dom #i.
  (Send_redirnonce( browser, nonce, body, dom ) @ #i)
 ∧
  ∀ otherbody otherdom scheme msgnonce #j.
   (Fresh_Redirnonce( browser, nonce, otherbody, otherdom, scheme,
                      msgnonce
    ) @ #j)
  ⇒
   (¬(body = NoBody)) ∧ (¬(otherbody = body))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ browser nonce body dom #i.
           (Send_redirnonce( browser, nonce, body, dom ) @ #i)
          ⇒
           ((last(#i)) ∨
            (∃ otherbody otherdom scheme msgnonce #j.
              (Fresh_Redirnonce( browser, nonce, otherbody, otherdom, scheme,
                                 msgnonce
               ) @ #j)
             ∧
              (¬(last(#j))) ∧ (((body = NoBody) ∨ (otherbody = body))))))  ∥
         (∃ cookie #i.
           (Uninit( cookie ) @ #i)
          ∧
           (¬(last(#i))) ∧
           (¬(cookie = NoCookies)) ∧
           (∀ a b.
             (cookie = (a++b))
            ⇒
             ∃ rest singleton.
              (cookie = (rest++singleton))
             ∧
              ∀ name. (singleton = <name, uninit>) ⇒ ⊥)) )
    case case_1
    solve( (last(#i))  ∥
           (∃ otherbody otherdom scheme msgnonce #j.
             (Fresh_Redirnonce( $Browser, ~redirnonce, otherbody, otherdom,
                                scheme, msgnonce
              ) @ #j)
            ∧
             (¬(last(#j))) ∧ (((body = NoBody) ∨ (otherbody = body)))) )
      case case_1
      solve( Browser_Out( $Browser, window_or_doc_reference, $Domain,
                          $Scheme, $type, fragment, ~nonce, $method, $path, parameters,
                          plaincookies, seccookies, origin, referrer, auth, body, adv,
                          ~redirnonce
             )[no_precomp] ▶₀ #i )
        case BrowserSendPlain_case_01
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_02
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_03
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_04
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_05
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_06
        solve( (body = NoBody)  ∥ (otherbody = body) )
          case case_1
          by contradiction /* from formulas */
        next
          case case_2
          by contradiction /* from formulas */
        qed
      next
        case BrowserSendPlain_case_07
        solve( (body = NoBody)  ∥ (otherbody = body) )
          case case_1
          by contradiction /* from formulas */
        next
          case case_2
          by contradiction /* from formulas */
        qed
      next
