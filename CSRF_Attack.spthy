          by contradiction /* cyclic */
        qed
      next
        case CompromisedBrowserSend
        solve( Browser_Out( $Browser.1, window_or_doc_reference.1,
                            $Domain.1, $Scheme.1, $type.1, fragment.1, ~nonce, $method.1,
                            $path.1, parameters.1, plaincookies.1, seccookies.1, origin.1,
                            referrer.1, auth.1, body.1, adv, ~redirnonce.1
               )[no_precomp] ▶₀ #j )
          case CompromisedBrowserSend
          by contradiction /* cyclic */
        qed
      qed
    next
      case case_2
      solve( (cookie = NoCookies)  ∥
             (∃ a b.
               (cookie = (a++b))
              ∧
               ∀ rest singleton.
                (cookie = (rest++singleton))
               ⇒
                ∃ name. (singleton = <name, uninit>)) )
        case case_1
        by contradiction /* from formulas */
      next
        case case_2_case_1
        by contradiction /* from formulas */
      next
        case case_2_case_2
        by contradiction /* from formulas */
      qed
    qed
  qed
qed

rule (modulo E) miniServerIn:
   [
   !ClaimDomain( $Domain, 'miniServer' ),
   Receive_Request( $Browser, $Domain, 'https', ~nonce, 'GET',
                    '/init', parameters, cookies, origin, NewReferer, NewAuth, newbody
   ),
   Fr( ~token )
   ]
  --[
  PDAddSecCookies( $Domain, $Browser, <'SessionToken', ~token> ),
  PDAddedListSec( <<'SessionToken', ~token>, 'bot'> ), Deleted( )
  ]->
   [
   Send_Reply( $Domain, $Browser, 'https', ~nonce, '200', NoCookies,
               (NoCookies++<'SessionToken', ~token>), NoLocation, 'bot',
               NoRefPolicy, <'MyScript', $Domain>
   ),
   !SessionToken( $Domain, ~token )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) miniServerDelete:
   [
   Receive_Request( $Browser, $Domain, 'https', ~nonce, 'POST',
                    '/deleteme', parameters, (cookies++<'SessionToken', ~token>),
                    origin, NewReferer, NewAuth, newbody
   ),
   !SessionToken( $Domain, ~token )
   ]
  --[ Deleted( ), Commit( $Domain, $Browser, '/deleteme' ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) clickDeleteMe:
   [
   Document( ~did, $Browser, $TLW,
             <$Scheme, $DocDomain, path, params, fragment>, referer, refpolicy,
             'MyScript', $ScriptDomain
   )
   ]
  --[ Run( $Browser, $ScriptDomain, '/deleteme' ) ]->
   [
   Send_Request_Browser( $Browser, $TLW, 'REQ', $Scheme,
                         $ScriptDomain, '/deleteme', 'bot', 'bot', 'POST', NoAuth,
                         <$DocDomain, $Scheme>, NoReferrer, NoRefPolicy, NoBody
   ),
   Document( ~did, $Browser, $TLW,
             <$Scheme, $DocDomain, path, params, fragment>, referer, refpolicy,
             'MyScript', <$ScriptDomain, 'ran'>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) compromiseServer:
   [ !CompromisedDomain( $Domain ), !SessionToken( $Domain, ~token ) ]
  -->
   [ Out( ~token ) ]

  /* has exactly the trivial AC variant */

lemma executabilit:
  exists-trace
  "∃ #i. (OpenUrl( ) @ #i) ∧ (¬(∃ #j. AdvActive( ) @ #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (OpenUrl( ) @ #i) ∧ ∀ #j. (AdvActive( ) @ #j) ⇒ ⊥"
*/
by sorry

lemma executability:
  exists-trace "∃ #i. (Sent( ) @ #i) ∧ (¬(∃ #j. AdvActive( ) @ #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Sent( ) @ #i) ∧ ∀ #j. (AdvActive( ) @ #j) ⇒ ⊥"
*/
by sorry

lemma executability2:
  exists-trace "∃ #i. (SR( ) @ #i) ∧ (¬(∃ #j. AdvActive( ) @ #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (SR( ) @ #i) ∧ ∀ #j. (AdvActive( ) @ #j) ⇒ ⊥"
*/
by sorry

lemma executability3:
  exists-trace "∃ #i. (RR( ) @ #i) ∧ (¬(∃ #j. AdvActive( ) @ #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (RR( ) @ #i) ∧ ∀ #j. (AdvActive( ) @ #j) ⇒ ⊥"
*/
by sorry

lemma agreementCSRF:
  all-traces
  "∀ server browser path #i.
    (((Commit( server, browser, path ) @ #i) ∧
      (¬(∃ #r. CompromiseDomain( server ) @ #r))) ∧
     (¬(∃ #r. CompromiseBrowser( browser ) @ #r))) ⇒
    (∃ #j. (Run( browser, server, path ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ server browser path #i.
  (Commit( server, browser, path ) @ #i)
 ∧
  (∀ #r. (CompromiseDomain( server ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (CompromiseBrowser( browser ) @ #r) ⇒ ⊥) ∧
  (∀ #j. (Run( browser, server, path ) @ #j) ⇒ ¬(#j < #i))"
*/
simplify
