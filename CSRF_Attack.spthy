              parameters, plaincookies, seccookies, origin, referrer, auth, body,
              adv
   )
   ]
  --[ RR( ) ]->
   [
   Receive_Request( $Browser, $Domain, $Scheme, ~nonce, $method,
                    $path, parameters, (plaincookies++seccookies), origin, referrer,
                    auth, body
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) BrowserOutUser:
   [
   Send_Request_Browser( $Browser, wid_or_did, $type, $scheme,
                         $Domain, $Path, parameters, fragment, $method, auth, origin,
                         referrer, referrerpolicy, body
   ),
   Fr( ~redirnonce ), Fr( ~msgnonce )
   ]
  --[
  Fresh_Redirnonce( $Browser, ~redirnonce, body, $Domain, $scheme,
                    ~msgnonce
  )
  ]->
