rule (modulo E) ProcessRedirectOriginOkay:
   [
   ProcessRedirectFragment( ~processid, $Browser, ~nonce, $status,
                            requestorigin, $method, body, refpolicy, $respScheme, $respDomain,
                            resppath, respparams, finalfragment, $requestDomain,
                            $requestScheme, $respDomain, $respScheme, referrer, ~redirnonce
   )
   ]
  --[
  OriginRedirectRestriction( requestorigin, $requestDomain,
                             $requestScheme, $respDomain, $respScheme
  )
  ]->
   [
   ProcessRedirectOrigin( ~processid, $Browser, ~nonce, $status,
                          requestorigin, $method, body, refpolicy, $respScheme, $respDomain,
                          resppath, respparams, finalfragment, referrer, ~redirnonce
   )
