  case ClaimDomain
  solve( !Browser( ~bid, $Browser ) ▶₁ #j )
    case CreateBrowser
    solve( !KU( ~login ) @ #vk )
      case CompromisedServerReceiveParamAuthBody_case_1
      solve( Browser_Out( $Browser.1, window_or_doc_reference, $Domain.1,
