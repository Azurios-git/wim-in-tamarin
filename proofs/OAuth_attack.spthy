theory OAuth begin

// Function signature and definition of the equational theory E

builtins: multiset
functions: Container/1, NoAuth/0, NoBody/0, NoCookies/0,
           NoLocation/0, NoOrigin/0, NoParams/0, NoRefPolicy/0, NoReferrer/0,
           NoSTS/0, fst/1, pair/2, snd/1, uninit/0
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2





/*
looping facts with injective instances:
  Browser_State/3, CookiesPlain/4, CookiesSec/4, Document/8,
  IncomingPlain/4, IncomingSec/4
*/



rule (modulo E) HTTPRevealRequestParamAuthBody:
   [
   !Request( $Browser, $Domain, 'http', ~nonce, method, $path,
             parameters, plaincookies, seccookies, origin, referrer, auth, body,
             'honest'
   )[no_precomp]
   ]
  --[ PDLeakBody( body ) ]->
   [ Out( <auth, body> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) HTTPRevealRequestParam:
   [
   !Request( $Browser, $Domain, 'http', ~nonce, method, $path,
             (parameters++<$name, ~content>), plaincookies, seccookies, origin,
             referrer, auth, body, 'honest'
   )[no_precomp]
   ]
  -->
   [ Out( ~content ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) HTTPRevealRequestPlainCookie:
   [
   !Request( $Browser, $Domain, 'http', ~nonce, method, $path,
             parameters, (plaincookies++<$name, content>), seccookies, origin,
             referrer, auth, body, 'honest'
   )
   ]
  --[
  PDPlainLeak( $Browser, $Domain, <$name, content> ), AdvPassive( ),
  NoLeakingUninit( content )
  ]->
   [ Out( content ) ]

  /* has exactly the trivial AC variant */

restriction NoUninit:
  "∀ #i. (NoLeakingUninit( uninit ) @ #i) ⇒ (⊥)"
  // safety formula

lemma NoSecCookiesOverPlainHTTP:
  all-traces
  "∀ seccookies scheme #i.
    (SendSecCookies( seccookies, scheme ) @ #i) ⇒
    ((scheme = 'https') ∨
     ((seccookies = NoCookies) ∨
      (∃ #j. (!KU( seccookies ) @ #j) ∧ (#j < #i))))"
/*
guarded formula characterizing all counter-examples:
"∃ seccookies scheme #i.
  (SendSecCookies( seccookies, scheme ) @ #i)
 ∧
  (¬(scheme = 'https')) ∧
  (¬(seccookies = NoCookies)) ∧
  (∀ #j. (!KU( seccookies ) @ #j) ⇒ ¬(#j < #i))"
*/
by sorry

lemma NoRefFragmentSent:
  all-traces
  "∀ referer #i.
    (SendReferer( referer ) @ #i) ⇒
    (((referer = NoReferrer) ∨
      (∃ scheme dom path params.
        referer = <scheme, dom, path, params, 'bot'>)) ∨
     (∃ #j. (!KU( referer ) @ #j) ∧ (#j < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ referer #i.
  (SendReferer( referer ) @ #i)
 ∧
  (¬(referer = NoReferrer)) ∧
  (∀ scheme dom path params.
    (referer = <scheme, dom, path, params, 'bot'>) ⇒ ⊥) ∧
  (∀ #j. (!KU( referer ) @ #j) ⇒ ¬(#j < #i))"
*/
by sorry

rule (modulo E) CompromisedServerReceiveParamAuthBody:
   [
   !CompromisedDomain( $Domain ),
   !Request( $Browser, $Domain, $Scheme, ~nonce, method, $path,
             parameters, plaincookies, seccookies, origin, referrer, auth, body,
             'honest'
   )[no_precomp]
   ]
  --[ PDLeakBody( body ) ]->
   [ Out( <auth, body> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompromisedServerReceiveParams:
   [
   !CompromisedDomain( $Domain ),
   !Request( $Browser, $Domain, $Scheme, ~nonce, method, $path,
             (parameters++<$name, ~content>), plaincookies, seccookies, origin,
             referrer, auth, body, 'honest'
   )[no_precomp]
   ]
  -->
   [ Out( ~content ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompromisedServerReceivePlainCookie:
   [
   !CompromisedDomain( $Domain ),
   !Request( $Browser, $Domain, $Scheme, ~nonce, method, $path,
             parameters, (plaincookies++<$name, content>), seccookies, origin,
             referrer, auth, body, 'honest'
   )
   ]
  --[
  PDPlainLeak( $Browser, $Domain, <$name, content> ), AdvPassive( ),
  NoLeakingUninit( content )
  ]->
   [ Out( content ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompromisedServerReceiveSecCookie:
   [
   !CompromisedDomain( $Domain ),
   !Request( $Browser, $Domain, $Scheme, ~nonce, method, $path,
             parameters, plaincookies, (seccookies++<$name, content>), origin,
             referrer, auth, body, 'honest'
   )
   ]
  --[ PDSecLeak( $Browser, $Domain, <$name, content> ), AdvPassive( )
  ]->
   [ Out( content ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompromisedServerReceiveReferrer:
   [
   !CompromisedDomain( $Domain ),
   !Request( $Browser, $Domain, $Scheme, ~nonce, method, $path,
             parameters, (leakedplain++plaincookies), (leakedsec++seccookies),
             origin,
             <$RefScheme, $RefDomain, $RefPath, (RefParams++<$name, ~content>), 
              RefFragment>,
             auth, body, 'honest'
   )
   ]
  --[ PDLeakReferrerParams( RefParams ), AdvPassive( ) ]->
   [ Out( ~content ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) HTTPRevealResponse:
   [
   !Response( $Domain, $Browser, 'http', ~nonce, $status,
              setcookiesplain, setcookiessec, location, $sts, $refpolicy, body,
              'honest'
   )
   ]
  -->
   [ Out( <setcookiesplain, setcookiessec, body> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) HTTPRevealResponseLocation:
   [
   !Response( $Domain, $Browser, 'http', ~nonce, $status,
              setcookiesplain, setcookiessec,
              <$LocScheme, $LocDomain, $LocPath, LocParams, LocFragment>, $sts,
              $refpolicy, body, 'honest'
   )
   ]
  -->
   [ Out( <LocParams, LocFragment> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompromisedBrowserReadReceivedMessage:
   [
   !CompromisedBrowser( ~bid ),
   !Response( $Domain, ~bid, $Scheme, ~nonce, $status,
              setcookiesplain, setcookiessec, location, $sts, $refpolicy, body,
              'honest'
   )[no_precomp]
   ]
  -->
   [ Out( <setcookiesplain, setcookiessec, body> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompromisedBrowserReadReceivedLocation:
   [
   !CompromisedBrowser( ~bid ),
   !Response( $Domain, ~bid, $Scheme, ~nonce, $status,
              setcookiesplain, setcookiessec,
              <$LocScheme, $LocDomain, $LocPath, LocParams, LocFragment>, $sts,
              $refpolicy, body, 'honest'
   )
   ]
  -->
   [ Out( <LocParams, LocFragment> ) ]

  /* has exactly the trivial AC variant */

lemma sourceBodyLeak [sources]:
  all-traces
  "∀ body #i.
    ((PDLoopBody( body ) @ #i) ∧
     (¬((∃ #l. (!KU( body ) @ #l) ∧ (#l < #i)) ∨
        (∃ #k. (PDAddBody( body ) @ #k) ∧ (#k < #i))))) ⇒
    (((body = NoBody) ∨ (∃ #j. (!KU( body ) @ #j) ∧ (#j < #i))) ∨
     (∃ #k. (PDAddBody( body ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ body #i.
  (PDLoopBody( body ) @ #i)
 ∧
  (∀ #l. (!KU( body ) @ #l) ⇒ ¬(#l < #i)) ∧
  (∀ #k. (PDAddBody( body ) @ #k) ⇒ ¬(#k < #i)) ∧
  (¬(body = NoBody)) ∧
  (∀ #j. (!KU( body ) @ #j) ⇒ ¬(#j < #i))"
*/
by sorry

lemma sourceAuthLeak [sources]:
  all-traces
  "∀ auth #i.
    (PDLeakAuth( auth ) @ #i) ⇒
    (((auth = NoAuth) ∨ (∃ #j. (!KU( auth ) @ #j) ∧ (#j < #i))) ∨
     (∃ #k. (PDAddAuth( auth ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ auth #i.
  (PDLeakAuth( auth ) @ #i)
 ∧
  (¬(auth = NoAuth)) ∧
  (∀ #j. (!KU( auth ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #k. (PDAddAuth( auth ) @ #k) ⇒ ¬(#k < #i))"
*/
by sorry

lemma sourcePlain [sources]:
  all-traces
  "(((∀ b d p #i.
       (PDPlainLeak( b, d, p ) @ #i) ⇒
       (((∃ #j. (!KU( p ) @ #j) ∧ (#j < #i)) ∨
         (∃ #j. (PDAddPlainCookie( d, b, p ) @ #j) ∧ (#j < #i))) ∨
        (∃ name. p = <name, uninit>))) ∧
     (∀ cid browser domain name content rest #i.
       (PlainCookiesLoop( cid, browser, domain, (rest++<name, content>)
        ) @ #i) ⇒
       (((∃ #j. (!KU( <name, content> ) @ #j) ∧ (#j < #i)) ∨
         (content = uninit)) ∨
        (∃ #j.
          (PDAddPlainCookie( domain, browser, <name, content> ) @ #j) ∧
          (#j < #i))))) ∧
    (∀ cid browser domain cookie #i.
      (PlainCookiesAddSingle( cid, browser, domain, cookie ) @ #i) ⇒
      ((∃ setcookiessec #j.
         ((ReceivePlainCookies( browser, domain, setcookiessec ) @ #j) ∧
          (#j < #i)) ∧
         (∃ rest. setcookiessec = (cookie++rest))) ∨
       (∃ name. cookie = <name, uninit>)))) ∧
   (∀ processid browser domain cookies #i.
     (IncomingPlainLoop( processid, browser, domain, cookies ) @ #i) ⇒
     ((∃ super rest #j.
        (ReceivePlainCookies( browser, domain, super ) @ #j) ∧
        (super = (cookies++rest))) ∨
      (∃ #j. ReceivePlainCookies( browser, domain, cookies ) @ #j)))"
/*
guarded formula characterizing all counter-examples:
"((∃ b d p #i.
    (PDPlainLeak( b, d, p ) @ #i)
   ∧
    (∀ #j. (!KU( p ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #j. (PDAddPlainCookie( d, b, p ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ name. (p = <name, uninit>) ⇒ ⊥)) ∨
  (∃ cid browser domain name content rest #i.
    (PlainCookiesLoop( cid, browser, domain, (rest++<name, content>)
     ) @ #i)
   ∧
    (∀ #j. (!KU( <name, content> ) @ #j) ⇒ ¬(#j < #i)) ∧
    (¬(content = uninit)) ∧
    (∀ #j.
      (PDAddPlainCookie( domain, browser, <name, content> ) @ #j)
     ⇒
      ¬(#j < #i))) ∨
  (∃ cid browser domain cookie #i.
    (PlainCookiesAddSingle( cid, browser, domain, cookie ) @ #i)
   ∧
    (∀ setcookiessec #j.
      (ReceivePlainCookies( browser, domain, setcookiessec ) @ #j)
     ⇒
      ((¬(#j < #i)) ∨ (∀ rest. (setcookiessec = (cookie++rest)) ⇒ ⊥))) ∧
    (∀ name. (cookie = <name, uninit>) ⇒ ⊥)) ∨
  (∃ processid browser domain cookies #i.
    (IncomingPlainLoop( processid, browser, domain, cookies ) @ #i)
   ∧
    (∀ super rest #j.
      (ReceivePlainCookies( browser, domain, super ) @ #j) ∧
      (super = (cookies++rest))
     ⇒
      ⊥) ∧
    (∀ #j.
      (ReceivePlainCookies( browser, domain, cookies ) @ #j) ⇒ ⊥)))"
*/
by sorry

lemma sourceSec [sources]:
  all-traces
  "(((∀ b d p #i.
       (PDSecLeak( b, d, p ) @ #i) ⇒
       (((∃ #j. (!KU( p ) @ #j) ∧ (#j < #i)) ∨
         (∃ #j. PDAddSecCookies( d, b, p ) @ #j)) ∨
        (∃ name. p = <name, uninit>))) ∧
     (∀ cid browser domain name content rest #i.
       (SecCookiesLoop( cid, browser, domain, (rest++<name, content>)
        ) @ #i) ⇒
       (((∃ #j. (!KU( <name, content> ) @ #j) ∧ (#j < #i)) ∨
         (content = uninit)) ∨
        (∃ #j.
          PDAddSecCookies( domain, browser, <name, content> ) @ #j)))) ∧
    (∀ cid browser domain cookie #i.
      (SecCookiesAddSingle( cid, browser, domain, cookie ) @ #i) ⇒
      ((∃ setcookiessec #j.
         ((ReceiveSecCookies( browser, domain, setcookiessec ) @ #j) ∧
          (#j < #i)) ∧
         (∃ rest. setcookiessec = (cookie++rest))) ∨
       (∃ name. cookie = <name, uninit>)))) ∧
   (∀ processid browser domain cookies #i.
     (IncomingSecLoop( processid, browser, domain, cookies ) @ #i) ⇒
     ((∃ super rest #j.
        (ReceiveSecCookies( browser, domain, super ) @ #j) ∧
        (super = (cookies++rest))) ∨
      (∃ #j. ReceiveSecCookies( browser, domain, cookies ) @ #j)))"
/*
guarded formula characterizing all counter-examples:
"((∃ b d p #i.
    (PDSecLeak( b, d, p ) @ #i)
   ∧
    (∀ #j. (!KU( p ) @ #j) ⇒ ¬(#j < #i)) ∧
    (∀ #j. (PDAddSecCookies( d, b, p ) @ #j) ⇒ ⊥) ∧
    (∀ name. (p = <name, uninit>) ⇒ ⊥)) ∨
  (∃ cid browser domain name content rest #i.
    (SecCookiesLoop( cid, browser, domain, (rest++<name, content>)
     ) @ #i)
   ∧
    (∀ #j. (!KU( <name, content> ) @ #j) ⇒ ¬(#j < #i)) ∧
    (¬(content = uninit)) ∧
    (∀ #j.
      (PDAddSecCookies( domain, browser, <name, content> ) @ #j) ⇒ ⊥)) ∨
  (∃ cid browser domain cookie #i.
    (SecCookiesAddSingle( cid, browser, domain, cookie ) @ #i)
   ∧
    (∀ setcookiessec #j.
      (ReceiveSecCookies( browser, domain, setcookiessec ) @ #j)
     ⇒
      ((¬(#j < #i)) ∨ (∀ rest. (setcookiessec = (cookie++rest)) ⇒ ⊥))) ∧
    (∀ name. (cookie = <name, uninit>) ⇒ ⊥)) ∨
  (∃ processid browser domain cookies #i.
    (IncomingSecLoop( processid, browser, domain, cookies ) @ #i)
   ∧
    (∀ super rest #j.
      (ReceiveSecCookies( browser, domain, super ) @ #j) ∧
      (super = (cookies++rest))
     ⇒
      ⊥) ∧
    (∀ #j. (ReceiveSecCookies( browser, domain, cookies ) @ #j) ⇒ ⊥)))"
*/
by sorry

rule (modulo E) CreateBrowser:
   [ Fr( ~bid ) ]
  --[ OnlyOnce( <'ClaimDomain', $Browser> ), CreateBrowser( ~bid )
  ]->
   [
   !Browser( ~bid, $Browser ),
   Browser_State( ~bid, $Browser, 'Ready' )[-]
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateCookies:
   [ Fr( ~cid ), !Browser( ~bid, $Browser ) ]
  --[
  OnlyOnce( <'CreateCookies', ~bid, $Domain> ),
  SecCookiesCreated( ~cid )
  ]->
   [
   CookiesSec( ~cid, $Browser, $Domain, NoCookies )[-],
   CookiesPlain( ~cid, $Browser, $Domain, NoCookies )[-]
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) ClaimDomain:
   [ ]
  --[
  OnlyOnce( <'ClaimDomain', $Domain> ),
  ClaimDomainAF( $Domain, $Server )
  ]->
   [ !ClaimDomain( $Domain, $Server ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) OpenURL:
   [
   Fr( ~msgnonce ), Fr( ~redirnonce ), In( parameters ),
   !Browser( ~bid, $Browser )
   ]
  --[
  OpenUrl( ),
  Fresh_Redirnonce( $Browser, ~redirnonce, NoBody, $Domain, $Scheme,
                    ~msgnonce
  )
  ]->
   [
   !TLW( $Tlw, $Browser ),
   Browser_Send_HTTP( $Browser, $Tlw, 'REQ', $Scheme, $Domain, $Path,
                      parameters, $fragment, 'GET', NoAuth, NoOrigin, NoReferrer,
                      NoRefPolicy, NoBody, 'honest', ~redirnonce, ~msgnonce
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) RefPolChange:
   [
   Browser_Send_HTTP( $Browser, wid_or_did, $type, $scheme, $Domain,
                      $Path, parameters, fragment, $method, auth, origin, referrer,
                      referrerpolicy, body, adv, ~redirnonce, ~msgnonce
   )
   ]
  -->
   [
   Browser_Send_HTTP_Post_Ref( $Browser, wid_or_did, $type, $scheme,
                               $Domain, $Path, parameters, fragment, $method, auth, origin,
                               referrer, body, adv, ~redirnonce, ~msgnonce
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) BrowserSendPlain:
   [
   Browser_Send_HTTP_Post_Ref( $Browser, wid_or_did, type, 'http',
                               $Domain, $Path, parameters, fragment, $method, auth, origin,
                               referrer, body, adv, ~redirnonce, ~msgnonce
   )[no_precomp],
   Browser_State( ~bid, $Browser, 'Ready' )[no_precomp],
   CookiesPlain( ~cid, $Browser, $Domain, plaincookies )[no_precomp]
   ]
  --[
  NotSTS( ~bid, $Domain ), SendTo( $Domain ),
  PlainCookiesLoop( ~cid, $Browser, $Domain, plaincookies )
  ]->
   [
   Browser_Out( $Browser, wid_or_did, $Domain, 'http', type, fragment,
                ~msgnonce, $method, $Path, parameters, plaincookies, NoCookies,
                origin, referrer, auth, body, adv, ~redirnonce
   ),
   CookiesPlain( ~cid, $Browser, $Domain, plaincookies )[-],
   Browser_State( ~bid, $Browser, 'Ready' )[-]
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) BrowserSendSec:
   [
   Browser_Send_HTTP_Post_Ref( $Browser, wid_or_did, type, 'https',
                               $Domain, $Path, parameters, fragment, $method, auth, origin,
                               referrer, body, adv, ~redirnonce, ~msgnonce
   )[no_precomp],
   Browser_State( ~bid, $Browser, 'Ready' )[-],
   CookiesPlain( ~cid, $Browser, $Domain, plainCookies )[no_precomp],
   CookiesSec( ~cid, $Browser, $Domain, secCookies )[no_precomp]
   ]
  --[
  SendTo( $Domain ),
  SecCookiesLoop( ~cid, $Browser, $Domain, secCookies ), Sent( ),
  SendSec( $Browser, $Domain, ~redirnonce ),
  PlainCookiesLoop( ~cid, $Browser, $Domain, plainCookies )
  ]->
   [
   Browser_Out( $Browser, wid_or_did, $Domain, 'https', type,
                fragment, ~msgnonce, $method, $Path, parameters, plainCookies,
                secCookies, origin, referrer, auth, body, adv, ~redirnonce
   ),
   CookiesPlain( ~cid, $Browser, $Domain, plainCookies )[-],
   CookiesSec( ~cid, $Browser, $Domain, secCookies )[-],
   Browser_State( ~bid, $Browser, 'Ready' )[-]
   ]

  // loop breaker: [1]
  /* has exactly the trivial AC variant */

restriction AdhereToSTS:
  "∀ bid domain #i.
    (NotSTS( bid, domain ) @ #i) ⇒
    (¬(∃ #j. STS( bid, domain, 'top' ) @ #j))"
  // safety formula

rule (modulo E) ProcessResponse:
   [
   Browser_State( ~bid, $Browser, 'Ready' )[-],
   Browser_In( $Domain, $Browser, $Scheme, ~nonce, $status,
               setcookiesplain, setcookiessec, location, STS, refpolicy, body
   ),
   Fr( ~plainprocessingnonce ), Fr( ~secprocessingnonce ),
   Fr( ~docprocessingnonce )
   ]
  --[
  STS( ~bid, $Domain, STS ),
  ReceiveSecCookies( $Browser, $Domain, setcookiessec ),
  ReceivePlainCookies( $Browser, $Domain, setcookiesplain )
  ]->
   [
   Browser_State( ~bid, $Browser,
                  <'HandlingResponse', ~plainprocessingnonce, ~secprocessingnonce, 
                   ~docprocessingnonce>
   ),
   ProcessingDocument( ~docprocessingnonce, $Browser, $Scheme, ~nonce,
                       $status, body, location, STS, refpolicy, body
   ),
   IncomingPlain( ~plainprocessingnonce, $Browser, setcookiesplain,
                  $Domain
   ),
   IncomingSec( ~secprocessingnonce, $Browser, setcookiessec, $Domain
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) AddUninitialisedCookiePlain:
   [ CookiesPlain( ~cid, $Browser, $Domain, oldcookies ) ]
  --[
  OnlyOnce( <'InitPlainCookie', $name> ),
  PlainCookiesAddSingle( ~cid, $Browser, $Domain, <$name, uninit> ),
  Uninit( oldcookies )
  ]->
   [
   CookiesPlain( ~cid, $Browser, $Domain,
                 (oldcookies++<$name, uninit>)
   )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) AddUninitialisedCookieSec:
   [ CookiesSec( ~cid, $Browser, $Domain, oldcookies ) ]
  --[
  OnlyOnce( <'InitSecCookie', $name> ),
  SecCookiesMod( ~cid, (oldcookies++<$name, uninit>) ),
  SecCookiesAddSingle( ~cid, $Browser, $Domain, <$name, uninit> ),
  Uninit( oldcookies )
  ]->
   [
   CookiesSec( ~cid, $Browser, $Domain, (oldcookies++<$name, uninit>)
   )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

restriction Restr_ProcessCookiesPlainLoopReplace_1:
  "∀ x #NOW.
    (Restr_ProcessCookiesPlainLoopReplace_1( x ) @ #NOW) ⇒
    (¬(x = '__HOST'))"
  // safety formula

rule (modulo E) ProcessCookiesPlainLoopReplace:
   [
   IncomingPlain( ~processid, $Browser, (rest++<$name, content>),
                  $Domain
   ),
   CookiesPlain( ~cid, $Browser, $Domain,
                 (oldcookies++<$name, oldcontent>)
   )[-]
   ]
  --[
  IncomingPlainLoop( ~processid, $Browser, $Domain,
                     (rest++<$name, content>)
  ),
  PlainCookiesLoop( ~cid, $Browser, $Domain,
                    (oldcookies++<$name, oldcontent>)
  ),
  PlainCookiesAddSingle( ~cid, $Browser, $Domain, <$name, content> ),
  Restr_ProcessCookiesPlainLoopReplace_1( $name )
  ]->
   [
   CookiesPlain( ~cid, $Browser, $Domain,
                 (oldcookies++<$name, content>)
   )[-],
   IncomingPlain( ~processid, $Browser, rest, $Domain )
   ]

  // loop breakers: [1,0]
  /* has exactly the trivial AC variant */

rule (modulo E) ProcessCookiesPlainEnd:
   [ IncomingPlain( ~processid, $Browser, NoCookies, $Domain ) ]
  -->
   [ PlainProcessed( ~processid, $Browser ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) ProcessCookiesSecLoopReplace:
   [
   IncomingSec( ~processid, $Browser, (rest++<$name, content>),
                $Domain
   ),
   CookiesSec( ~cid, $Browser, $Domain,
               (oldcookies++<$name, oldcontent>)
   )[-]
   ]
  --[
  SecCookiesMod( ~cid, (oldcookies++<$name, content>) ),
  SecCookieAdd( $Browser, $Domain, (rest++<$name, content>),
                ~processid
  ),
  SecCookiesAddSingle( ~cid, $Browser, $Domain, <$name, content> ),
  SecCookiesLoop( ~cid, $Browser, $Domain,
                  (oldcookies++<$name, oldcontent>)
  ),
  AddSecLoop( ~processid ),
  IncomingSecLoop( ~processid, $Browser, $Domain,
                   (rest++<$name, content>)
  )
  ]->
   [
