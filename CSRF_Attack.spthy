rule (modulo E) HTTPModifyRequest:
   [
   In( <newparameters, 
        <NewOrigin, newPlain, newSec, NewReferer, NewAuth>, newbody>
   ),
   !Request( $Browser, $Domain, 'http', ~nonce, $method, $path,
             parameters, plaincookies, seccookies, origin, referrer, auth, body,
             'honest'
   )
   ]
  --[ AdvActive( ) ]->
   [
   Server_In( $Browser, $Domain, 'http', ~nonce, $newmethod, $newpath,
              newparameters, newPlain, newSec, NewOrigin, NewReferer, NewAuth,
              newbody, 'adversary'
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) HTTPModifyResponse:
   [
   In( <
        <newplaincookies, newseccookies, NewLocation, NewSTS, NewRefPolicy
        >, 
