lemma linearize [reuse, hide_lemma=aux_first]:
  all-traces
  "∀ browser redirnonce dom otherbody otherdom inmsgnonce outmsgnonce
     secondoutmsgnonce body status otherstatus #j #k thirddom thirdin
     thirdout thirdstatus thirdbod #l.
    (((((Continue_Redir( browser, dom, inmsgnonce, redirnonce, status,
                         outmsgnonce, body
         ) @ #j) ∧
        (Continue_Redir( browser, otherdom, outmsgnonce, redirnonce,
                         otherstatus, secondoutmsgnonce, otherbody
         ) @ #k)) ∧
       (Continue_Redir( browser, thirddom, thirdin, redirnonce,
                        thirdstatus, thirdout, thirdbod
        ) @ #l)) ∧
      (¬(#l = #j))) ∧
     (¬(#l = #k))) ⇒
    (((#l < #j) ∧ (#l < #k)) ∨ ((#j < #l) ∧ (#k < #l)))"
/*
guarded formula characterizing all counter-examples:
"∃ browser redirnonce dom otherbody otherdom inmsgnonce outmsgnonce
   secondoutmsgnonce body status otherstatus #j #k thirddom thirdin
   thirdout thirdstatus thirdbod #l.
  (Continue_Redir( browser, dom, inmsgnonce, redirnonce, status,
                   outmsgnonce, body
   ) @ #j) ∧
  (Continue_Redir( browser, otherdom, outmsgnonce, redirnonce,
                   otherstatus, secondoutmsgnonce, otherbody
   ) @ #k) ∧
  (Continue_Redir( browser, thirddom, thirdin, redirnonce,
                   thirdstatus, thirdout, thirdbod
   ) @ #l)
 ∧
  (¬(#l = #j)) ∧
  (¬(#l = #k)) ∧
  (((¬(#l < #j)) ∨ (¬(#l < #k)))) ∧
  (((¬(#j < #l)) ∨ (¬(#k < #l))))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (#l < #j)  ∥ (#j < #l) )
    case case_1
    by contradiction /* from formulas */
  next
    case case_2
    solve( (#l < #k)  ∥ (#k < #l) )
      case case_1
      solve( (∀ browser redirnonce dom otherbody otherdom inmsgnonce
                outmsgnonce secondoutmsgnonce body status otherstatus #j #k
                thirddom thirdin thirdout thirdstatus thirdbod #l.
               (Continue_Redir( browser, dom, inmsgnonce, redirnonce, status,
                                outmsgnonce, body
                ) @ #j) ∧
               (Continue_Redir( browser, otherdom, outmsgnonce, redirnonce,
                                otherstatus, secondoutmsgnonce, otherbody
                ) @ #k) ∧
               (Continue_Redir( browser, thirddom, thirdin, redirnonce,
                                thirdstatus, thirdout, thirdbod
                ) @ #l)
              ⇒
               ((last(#l)) ∨
                (last(#k)) ∨
                (last(#j)) ∨
                (#l = #j) ∨
                (#l = #k) ∨
                ((#l < #j) ∧ (#l < #k)) ∨
                ((#j < #l) ∧ (#k < #l))))  ∥
             (∃ cookie #i.
               (Uninit( cookie ) @ #i)
              ∧
               (¬(last(#i))) ∧
               (¬(cookie = NoCookies)) ∧
               (∀ a b.
                 (cookie = (a++b))
                ⇒
                 ∃ rest singleton.
                  (cookie = (rest++singleton))
                 ∧
                  ∀ name. (singleton = <name, uninit>) ⇒ ⊥)) )
        case case_1
        solve( (~msgnonce = ~nonce.1)  ∥
               (∃ thirddom thirdout thirdstat thirdbod #k.
                 (Continue_Redir( $Browser, thirddom, ~msgnonce, ~redirnonce,
                                  thirdstat, thirdout, thirdbod
                  ) @ #k)
                ∧
                 #k < #l) )
          case case_1
          by contradiction /* cyclic */
        next
          case case_2
          by contradiction /* cyclic */
        qed
      next
        case case_2
        solve( (~msgnonce = ~nonce.1)  ∥
               (∃ thirddom thirdout thirdstat thirdbod #k.
                 (Continue_Redir( $Browser, thirddom, ~msgnonce, ~redirnonce,
                                  thirdstat, thirdout, thirdbod
                  ) @ #k)
                ∧
                 #k < #l) )
          case case_1
          by contradiction /* cyclic */
        next
          case case_2
          by contradiction /* cyclic */
        qed
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  qed
qed

lemma 303_clears_body_redirs [reuse,
                              hide_lemma=first_continue_redir, hide_lemma=redir_loops]:
  all-traces
  "∀ browser redirnonce dom otherbody otherdom msgnonce
     secondmsgnonce thirdmessagenonce fourthmessagenonce body
     otherstatus #j #k.
    (((Continue_Redir( browser, dom, msgnonce, redirnonce, '303',
                       secondmsgnonce, body
       ) @ #j) ∧
      (Continue_Redir( browser, otherdom, thirdmessagenonce, redirnonce,
                       otherstatus, fourthmessagenonce, otherbody
       ) @ #k)) ∧
     (#j < #k)) ⇒
    ((otherbody = NoBody) ∨ (∃ #i. CompromiseBrowser( browser ) @ #i))"
/*
guarded formula characterizing all counter-examples:
"∃ browser redirnonce dom otherbody otherdom msgnonce
   secondmsgnonce thirdmessagenonce fourthmessagenonce body
   otherstatus #j #k.
  (Continue_Redir( browser, dom, msgnonce, redirnonce, '303',
                   secondmsgnonce, body
   ) @ #j) ∧
  (Continue_Redir( browser, otherdom, thirdmessagenonce, redirnonce,
                   otherstatus, fourthmessagenonce, otherbody
   ) @ #k)
 ∧
  (#j < #k) ∧
  (¬(otherbody = NoBody)) ∧
  (∀ #i. (CompromiseBrowser( browser ) @ #i) ⇒ ⊥)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ browser redirnonce dom otherbody otherdom msgnonce
            secondmsgnonce thirdmessagenonce fourthmessagenonce body
            otherstatus #j #k.
           (Continue_Redir( browser, dom, msgnonce, redirnonce, '303',
                            secondmsgnonce, body
            ) @ #j) ∧
           (Continue_Redir( browser, otherdom, thirdmessagenonce, redirnonce,
                            otherstatus, fourthmessagenonce, otherbody
            ) @ #k)
          ⇒
           ((last(#k)) ∨
            (last(#j)) ∨
            (#j = #k) ∨
            (#k < #j) ∨
            (otherbody = NoBody) ∨
            (∃ #i. (CompromiseBrowser( browser ) @ #i) ∧ ¬(last(#i)))))  ∥
         (∃ cookie #i.
           (Uninit( cookie ) @ #i)
          ∧
           (¬(last(#i))) ∧
           (¬(cookie = NoCookies)) ∧
           (∀ a b.
             (cookie = (a++b))
            ⇒
             ∃ rest singleton.
              (cookie = (rest++singleton))
             ∧
              ∀ name. (singleton = <name, uninit>) ⇒ ⊥)) )
    case case_1
    solve( (last(#k))  ∥ (otherbody = NoBody)  ∥
           (∃ #i. (CompromiseBrowser( $Browser ) @ #i) ∧ ¬(last(#i))) )
      case case_1
      solve( ProcessRedirectFinish( ~processid.1, $Browser, ~nonce.1,
                                    $status, finalorigin.1, $method.1, otherbody, refpolicy.1,
                                    $respScheme.1, $respDomain.1, resppath.1, respparams.1,
                                    finalfragment.1, referrer.1, ~redirnonce
