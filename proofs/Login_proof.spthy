lemma AgreementServerSide:
  all-traces
  "∀ server browser #i.
    (((Commit( server, browser ) @ #i) ∧
      (¬(∃ #r. CompromiseBrowser( browser ) @ #r))) ∧
     (¬(∃ #r. CompromiseDomain( server ) @ #r))) ⇒
    (∃ #j. (Running( browser, server ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ server browser #i.
  (Commit( server, browser ) @ #i)
 ∧
  (∀ #r. (CompromiseBrowser( browser ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (CompromiseDomain( server ) @ #r) ⇒ ⊥) ∧
  (∀ #j. (Running( browser, server ) @ #j) ⇒ ¬(#j < #i))"
*/
simplify
