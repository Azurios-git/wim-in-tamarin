               (ReceivePlainCookies( $Browser, $Domain, (rest++<$name, content>)
                ) @ #j)
              ∧
               ¬(last(#j))) )
        case case_1
        solve( IncomingPlain( ~processid, $Browser,
                              (rest++<$name, content>), $Domain
               ) ▶₀ #i )
          case ProcessCookiesPlainLoopReplace
          solve( (∃ super rest.1 #j.
                   (ReceivePlainCookies( $Browser, $Domain, super ) @ #j) ∧
                   (super = (rest++rest.1++<$name, content>++<$name.1, content.1>))
                  ∧
                   ¬(last(#j)))  ∥
                 (∃ #j.
                   (ReceivePlainCookies( $Browser, $Domain,
                                         (rest++<$name, content>++<$name.1, content.1>)
                    ) @ #j)
                  ∧
                   ¬(last(#j))) )
            case case_1
            by contradiction /* from formulas */
          next
            case case_2
            by contradiction /* from formulas */
          qed
