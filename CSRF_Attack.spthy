restriction Restr_AdversaryRunScriptPostMsg_1:
  "∀ x #NOW.
    (Restr_AdversaryRunScriptPostMsg_1( x ) @ #NOW) ⇒
    (¬(x = 'Adversaryscript'))"
  // safety formula

rule (modulo E) AdversaryRunScriptPostMsg:
   [
   !AdvScript( $Browser, ~did,
               <$DocScheme, $DocDomain, $docpath, params, docfragment>, refpolicy
   ),
   Document( ~otherdid, $Browser, $OtherTLW,
             <$OtherScheme, $OtherDomain, $otherdocpath, otherparams, 
              otherdocfragment>,
             otherReferer, $otherRefpolicy, $otherscript, otherscriptstate
   ),
   In( message )
   ]
  --[
  AdvActive( ),
  DocLoop( ~otherdid,
           <$OtherScheme, $OtherDomain, $otherdocpath, otherparams, 
            otherdocfragment>,
           $otherscript
  ),
  Restr_AdversaryRunScriptPostMsg_1( $otherscript )
  ]->
   [
   ScriptinputPOST( ~otherdid, ~did, <$DocDomain, $DocScheme>, message
   ),
   Document( ~otherdid, $Browser, $OtherTLW,
             <$OtherScheme, $OtherDomain, $otherdocpath, otherparams, 
              otherdocfragment>,
             otherReferer, $otherRefpolicy, $otherscript, otherscriptstate
   )
   ]

  // loop breaker: [1]
  /* has exactly the trivial AC variant */

