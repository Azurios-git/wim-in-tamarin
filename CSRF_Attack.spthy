  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ data #i.
           (PDLeakLocalStorage( data ) @ #i)
          ⇒
           ((last(#i)) ∨
            (data = 'bot') ∨
            (∃ #j. (!KU( data ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) ∨
