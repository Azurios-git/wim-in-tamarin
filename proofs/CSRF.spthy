  by contradiction /* from formulas */
next
  case BrowserSendSec_case_20
  by contradiction /* from formulas */
next
  case CompromisedBrowserSend
  by contradiction /* from formulas */
qed

lemma NoRefFragmentSent:
  all-traces
  "∀ referer #i.
    (SendReferer( referer ) @ #i) ⇒
    (((referer = NoReferrer) ∨
      (∃ scheme dom path params.
        referer = <scheme, dom, path, params, 'bot'>)) ∨
     (∃ #j. (!KU( referer ) @ #j) ∧ (#j < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ referer #i.
  (SendReferer( referer ) @ #i)
 ∧
  (¬(referer = NoReferrer)) ∧
  (∀ scheme dom path params.
    (referer = <scheme, dom, path, params, 'bot'>) ⇒ ⊥) ∧
  (∀ #j. (!KU( referer ) @ #j) ⇒ ¬(#j < #i))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (∀ referer #i.
           (SendReferer( referer ) @ #i)
          ⇒
           ((last(#i)) ∨
            (referer = NoReferrer) ∨
            (∃ scheme dom path params.
              (referer = <scheme, dom, path, params, 'bot'>)) ∨
            (∃ #j. (!KU( referer ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i))))  ∥
         (∃ cookie #i.
           (Uninit( cookie ) @ #i)
          ∧
           (¬(last(#i))) ∧
           (¬(cookie = NoCookies)) ∧
           (∀ a b.
             (cookie = (a++b))
            ⇒
             ∃ rest singleton.
              (cookie = (rest++singleton))
             ∧
              ∀ name. (singleton = <name, uninit>) ⇒ ⊥)) )
    case case_1
    solve( (last(#i))  ∥ (referer = NoReferrer)  ∥
           (∃ scheme dom path params.
             (referer = <scheme, dom, path, params, 'bot'>))  ∥
           (∃ #j. (!KU( referer ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( Browser_Out( $Browser, window_or_doc_reference, $Domain,
                          $Scheme, $type, fragment, ~nonce, $method, $path, parameters,
                          plaincookies, seccookies, origin, referer, auth, body, adv,
                          ~redirnonce
             )[no_precomp] ▶₀ #i )
        case BrowserSendPlain_case_01
        by contradiction /* from formulas */
      next
        case BrowserSendPlain_case_02
        solve( (referer = NoReferrer)  ∥
               (∃ scheme dom path params.
                 (referer = <scheme, dom, path, params, 'bot'>))  ∥
               (∃ #j. (!KU( referer ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.7)) )
          case case_1
          by contradiction /* from formulas */
        next
          case case_2
          by contradiction /* from formulas */
        next
          case case_3
          by contradiction /* from formulas */
        qed
      next
        case BrowserSendPlain_case_03
        solve( (referer = NoReferrer)  ∥
