rule (modulo E) ServerReceiveReplyUser:
   [
   Browser_In( $Domain, $Browser, $Scheme, ~nonce, status,
               setcookiesplain, setcookiessec, location, sts, refpolicy, body
   )
   ]
  -->
   [
   Receive_Reply( $Domain, $Browser, $Scheme, ~nonce, status,
                  setcookiesplain, setcookiessec, location, sts, refpolicy, body
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) HTTPModifyRequest:
   [
   In( <newparameters, 
        <NewOrigin, newPlain, newSec, NewReferer, NewAuth>, newbody>
   ),
   !Request( $Browser, $Domain, 'http', ~nonce, $method, $path,
             parameters, plaincookies, seccookies, origin, referrer, auth, body,
             'honest'
   )
   ]
  --[ AdvActive( ) ]->
   [
   Server_In( $Browser, $Domain, 'http', ~nonce, $newmethod, $newpath,
              newparameters, newPlain, newSec, NewOrigin, NewReferer, NewAuth,
              newbody, 'adversary'
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) HTTPModifyResponse:
   [
   In( <
        <newplaincookies, newseccookies, NewLocation, NewSTS, NewRefPolicy
        >, 
        newbody>
   ),
   !Response( $Domain, $Browser, 'http', ~nonce, $status,
              setcookiesplain, setcookiessec, location, sts, refpolicy, body,
              'honest'
   )
   ]
  --[
  AdvActive( ), AdvRedirectingFrom( $Browser, $Domain, $newstatus ),
  AdvRedirectingTo( $Browser, NewLocation, $newstatus ),
  LinkAfterMiddle( ~nonce, body )
  ]->
   [
   Browser_In( $Domain, $Browser, 'http', ~nonce, $newstatus,
               newplaincookies, newseccookies, NewLocation, NewSTS, NewRefPolicy,
               newbody
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) HTTPGenerateResponse:
   [
   In( <<respplaincookies, respseccookies, resplocation>, respbody> ),
   Server_In( $Browser, $Domain, 'http', ~nonce, $method, $parth,
              parameters, plaincookies, seccookies, origin, referer, auth,
              newbody, 'honest'
   )
   ]
  --[
  AdvActive( ), AdvRedirectingFrom( $Browser, $Domain, $Status ),
  AdvRedirectingTo( $Browser, resplocation, $Status )
  ]->
   [
   Server_Out( $Domain, $Browser, $NewScheme, ~nonce, $Status,
               respplaincookies, respseccookies, resplocation, $newSTS,
               $newRefPolicy, respbody, 'adversary'
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompromiseDomain:
   [ ]
  --[
  CompromiseDomain( $Domain ),
  OnlyOnce( <'CompromiseDomain', $Domain> ), AdvActive( )
  ]->
   [ !CompromisedDomain( $Domain ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompromiseBrowser:
   [ !Browser( ~bid, $Browser ) ]
  --[
  CompromiseBrowser( $Browser ),
  OnlyOnce( <'CompromiseBrowser', $Browser> ), AdvActive( )
  ]->
   [ !CompromisedBrowser( $Browser ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompromisedBrowserState:
   [ !CompromisedBrowser( $Browser ) ]
  --[
  OnlyOnce( <'LeakBrowserState', $Browser, $Domain, $Scheme, $TLW> ),
  AdvActive( )
  ]->
   [
   !LeakState( $Browser, $Domain, $Scheme, $TLW ),
   !ModifyState( $Browser, $Domain, $Scheme, $TLW )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompromisedServerSend:
   [
   In( <respplaincookies, respseccookies, respbody, resplocation> ),
   !CompromisedDomain( $Domain ),
   Server_In( $Browser, $Domain, $Scheme, ~nonce, $method, $path,
              parameters, plaincookies, seccookies, origin, referrer, auth, body,
              adv
   )
   ]
  --[
  AdvActive( ), AdvRedirectingFrom( $Browser, $Domain, $Status ),
  AdvRedirectingTo( $Browser, resplocation, $Status )
  ]->
   [
   Server_Out( $Domain, $Browser, $NewScheme, ~nonce, $Status,
               respplaincookies, respseccookies, resplocation, $newSTS,
               $newRefPolicy, respbody, 'adversary'
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompromisedBrowserSend:
   [
   !CompromisedBrowser( $Browser ),
   In( <window_or_doc_reference, fragment, parameters, plaincookies, 
        seccookies, <Origin, Referer, Auth>, body>
   ),
   Fr( ~msgnonce ), Fr( ~redirnonce )
   ]
  --[
  AdvActive( ),
  Fresh_Redirnonce( $Browser, ~redirnonce, body, $Domain, $Scheme,
                    ~msgnonce
  )
  ]->
   [
   Browser_Out( $Browser, window_or_doc_reference, $Domain, $Scheme,
                $type, fragment, ~msgnonce, $method, $path, parameters,
                plaincookies, seccookies, Origin, Referer, Auth, body, 'adversary',
                ~redirnonce
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) AdversaryScript:
   [
   Document( ~did, $Browser, $TLW,
             <$Scheme, $DocDomain, $path, params, fragment>, referer, refpolicy,
             'Adversaryscript', scriptstate
   )
   ]
  --[ AdvActive( ) ]->
   [
   !LeakState( $Browser, $DocDomain, $Scheme, $TLW ),
   !ModifyState( $Browser, $DocDomain, $Scheme, $TLW ),
   !AdvScript( $Browser, ~did,
               <$Scheme, $DocDomain, $path, params, fragment>, refpolicy
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) AdversaryRunScriptFormPost:
   [
   !AdvScript( $Browser, ~did,
               <$DocScheme, $DocDomain, $docpath, params, docfragment>, refpolicy
   ),
   In( <data, parameters, fragment> ), Fr( ~redirnonce ),
   Fr( ~msgnonce )
   ]
  --[
  AdvActive( ),
  Fresh_Redirnonce( $Browser, ~redirnonce, data, $Domain, $Scheme,
                    ~msgnonce
  )
  ]->
   [
   Browser_Send_HTTP( $Browser, $TLW, 'REQ', $Scheme, $Domain, $Path,
                      parameters, fragment, 'POST', NoAuth, <$DocDomain, $DocScheme>,
                      <$DocScheme, $DocDomain, $docpath, params, 'bot'>, refpolicy, data,
                      'honest', ~redirnonce, ~msgnonce
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) LeakPlainCookies:
   [
   !LeakState( $Browser, $Domain, $Scheme, $TLW ),
   CookiesPlain( ~cid, $Browser, $Domain, (rest++<$name, content>)
   )[-]
   ]
  --[
  PDPlainLeak( $Browser, $Domain, <$name, content> ),
  PlainCookiesLoop( ~cid, $Browser, $Domain, (rest++<$name, content>)
  ),
  NoLeakingUninit( content )
  ]->
   [
   CookiesPlain( ~cid, $Browser, $Domain, (rest++<$name, content>)
   )[-],
   Out( content )
   ]

  // loop breaker: [1]
  /* has exactly the trivial AC variant */

rule (modulo E) LeakSecCookies:
   [
   !LeakState( $Browser, $Domain, 'https', $TLW ),
   CookiesSec( ~cid, $Browser, $Domain, (rest++<$name, content>) )[-]
   ]
  --[
  PDSecLeak( $Browser, $Domain, <$name, content> ),
  SecCookiesLoop( ~cid, $Browser, $Domain, (rest++<$name, content>) )
  ]->
   [
   CookiesSec( ~cid, $Browser, $Domain, (rest++<$name, content>) )[-],
   Out( content )
   ]

  // loop breaker: [1]
  /* has exactly the trivial AC variant */

rule (modulo E) LeakSecrets:
   [
   !LeakState( $Browser, $Domain, $Scheme, $TLW ),
   !Secrets( $Browser, $Domain, $Scheme, data )
   ]
  -->
   [ Out( data ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) LeakServerSecrets:
   [ !CompromisedDomain( $Domain ), !ServerSecret( $Domain, secret ) ]
  -->
   [ Out( secret ) ]

  /* has exactly the trivial AC variant */

restriction OnlyOnce:
  "∀ x #i #j.
    ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction Equality:
  "∀ a b #i. (Eq( a, b ) @ #i) ⇒ (a = b)"
  // safety formula

restriction Init:
  "∀ cookie #i.
    (Uninit( cookie ) @ #i) ⇒
    ((cookie = NoCookies) ∨
     (∃ a b.
       (cookie = (a++b)) ∧
       (∀ rest singleton.
         (cookie = (rest++singleton)) ⇒
         (∃ name. singleton = <name, uninit>))))"

lemma aux_unique_requests [reuse]:
  all-traces
  "∀ nonce #i #j.
    ((Send_Request_Nonce( nonce ) @ #i) ∧
     (Send_Request_Nonce( nonce ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ nonce #i #j.
  (Send_Request_Nonce( nonce ) @ #i) ∧
  (Send_Request_Nonce( nonce ) @ #j)
 ∧
  ¬(#i = #j)"
*/
by sorry

rule (modulo E) preShareLoginDetails:
   [
   !ClaimDomain( $Domain, 'loginSite' ), !Browser( ~bid, $Browser ),
   Fr( ~login )
   ]
  --[
  Credentials( $Browser, $Domain, ~login ), CarefulUser( $Scheme ),
  OnlyOnce( <'PreShareLogin', $Browser, $Domain> )
  ]->
   [
   !LoginDetails( $Domain, $Browser, ~login ),
   !Secrets( $Browser, $Domain, $Scheme, ~login ),
   !ServerSecret( $Domain, ~login )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) SiteLoginPage:
   [
   !ClaimDomain( $Domain, 'loginSite' ),
   Receive_Request( $Browser, $Domain, 'https', ~nonce, 'GET',
                    '/login', parameters, cookies, origin, NewReferer, NewAuth, newbody
   )
   ]
  -->
   [
   Send_Reply( $Domain, $Browser, 'https', ~nonce, '200', NoCookies,
               NoCookies, NoLocation, NoSTS, NoRefPolicy, <'LoginToSite', $Domain>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) SiteLoginForm:
   [
   !LoginDetails( $Domain, $LoginBrowser, ~login ),
   Receive_Request( $Browser, $Domain, 'https', ~nonce, 'POST',
                    '/loginform', parameters, cookies, origin, NewReferer, NewAuth,
                    <'Credentials', ~login>
   ),
   Fr( ~token )
   ]
  --[
  PDAddSecCookies( $Domain, $Browser, <'SessionToken', ~token> ),
  PDAddedListSec( <<'SessionToken', ~token>, NoCookies> ),
  Login( ~token ), SecretSession( ~token, $Browser, $Domain ),
  Commit( $Domain, $LoginBrowser )
  ]->
   [
   Send_Reply( $Domain, $Browser, 'https', ~nonce, '200', NoCookies,
               (NoCookies++<'SessionToken', ~token>), NoLocation, NoSTS,
               NoRefPolicy, <'SuccessfulLogin', 'bot'>
   ),
   !ServerSecret( $Domain, <$LoginBrowser, ~token> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) LoginScript:
   [
   Document( ~did, $Browser, $TLW,
             <$Scheme, $DocDomain, path, params, fragment>, referer, refpolicy,
             'LoginToSite', $ScriptDomain
   ),
   !Secrets( $Browser, $DocDomain, $Scheme, ~login )
   ]
  --[
  PDAddBody( <'Credentials', ~login> ), LoginS( ),
  Running( $Browser, $DocDomain )
  ]->
   [
   Send_Request_Browser( $Browser, $TLW, 'REQ', $Scheme, $DocDomain,
                         '/loginform', NoParams, 'bot', 'POST', NoAuth,
                         <$DocDomain, $Scheme>, NoReferrer, NoRefPolicy,
                         <'Credentials', ~login>
   ),
   Document( ~did, $Browser, $TLW,
             <$Scheme, $DocDomain, path, params, fragment>, referer, refpolicy,
             'LoginToSite', <$ScriptDomain, 'Scriptover'>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) FinishLoginUser:
   [
   Document( ~did, $Browser, $TLW, docURL, referer, refpolicy,
             'SuccessfulLogin', 'bot'
   )
   ]
  --[ Finish( ) ]->
   [
   Document( ~did, $Browser, $TLW, docURL, referer, refpolicy,
             'SuccessfulLogin', 'done'
   )
   ]

  /* has exactly the trivial AC variant */

restriction CarefulUser:
  "∀ scheme #i. (CarefulUser( scheme ) @ #i) ⇒ (scheme = 'https')"
  // safety formula

lemma LoginPossible:
  exists-trace
  "∃ #i token.
    (((Login( token ) @ #i) ∧ (¬(∃ #i.1. AdvActive( ) @ #i.1))) ∧
     (∀ #i.1 #j bid otherbid.
       ((CreateBrowser( bid ) @ #i.1) ∧
        (CreateBrowser( otherbid ) @ #j)) ⇒
       (#i.1 = #j))) ∧
    (∀ #i.1 domain.
      (SendTo( domain ) @ #i.1) ⇒
      (∃ #i.2. ClaimDomainAF( domain, 'loginSite' ) @ #i.2))"
/*
guarded formula characterizing all satisfying traces:
"∃ #i token.
  (Login( token ) @ #i)
 ∧
  (∀ #i.1. (AdvActive( ) @ #i.1) ⇒ ⊥) ∧
  (∀ #i.1 #j bid otherbid.
    (CreateBrowser( bid ) @ #i.1) ∧ (CreateBrowser( otherbid ) @ #j)
   ⇒
    #i.1 = #j) ∧
  (∀ #i.1 domain.
    (SendTo( domain ) @ #i.1)
   ⇒
    ∃ #i.2. (ClaimDomainAF( domain, 'loginSite' ) @ #i.2))"
*/
simplify
solve( !LoginDetails( $Domain, $LoginBrowser, ~login ) ▶₀ #i )
  case preShareLoginDetails
  solve( Receive_Request( $Browser, $Domain, 'https', ~nonce, 'POST',
                          '/loginform', parameters, cookies, origin, NewReferer, NewAuth,
                          <'Credentials', ~login>
         ) ▶₁ #i )
    case ServerInUser
    solve( Browser_Out( $Browser, window_or_doc_reference, $Domain,
                        'https', $type, fragment, ~nonce, 'POST', '/loginform', parameters,
                        plaincookies, seccookies, origin, NewReferer, NewAuth,
                        <'Credentials', ~login>, adv, ~redirnonce
           )[no_precomp] ▶₀ #vr.5 )
      case BrowserSendSec_case_1
      solve( Browser_Out( $Browser, $TLW, $Domain, 'https', 'REQ',
                          fragment, ~nonce.1, $method, $path, params, plaincookies.1,
                          seccookies.1, origin, referer, auth, reqbody, adv, ~redirnonce.1
             )[no_precomp] ▶₀ #vr.11 )
        case BrowserSendSec_case_1
        solve( ProcessingDocument( ~processid, $Browser, 'https', ~nonce.1,
                                   $status, <'LoginToSite', $ScriptDomain>, location, STS,
                                   refpolicy, <'LoginToSite', $ScriptDomain>
               ) ▶₀ #vr.10 )
          case ProcessResponse_case_01
          by sorry
        next
          case ProcessResponse_case_02
          by contradiction /* from formulas */
        next
